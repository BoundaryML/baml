    {"title": "HTTP Response Times", "source_panel_id": 13, "unit": "s", "queries": ["sum(increase(fly_app_http_response_time_seconds_sum{app=\"APP\",instance=\"VM\"}))/sum(increase(fly_app_http_response_time_seconds_count{app=\"APP\",instance=\"VM\"}))", "histogram_quantiles(\"p\", 0.5, 0.9, 0.99, sum(increase(fly_app_http_response_time_seconds_bucket{app=\"APP\",instance=\"VM\"}))by(le))"]},
    {"title": "Firecracker Load Average", "source_panel_id": 9, "unit": "percentunit", "queries": ["sum(fly_instance_load_average{app=\"APP\",instance=\"VM\",minutes=\"5\"})by(instance, region) / sum(count(fly_instance_cpu{app=\"APP\",instance=\"VM\",mode=\"idle\"})without(cpu))by(instance, region)"]},
    {"title": "Firecracker Memory Usage", "source_panel_id": 11, "unit": "bytes", "maximum": 1073741824, "queries": ["mode(fly_instance_memory_mem_total{app=\"APP\",instance=\"VM\"})", "fly_instance_memory_mem_total{app=\"APP\",instance=\"VM\"} - fly_instance_memory_mem_available{app=\"APP\",instance=\"VM\"}"]}
