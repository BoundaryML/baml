[
  {
    "id": 1101,
    "title": "Comparison \u00b7 Throughput \u00b7 HTTP 200",
    "type": "timeseries",
    "datasource": {
      "type": "prometheus",
      "uid": "prometheus_on_fly"
    },
    "gridPos": {
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 11
    },
    "description": "Fly app-proxy HTTP 200 responses per second. Includes health checks; excludes client-side timeouts and edge-only failures.",
    "fieldConfig": {
      "defaults": {
        "unit": "reqps",
        "min": 0,
        "custom": {
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 1,
          "fillOpacity": 0,
          "spanNulls": false,
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      },
      "overrides": [
        {
          "matcher": {
            "id": "byName",
            "options": "node-baseline"
          },
          "properties": [
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "#5794F2"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "node-baml"
          },
          "properties": [
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "#73BF69"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "python-baseline"
          },
          "properties": [
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "#FF9830"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "python-baml"
          },
          "properties": [
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "#B877D9"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "baml-debian"
          },
          "properties": [
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "#F2495C"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "baml-debian-telemetry"
          },
          "properties": [
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "#F2CC0C"
              }
            }
          ]
        }
      ]
    },
    "options": {
      "tooltip": {
        "mode": "multi",
        "sort": "none"
      },
      "legend": {
        "displayMode": "list",
        "placement": "bottom",
        "calcs": [
          "lastNotNull"
        ]
      }
    },
    "targets": [
      {
        "refId": "A",
        "expr": "sum(rate(fly_app_http_responses_count{app=\"baml-hw-0910-node-baseline\",instance=\"e8204d2b305308\",status=\"200\"}[$__rate_interval]))",
        "legendFormat": "node-baseline",
        "range": true,
        "editorMode": "code"
      },
      {
        "refId": "B",
        "expr": "sum(rate(fly_app_http_responses_count{app=\"baml-hw-0910-node-baml\",instance=\"080d69da292738\",status=\"200\"}[$__rate_interval]))",
        "legendFormat": "node-baml",
        "range": true,
        "editorMode": "code"
      },
      {
        "refId": "C",
        "expr": "sum(rate(fly_app_http_responses_count{app=\"baml-hw-0910-python-baseline\",instance=\"2862642f434d18\",status=\"200\"}[$__rate_interval]))",
        "legendFormat": "python-baseline",
        "range": true,
        "editorMode": "code"
      },
      {
        "refId": "D",
        "expr": "sum(rate(fly_app_http_responses_count{app=\"baml-hw-0910-python-baml\",instance=\"86599efe755658\",status=\"200\"}[$__rate_interval]))",
        "legendFormat": "python-baml",
        "range": true,
        "editorMode": "code"
      },
      {
        "refId": "E",
        "expr": "sum(rate(fly_app_http_responses_count{app=\"baml-hw-0910-baml-debian\",instance=\"8654d96a7056e8\",status=\"200\"}[$__rate_interval]))",
        "legendFormat": "baml-debian",
        "range": true,
        "editorMode": "code"
      },
      {
        "refId": "F",
        "expr": "sum(rate(fly_app_http_responses_count{app=\"baml-hw-0910-baml-debian-telemetry\",instance=\"83e131f7dde018\",status=\"200\"}[$__rate_interval]))",
        "legendFormat": "baml-debian-telemetry",
        "range": true,
        "editorMode": "code"
      }
    ]
  },
