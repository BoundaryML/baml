        "expr": "sum(rate(fly_instance_cpu{app=\"baml-hw-0910-node-baseline\",instance=\"e8204d2b305308\",mode=~\"user|nice|system|irq|softirq\"}[$__rate_interval])) / 100 / count(fly_instance_cpu{app=\"baml-hw-0910-node-baseline\",instance=\"e8204d2b305308\",mode=\"idle\"})",
        "legendFormat": "node-baseline",
        "range": true,
