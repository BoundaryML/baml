# scripts/compose.sh defaults to the dedicated Colima context.
# Override with LOCAL_DOCKER_CONTEXT=default ./scripts/compose.sh ...
RATE_PER_TARGET=100
DURATION_SECONDS=0
GRAFANA_PORT=3000
# Use ./grafana/dashboards-comparison to add the four all-variant comparison charts.
GRAFANA_DASHBOARDS_DIR=./grafana/dashboards
PROMETHEUS_PORT=9090
APP_PORT_PREFIX=808
# Override per copy using -p or COMPOSE_PROJECT_NAME.
COMPOSE_PROJECT_NAME=baml-local-hello-world
