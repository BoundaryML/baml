# Voice-agent arena server. Copy to .env and fill in.
OPENAI_API_KEY=            # required for the live arena (gpt-realtime sessions)
ANTHROPIC_API_KEY=         # optional: direct-Anthropic thinker (else proxy below)
PORT=8788
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_URL=              # set to a mock-realtime URL for keyless e2e
THINKER_MODEL=claude-sonnet-4-6
THINKER_BASE_URL=http://localhost:19090
THINKER_API_KEY=devproxytoken
CONVEX_URL=https://giddy-coyote-574.convex.cloud   # experiments project (prod); turn logging
API_CALL_LIMIT=10          # budget kill-switch (.api-budget.json)
