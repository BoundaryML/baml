// Markdown view of the matrix — a readable companion to the canonical JSON.
//
// The JSON serves both languages' hierarchies from one relation; markdown has
// no view toggle, so this renders the TypeScript-rooted view — the one the
// matrix is keyed on and the one a reader arrives wanting — and lists the BAML
// symbols no judgement named at the end. A reader who wants to browse the BAML
// side has the web page.
//
// Keep the output deterministic: no timestamps, no environment.

function escape_cell(value: string) -> string {
    value.replace_all("\\", "\\\\").replace_all("|", "\\|").replace_all("\r", "").replace_all(
        "\n",
        "<br>",
    )
}

/// Stands in for a version the extractor could not determine. Shared with the
/// ratchet so an absent version reads the same when reported as when rendered.
function provenance_absent() -> string {
    "absent"
}

/// Shows the reader which inputs this view was built from. Purely
/// presentational: `run --check` reads provenance from the canonical JSON, so
/// this block is free to change shape without breaking the ratchet.
function render_inputs_section(provenance: MatrixProvenance) -> string {
    [
        `- BAML stdlib surface: \`${provenance.baml_surface_sha256}\` (sha256 of the export)`,
        `- BAML export format: v${provenance.export_format_version}`,
        `- TypeScript: ${provenance.typescript_version}`,
        `- @types/node: ${provenance.types_node_version ?? provenance_absent()}`,
    ]
        .join("\n")
}

/// One row: the symbol, what was concluded about it, and on what grounds.
///
/// The state column distinguishes the three things a reader needs apart: a
/// counterpart, a considered absence, and a symbol nothing has looked at yet.
function render_symbol_row(
    symbol: TsSymbol,
    judgements: Judgement[],
    baml_by_id: map<string, BamlSymbol>,
) -> string {
    let counterparts: string[] = [];
    let verdict = verdict_of(judgements);
    let state = match (verdict) {
        "match" => "both",
        "divergent" => "divergent",
        "unnecessary" => "unnecessary",
        "none" => "TypeScript only",
        _ => "unjudged",
    };
    for (let judgement in judgements) {
        if (judgement.baml.length() > 0) {
            let note = if (judgement.basis == "model") {
                ` (${judgement.confidence ?? "?"})`
            } else {
                ""
            };
            for (let id in judgement.baml) {
                let display = if let counterpart: BamlSymbol = baml_by_id.get(id) {
                    counterpart.display
                } else {
                    id
                };
                counterparts.push(`${display}${note}`);
            }
        }
    }
    [
        `| ${escape_cell(symbol.display)} `,
        `| ${escape_cell(symbol.signature.lines().at(0) ?? "")} `,
        `| ${state} `,
        `| ${escape_cell(counterparts.join(", "))} |`,
    ]
        .join("")
}

function render_matrix_markdown(matrix: SymbolMatrix) -> string {
    let counts = matrix.counts;
    let baml_matched = counts.baml_symbols - counts.baml_unclaimed;

    // Judgements indexed by the symbol they are about, mirroring the web view.
    let by_ts: map<string, Judgement[]> = {};
    let baml_claimed: map<string, bool> = {};
    for (let judgement in matrix.judgements) {
        let bucket: Judgement[] = by_ts.get(judgement.ts) ?? [];
        bucket.push(judgement);
        let _ = by_ts.set(judgement.ts, bucket);
        // Every verdict claims what it names, matching `recount` — a symbol
        // offered as the way to do something BAML makes unnecessary has still
        // been pointed at. Gating on `judgement_pairs` here made the summary
        // line and the table thirty lines below it disagree by eight rows,
        // each listed under "no judgement names" while being counted as named.
        for (let id in judgement.baml) {
            let _ = baml_claimed.set(id, true);
        }
    }
    let baml_by_id: map<string, BamlSymbol> = {};
    for (let symbol in matrix.baml) {
        let _ = baml_by_id.set(symbol.id, symbol);
    }

    // Grouped by module, the way the tree reads: `(globals)`, `(web)`, and one
    // per node module.
    let groups: map<string, TsSymbol[]> = {};
    let order: string[] = [];
    for (let symbol in matrix.ts) {
        let group = symbol.symbol.at(0) ?? "(unknown)";
        if (!groups.has(group)) {
            let empty: TsSymbol[] = [];
            let _ = groups.set(group, empty);
            order.push(group);
        }
        if let bucket: TsSymbol[] = groups.get(group) {
            bucket.push(symbol);
        }
    }
    order.sort_by_key((name) -> {
        name
    });

    let out: string[] = [];
    out.push("# BAML ↔ TypeScript stdlib matrix");
    out.push("");
    out.push("Generated by `tools/stdlib-matrix/run`. Do not edit by hand.");
    out.push("");
    out.push("## Inputs");
    out.push("");
    out.push(render_inputs_section(matrix.provenance));
    out.push("");
    out.push("## Summary");
    out.push("");
    out.push(
        `${counts.matched} of ${counts.ts_symbols} TypeScript symbols have a BAML counterpart · ${counts.unnecessary} are unnecessary in BAML · ${counts.unmatched} were judged to have none · ${counts.unjudged} are still unjudged.`,
    );
    out.push("");
    out.push(
        `${baml_matched} of ${counts.baml_symbols} BAML symbols are named by a judgement · ${counts.baml_unclaimed} are not.`,
    );
    out.push("");
    out.push(
        "Every counterpart rests on a model's judgment, which carries its confidence in parentheses. `divergent` marks the same operation reached differently, and `unnecessary` marks one BAML does not need — the language answers it, so the question does not arise.",
    );
    out.push("");
    out.push("## TypeScript surface");
    out.push("");
    for (let group in order) {
        out.push(`### ${group}`);
        out.push("");
        out.push("| symbol | signature | state | BAML |");
        out.push("| --- | --- | --- | --- |");
        let members: TsSymbol[] = groups.get(group) ?? [];
        for (let member in members) {
            let judgements: Judgement[] = by_ts.get(member.id) ?? [];
            out.push(render_symbol_row(member, judgements, baml_by_id));
        }
        out.push("");
    }

    // Not the same claim as the section above. Nothing asked whether these have
    // a TypeScript counterpart, so this is what no judgement happened to name —
    // silence, not a finding.
    out.push("## BAML symbols no judgement names");
    out.push("");
    out.push("| symbol | signature |");
    out.push("| --- | --- |");
    for (let symbol in matrix.baml) {
        if (!baml_claimed.has(symbol.id)) {
            out.push(
                `| ${escape_cell(symbol.display)} | ${escape_cell(symbol.signature?.display ?? "")} |`,
            );
        }
    }
    out.push("");
    if (matrix.failures.length() > 0) {
        out.push("## Calls that did not come back");
        out.push("");
        out.push("| pass | subject | reason |");
        out.push("| --- | --- | --- |");
        for (let failure in matrix.failures) {
            out.push(
                `| ${failure.pass} | ${escape_cell(failure.subject)} | ${escape_cell(failure.reason)} |`,
            );
        }
        out.push("");
    }
    out.join("\n")
}
