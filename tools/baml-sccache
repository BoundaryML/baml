#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${BAML_SCCACHE_R2_ACCESS_KEY_ID:-}" ]]; then
    export AWS_ACCESS_KEY_ID="${BAML_SCCACHE_R2_ACCESS_KEY_ID}"
fi

if [[ -n "${BAML_SCCACHE_R2_SECRET_ACCESS_KEY:-}" ]]; then
    export AWS_SECRET_ACCESS_KEY="${BAML_SCCACHE_R2_SECRET_ACCESS_KEY}"
fi

exec sccache "$@"
