function PdfInput(pdf: pdf) -> string{
  client GPT4o
  prompt #"
    {{ _.role("user") }}

   Describe the main topic of this PDF document in 5 words or less.
    
    {{ pdf }}
  "#   
}  

function PdfInputOpenai(pdf: pdf, prompt: string) -> string{
  client GPT4o
  prompt #"
    {{ _.role("user") }}

   {{ prompt }}
    
    {{ pdf }}
  "#   
}  

function PdfInputAnthropic(pdf: pdf) -> string{
  client Claude
  prompt #"
    {{ _.role("user") }}

    Analyze this PDF document and provide a brief summary in 3-4 words.
    
    {{ pdf }}
  "#
}
       
test TestURLPdfInput{
  functions [PdfInput]
  args {
    pdf{ 
      url "https://ia801801.us.archive.org/15/items/the-great-gatsby_202101/TheGreatGatsby.pdf"
    }
  }  
}

test TestURLPdfInputOpenai{
  functions [PdfInputOpenai]
  args {
    pdf{ 
      url "https://ia801801.us.archive.org/15/items/the-great-gatsby_202101/TheGreatGatsby.pdf"
    }
    prompt "What is the main subject of this PDF document? Answer in 3-4 words."
  }  
}

test TestURLPdfInputAnthropic{
  functions [PdfInputAnthropic]
  args {
    pdf{ 
      url "https://ia801801.us.archive.org/15/items/the-great-gatsby_202101/TheGreatGatsby.pdf"
    }
  }  
}

test TestFilePdfInput{
  functions [PdfInput]
  args {
    pdf{ 
      // TODO: Replace with actual local PDF file for testing
      file "../../../../../dummy.pdf"
    }
  }  
}

test TestFilePdfInputWithMediaType{
  functions [PdfInput]
  args {
    pdf{ 
      // TODO: Replace with actual local PDF file for testing
      file "../../../../../dummy.pdf"
      media_type "application/pdf"
    }
  }  
}

test TestBase64PdfInput{
  functions [PdfInput]
  args {
    pdf{
      base64 ""
      media_type "application/pdf"
    }
  }
}

test TestBase64PdfInputNoMediaType{
  functions [PdfInput]
  args {
    pdf{
      base64 ""
    }
  }
}

test TestDataURLPdfInput{
  functions [PdfInput]
  args {
    pdf{
      base64 "data:application/pdf;base64,"
      }
  }
} 