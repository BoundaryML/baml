{
  "activationEvents": [
    "onLanguage:baml"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "category": "BAML",
        "command": "baml.openPlayground",
        "title": "Open Playground"
      },
      {
        "category": "BAML",
        "command": "baml.openLogs",
        "title": "Open Logs"
      },
      {
        "category": "BAML",
        "command": "baml.restartLanguageServer",
        "title": "Restart Language Server"
      },
      {
        "category": "BAML",
        "command": "baml.stopLanguageServer",
        "title": "Stop Language Server"
      },
      {
        "category": "BAML",
        "command": "baml.startLanguageServer",
        "title": "Start Language Server"
      }
    ],
    "configuration": {
      "properties": {
        "baml.cliPath": {
          "default": null,
          "description": "Path to the baml wrapper. If not set, uses 'baml' on PATH.",
          "scope": "machine-overridable",
          "type": [
            "string",
            "null"
          ]
        },
        "baml.trace.server": {
          "default": "off",
          "description": "Logging level between the VS Code extension and the language server.",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "scope": "window",
          "type": "string"
        }
      },
      "title": "BAML",
      "type": "object"
    },
    "configurationDefaults": {
      "[baml]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "bamlRainbow0:baml": "#f25c5c",
          "bamlRainbow1:baml": "#f2825c",
          "bamlRainbow2:baml": "#f2a75c",
          "bamlRainbow3:baml": "#f2cd5c",
          "bamlRainbow4:baml": "#f2f25c",
          "bamlRainbow5:baml": "#cdf25c",
          "bamlRainbow6:baml": "#a7f25c",
          "bamlRainbow7:baml": "#82f25c",
          "bamlRainbow8:baml": "#5cf25c",
          "bamlRainbow9:baml": "#5cf282",
          "bamlRainbow10:baml": "#5cf2a7",
          "bamlRainbow11:baml": "#5cf2cd",
          "bamlRainbow12:baml": "#5cf2f2",
          "bamlRainbow13:baml": "#5ccdf2",
          "bamlRainbow14:baml": "#5ca7f2",
          "bamlRainbow15:baml": "#5c82f2",
          "bamlRainbow16:baml": "#5c5cf2",
          "bamlRainbow17:baml": "#825cf2",
          "bamlRainbow18:baml": "#a75cf2",
          "bamlRainbow19:baml": "#cd5cf2",
          "bamlRainbow20:baml": "#f25cf2",
          "bamlRainbow21:baml": "#f25ccd",
          "bamlRainbow22:baml": "#f25ca7",
          "bamlRainbow23:baml": "#f25c82",
          "namespace:baml": "#808080CC"
        }
      }
    },
    "grammars": [
      {
        "language": "baml",
        "path": "./syntaxes/baml.tmLanguage.json",
        "scopeName": "source.baml"
      }
    ],
    "languages": [
      {
        "aliases": [
          "BAML",
          "baml"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".baml"
        ],
        "icon": {
          "dark": "./baml-lamb-dark.svg",
          "light": "./baml-lamb-light.svg"
        },
        "id": "baml"
      }
    ],
    "semanticTokenTypes": [
      {
        "description": "Native Rust sigil rainbow color.",
        "id": "bamlRainbow0",
        "superType": "macro"
