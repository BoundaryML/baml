NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/relay-JkOu

# Luma public API key (Calendar settings -> API). Powers the /eap page, which
# lists live EAP onboarding sessions pulled from the BAML Luma calendar.
LUMA_API_KEY=

# Convex deployment URL the /atb dashboard AND the /changelog feed read from
# (your deployment's .convex.cloud URL). Set in the Vercel project env. The
# changelog reads the changelogEntries table directly from this Convex deployment
# (app/api/changelog-feed/entries), so no separate changelog service URL is needed
# anymore (CHANGELOG_API is retired).
NEXT_PUBLIC_ATB_CONVEX_URL=

# Transcript/blob service the /atb run pages fetch raw transcripts from
# (bammy-2-service) + its bearer token (server-only; set in the Vercel env).
ATB_SERVICE_URL=https://bammy-2-service.fly.dev
ATB_SERVICE_TOKEN=
