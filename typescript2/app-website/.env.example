NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/relay-JkOu

# Luma public API key (Calendar settings -> API). Powers the /eap page, which
# lists live EAP onboarding sessions pulled from the BAML Luma calendar.
LUMA_API_KEY=

# Give an internal Notion connection access to the early access database.
# Use the data source ID, which is separate from the database page ID.
NOTION_EAP_TOKEN=
NOTION_EAP_DATA_SOURCE_ID=417bb2d2-6216-818c-a2f7-000b07b7cd11
