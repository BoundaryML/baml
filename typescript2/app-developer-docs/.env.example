# Runtime server credential. Grant SELECT on developer_docs only.
GENERATED_CONTENT_DATABASE_URL=

# Trusted release publisher. Grant SELECT and narrowly scoped INSERT/UPDATE.
GENERATED_CONTENT_PUBLISHER_DATABASE_URL=

# Migration operator only. Never configure this in the deployed application.
GENERATED_CONTENT_MIGRATION_DATABASE_URL=

# Required by future production publication in addition to the database URL.
DEVELOPER_DOCS_DATABASE_CONTEXT=local
