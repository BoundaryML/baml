{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "../baml_language/crates/baml_playground_wasm/src/**/*.rs",
    "../baml_language/crates/baml_playground_wasm/Cargo.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
