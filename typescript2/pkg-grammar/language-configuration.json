{
  "comments": {
    "lineComment": "//",
    "blockComment": ["{/*", "*/}"]
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    { "open": "\"", "close": "\"" },
    ["#\"", "\"#"],
    ["'", "'"],
    ["{#", "#}"],
    ["{/*", "*/}"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:impl|class|function|enum|prompt).*?:\\s*$",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "#\"",
      "action": { "indent": "indentOutdent" }
    }
  ]
}
