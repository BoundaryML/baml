# Server-side read-only store access. Do not put the service-role key here.
FEEDBACK_SUPABASE_URL=https://your-project.supabase.co
FEEDBACK_SUPABASE_ANON_KEY=

# Canonical public site origin and GitHub OAuth application.
ATB2_UI_URL=https://your-feedback-site.example
ATB2_GITHUB_CLIENT_ID=
ATB2_GITHUB_CLIENT_SECRET=
ATB2_UI_SESSION_SECRET=

# Private MiniATB API. Both secrets must be at least 32 characters.
ATB2_RUNNER_URL=https://atb2-runner.fly.dev
ATB2_UI_RUNNER_SECRET=
FEEDBACK_SLACK_URL=https://your-workspace.slack.com/archives/C0123456789
