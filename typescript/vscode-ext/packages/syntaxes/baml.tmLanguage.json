{
  "name": "BAML",
  "scopeName": "source.baml",
  "fileTypes": ["baml"],
  "patterns": [{ "include": "#comment" }, { "include": "#typeBlock" }, { "include": "#valueBlock" }],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.baml",
          "match": "//.*$"
        },
        {
          "name": "comment.line.triple-slash.baml",
          "match": "///.*$"
        }
      ]
    },
    "typeBlock": {
      "patterns": [
        {
          "name": "meta.type-block.baml",
          "begin": "\\b(?:class|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "entity.name.type.baml" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.baml" }
          },
          "patterns": [{ "include": "#comment" }, { "include": "#blockAttribute" }, { "include": "#fieldDefinition" }]
        }
      ]
    },
    "blockAttribute": {
      "patterns": [
        {
          "name": "meta.block-attribute.baml",
          "match": "@@([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.attribute.baml" }
          }
        }
      ]
    },
    "fieldDefinition": {
      "patterns": [
        {
          "name": "meta.field.baml",
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "beginCaptures": {
            "1": { "name": "entity.name.field.baml" }
          },
          "end": "(?=^\\s*[}])|(?=@@)|(?=^[A-Za-z_]|^\\s*$)|(?=\\Z)",
          "patterns": [
            {
              "name": "storage.type.baml",
              "match": "[A-Za-z_][A-Za-z0-9_]*(?:\\?|\\[\\])?"
            },
            {
              "name": "meta.field.attribute.baml",
              "match": "@[A-Za-z_][A-Za-z0-9_]*(\\([^)]*\\))?"
            }
          ]
        }
      ]
    },
    "valueBlock": {
      "patterns": [
        { "include": "#functionDefinition" },
        { "include": "#testDefinition" },
        { "include": "#clientDefinition" }
      ]
    },
    "functionDefinition": {
      "patterns": [
        {
          "name": "meta.function.definition.baml",
          "begin": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.baml" }
          },
          "end": "\\}",
          "patterns": [
            {
              "name": "meta.function.parameters.baml",
              "begin": "\\(",
              "end": "\\)",
              "patterns": [
                {
                  "name": "variable.parameter.baml",
                  "match": "[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                  "name": "punctuation.separator.parameter.baml",
                  "match": ","
                },
                {
                  "name": "punctuation.separator.colon.baml",
                  "match": ":"
                },
                {
                  "name": "storage.type.baml",
                  "match": "[A-Za-z_][A-Za-z0-9_]*(?:\\?|\\[\\])?"
                }
              ]
            },
            {
              "name": "keyword.operator.arrow.baml",
              "match": "->"
            },
            {
              "name": "storage.type.return.baml",
              "match": "[A-Za-z_][A-Za-z0-9_]*(?:\\?|\\[\\])?"
            },
            {
              "name": "punctuation.section.braces.begin.baml",
              "match": "\\{"
            },
            { "include": "#comment" },
            { "include": "#functionBody" }
          ]
        }
      ]
    },
    "functionBody": {
      "patterns": [
        {
          "name": "meta.function.body.baml",
          "begin": "(?=.)",
          "end": "(?=^\\s*\\})",
          "patterns": [
            {
              "name": "meta.client.line.baml",
              "match": "^\\s*client\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "entity.name.client.baml" }
              }
            },
            {
              "name": "meta.prompt.line.baml",
              "begin": "^\\s*prompt\\s+",
              "end": "(?=$)",
              "patterns": [{ "include": "#value" }]
            }
          ]
        }
      ]
    },
    "testDefinition": {
      "patterns": [
        {
          "name": "meta.test.definition.baml",
          "begin": "\\btest\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "entity.name.test.baml" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.baml" }
          },
          "patterns": [
            { "include": "#comment" },
            {
              "name": "meta.test.functions.baml",
              "begin": "^\\s*functions\\s*\\[",
              "end": "\\]",
              "patterns": [
                {
                  "name": "entity.other.function-reference.baml",
                  "match": "[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                  "name": "punctuation.separator.comma.baml",
                  "match": ","
                }
              ]
            },
            {
              "name": "meta.test.args.baml",
              "begin": "^\\s*args\\s+",
              "end": "(?=$)",
              "patterns": [{ "include": "#value" }]
            }
          ]
        }
      ]
    },
    "clientDefinition": {
      "patterns": [
        {
          "name": "meta.client.definition.baml",
          "begin": "\\b(client|retry_policy)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "storage.type.client_keyword.baml" },
            "2": { "name": "entity.name.type.client.baml" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.baml" }
          },
          "patterns": [
            { "include": "#comment" },
            {
              "name": "meta.client.keywords.baml",
              "begin": "^\\s*(provider|options|strategy|max_retries)\\s+",
              "end": "(?=$)",
              "patterns": [{ "include": "#value" }]
            },
            {
              "name": "meta.client.retry.baml",
              "match": "^\\s*retry_policy\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "entity.name.type.retry-policy.baml" }
              }
            }
          ]
        }
      ]
    },
    "value": {
      "patterns": [
        { "include": "#multilineString" },
        { "include": "#string" },
        {
          "name": "constant.numeric.baml",
          "match": "\\b\\d+\\.\\d+\\b|\\b\\d+\\b"
        },
        {
          "name": "constant.language.boolean.baml",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.baml",
          "match": "\\bnull\\b"
        },
        { "include": "#arrayValue" },
        { "include": "#mapValue" },
        { "include": "#environmentVariable" },
        { "include": "#unquotedString" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.baml",
          "begin": "\"",
          "end": "\"",
          "captures": {
            "0": { "name": "string.quoted.double.baml" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.baml",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "multilineString": {
      "name": "string.quoted.multiline.baml",
      "begin": "(#{1,4})\"",
      "beginCaptures": {
        "1": { "name": "constant.numeric.hash.baml" }
      },
      "end": "\"\\1",
      "patterns": []
    },
    "arrayValue": {
      "name": "meta.array.baml",
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "name": "punctuation.separator.comma.baml",
          "match": ","
        },
        { "include": "#value" }
      ]
    },
    "mapValue": {
      "name": "meta.map.baml",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "name": "punctuation.separator.comma.baml",
          "match": ","
        },
        { "include": "#comment" },
        {
          "name": "meta.map.keyvalue.baml",
          "begin": "(?=[^}\\s])",
          "end": "(?=,|\\}|$)",
          "patterns": [{ "include": "#value" }]
        }
      ]
    },
    "environmentVariable": {
      "name": "meta.environment-variable.baml",
      "match": "env\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "0": { "name": "entity.name.type.environment-variable.baml" }
      }
    },
    "unquotedString": {
      "name": "string.unquoted.baml",
      "match": "(?:[A-Za-z0-9_]+|https?:\\/\\/[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]+)"
    }
  }
}
