{
  "$schema": "./node_modules/turbo/schema.json",
  "globalEnv": ["NODE_ENV", "RUSTUP_HOME", "CARGO_HOME", "PATH"],
  "ui": "tui",
  "concurrency": "15",
  "tasks": {
    "//#clean": {
      "cache": false
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "inputs": ["**/*.baml"],
      "outputs": ["baml_client/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "**/*.rs",
        "**/*.toml",
        "**/Cargo.lock",
        "**/*.j2",
        "**/*.pest",
        "**/*.ts",
        "**/*.tsx"
      ],
      "outputs": [
        "dist/**",
        "node_modules/.cache/tsbuildinfo.json",
        "target/**",
        "npm/**",
        "artifacts/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.rs",
        "**/*.toml",
        "**/Cargo.lock",
        "**/*.j2",
        "**/*.pest",
        "**/*.ts",
        "**/*.tsx"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "target/**",
        "npm/**",
        "artifacts/**"
      ]
    },
    "release": {
      "dependsOn": ["^release"],
      "inputs": [
        "**/*.rs",
        "**/*.toml",
        "**/Cargo.lock",
        "**/*.j2",
        "**/*.pest",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "target/**",
        "npm/**",
        "artifacts/**"
      ]
    }
  }
}
