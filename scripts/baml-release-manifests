#!/usr/bin/env python3
"""Generate BAML toolchain and wrapper JSON manifests from release artifacts."""

from __future__ import annotations

import argparse
import hashlib
import json
import runpy
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
LOAD_RELEASE_PLAN = runpy.run_path(
    str(ROOT / "scripts" / "baml-language-version")
)["load_plan"]
PLATFORMS = json.loads(
    (ROOT / "release" / "platforms.json").read_text(encoding="utf-8")
)
TARGETS = [entry["target"] for entry in PLATFORMS["platforms"]]


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def artifact_url(tag: str, path: Path) -> str:
    return f"https://github.com/BoundaryML/baml/releases/download/{tag}/{path.name}"


def require_vsix(root: Path, version: str) -> Path:
    expected_name = f"baml-language-{version}.vsix"
    expected = root / expected_name
    candidates = sorted(root.glob("*.vsix"))
    missing = [] if expected.is_file() else [expected_name]
    extra = [path.name for path in candidates if path != expected]
    if missing or extra or len(candidates) != 1:
        raise SystemExit(f"VSIX artifact mismatch missing={missing} extra={extra}")
    return expected


def collect_artifacts(
    root: Path, product: str, version: str
) -> dict[str, dict[str, str]]:
    artifacts = {}
    prefix = f"{product}-{version}-"
    for path in sorted(root.iterdir()):
        if path.suffix == ".sha256" or not path.name.startswith(prefix):
            continue
        name = path.name.removeprefix(prefix)
        if name.endswith(".tar.gz"):
            target = name[:-7]
        elif name.endswith(".zip"):
            target = name[:-4]
        else:
            continue
        artifacts[target] = {
            "url": artifact_url(f"{product}-{version}", path),
            "sha256": sha256(path),
        }
    missing = sorted(set(TARGETS) - set(artifacts))
    extra = sorted(set(artifacts) - set(TARGETS))
    if missing or extra:
        raise SystemExit(
            f"{product} artifact target mismatch missing={missing} extra={extra}"
        )
    return artifacts


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--toolchain-dir", required=True, type=Path)
    parser.add_argument("--wrapper-dir", required=True, type=Path)
    parser.add_argument("--vsix-dir", required=True, type=Path)
    parser.add_argument("--out", required=True, type=Path)
    parser.add_argument("--plan", required=True, type=Path)
    parser.add_argument("--wrapper-version", required=True)
    parser.add_argument("--wrapper-changed", action="store_true")
    args = parser.parse_args()

    args.out.mkdir(parents=True, exist_ok=True)
    (args.out / "version").mkdir(parents=True, exist_ok=True)
    plan = LOAD_RELEASE_PLAN(args.plan)
    version = plan.canonical_version
    channel = plan.channel
    released_at = plan.released_at
    registry_versions = plan.registry_versions

    vsix = require_vsix(args.vsix_dir, version)
    toolchain = {
        "schema": 1,
        "version": version,
        "channel": channel,
        "released_at": released_at,
        "artifacts": collect_artifacts(args.toolchain_dir, "baml-language", version),
        "vsix": {
            "url": artifact_url(f"baml-language-{version}", vsix),
            "sha256": sha256(vsix),
        },
        "baml_bridge_pypi": {
            "version": registry_versions["pypi"],
        },
        "sdks": {
            "nodejs": {
                "registry": "npm",
                "package": "@boundaryml/baml-bridge",
                "version": registry_versions["npm"],
            },
            "python": {
                "registry": "pypi",
                "package": "baml_bridge",
                "version": registry_versions["pypi"],
            },
        },
    }
    text = json.dumps(toolchain, indent=2, sort_keys=True) + "\n"
    (args.out / "version" / f"{version}.json").write_text(text)
    (args.out / f"{channel}.json").write_text(text)

    if args.wrapper_changed:
        wrapper = {
            "schema": 1,
            "version": args.wrapper_version,
            "released_at": released_at,
            "artifacts": collect_artifacts(
                args.wrapper_dir, "baml-wrapper", args.wrapper_version
            ),
        }
        (args.out / "wrapper.json").write_text(
            json.dumps(wrapper, indent=2, sort_keys=True) + "\n"
        )


if __name__ == "__main__":
    main()
