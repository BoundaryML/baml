#!/usr/bin/env python3
"""Reject floating toolchain and tool versions in GitHub workflows and actions.

A version like `latest` or `stable` resolves to whatever upstream published
most recently, so a workflow can break with no change in this repository
(e.g. `node-version: latest` picking up a Node alpha that bundles a new npm
major). Every toolchain input and every tool install must name a version.

A line that must float can opt out with a trailing `# float-ok: <reason>`.
"""

from __future__ import annotations

import argparse
import re
import shlex
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_PATHS = (ROOT / ".github",)

FLOAT_OK = re.compile(r"#\s*float-ok:\s*\S")

FLOATING_VALUES = frozenset(
    {"latest", "stable", "beta", "nightly", "current", "node", "lts", "*", "x"}
)

# YAML keys that select a toolchain or tool version, e.g. `node-version`,
# `rust-toolchain`, `rubygems`, or `NODE_VERSION` in an `env:` block.
VERSION_KEY = re.compile(
    r"^\s*(?:-\s+)?([A-Za-z0-9_-]*(?:version|toolchain)|rubygems)\s*:\s*(.*?)\s*$",
    re.IGNORECASE,
)

# Actions whose ref is the toolchain, e.g. `dtolnay/rust-toolchain@stable`.
TOOLCHAIN_REF_ACTIONS = ("dtolnay/rust-toolchain",)
USES = re.compile(r"^\s*(?:-\s+)?uses:\s*['\"]?([^@\s'\"]+)@([^\s'\"]+)")

SHELL_SEPARATORS = frozenset({"&&", "||", ";", "|", "&", "(", ")", "then", "do"})
PIPED_INSTALLER = re.compile(
    r"\b(?:curl|wget)\b[^|]*\|\s*(?:sudo\s+)?(?:\S+=\S+\s+)*(?:ba|z)?sh\b"
)
PINNED_PIPED_INSTALLER = re.compile(
    r"\|\s*(?:sudo\s+)?(?:\S+=\S+\s+)*[A-Z_]*VERSION=\S+"
)


@dataclass(frozen=True)
class Violation:
    path: Path
    line: int
    message: str

    def render(self, root: Path) -> str:
        try:
            shown = self.path.relative_to(root)
        except ValueError:
            shown = self.path
        return f"{shown}:{self.line}: {self.message}"


def strip_comment(line: str) -> str:
    """Drop a trailing YAML/shell comment, ignoring `#` inside quotes."""
    quote = None
    for index, char in enumerate(line):
        if quote:
            if char == quote:
                quote = None
        elif char in "'\"":
            quote = char
        elif char == "#" and (index == 0 or line[index - 1].isspace()):
            return line[:index]
    return line


def unquote(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        return value[1:-1]
    return value


def is_floating_value(value: str) -> bool:
    value = unquote(value.strip()).lower()
    return value in FLOATING_VALUES or value.startswith("lts/")


def is_floating_channel(channel: str) -> bool:
    """`stable`, `nightly`, `stable-x86_64-...` float; `1.98.0` and `nightly-2026-10-29` do not."""
    return is_floating_value(channel.split("-")[0]) and not re.search(
        r"-\d{4}-\d{2}-\d{2}", channel
    )


def logical_lines(text: str) -> list[tuple[int, str, str]]:
    """Yield `(line number, code, raw)`, joining shell `\\` continuations."""
    out: list[tuple[int, str, str]] = []
    pending: tuple[int, str, str] | None = None
    for number, raw in enumerate(text.splitlines(), start=1):
        code = strip_comment(raw)
        if pending is not None:
            start, code_acc, raw_acc = pending
            code, raw = code_acc + " " + code.strip(), raw_acc + "\n" + raw
            number = start
        if code.rstrip().endswith("\\"):
            pending = (number, code.rstrip()[:-1], raw)
            continue
        pending = None
        out.append((number, code, raw))
    if pending is not None:
        out.append(pending)
    return out


def split_commands(code: str) -> list[list[str]]:
    try:
        lexer = shlex.shlex(code, posix=True, punctuation_chars=";&|()")
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        tokens = code.split()
    commands: list[list[str]] = [[]]
    for token in tokens:
        if token in SHELL_SEPARATORS:
            commands.append([])
        else:
            commands[-1].append(token)
    return [command for command in commands if command]


def positional(args: list[str], value_flags: frozenset[str] = frozenset()) -> list[str]:
    out = []
    skip = False
    for arg in args:
        if skip:
            skip = False
        elif arg in value_flags:
            skip = True
        elif not arg.startswith("-"):
            out.append(arg)
    return out


def npm_spec_has_version(spec: str) -> bool:
    """`name@1.2.3`, `@scope/name@1.2.3`, or a path/URL/variable rather than a registry name."""
    name = spec[1:] if spec.startswith("@") else spec
    return "@" in name or ":" in spec or spec.startswith((".", "/", "$"))


def python_spec_has_version(spec: str) -> bool:
    return bool(re.search(r"==|@|\.whl$|\.tar\.gz$|[/$]", spec)) or spec.startswith(".")


def check_command(command: list[str]) -> str | None:
    tool, *args = command
    while tool in {"sudo", "env", "time"} or "=" in tool and not tool.startswith("-"):
        if not args:
            return None
        tool, *args = args

    if tool in {"npm", "pnpm", "yarn", "bun"} and args:
        subcommand, *rest = args
        is_global = bool({"-g", "--global"} & set(rest)) or subcommand == "global"
        if subcommand == "global" and rest[:1] == ["add"]:
            rest = rest[1:]
        if is_global and subcommand in {"install", "i", "add", "global"}:
            unpinned = [
                spec for spec in positional(rest) if not npm_spec_has_version(spec)
            ]
            if unpinned:
                return f"global install of {', '.join(unpinned)} without a version (use name@x.y.z)"
        if subcommand in {"dlx", "x"}:
            return check_npx(rest, tool + " " + subcommand)
    if tool in {"npx", "bunx", "pnpx"}:
        return check_npx(args, tool)

    if tool == "cargo" and args[:1] in (["install"], ["binstall"]):
        rest = args[1:]
        flags = set(rest)
        if "--path" in flags:
            return None
        if "--git" in flags:
            if not {"--rev", "--tag"} & flags:
                return "cargo install --git without --rev or --tag"
            return None
        value_flags = frozenset(
            {
                "--version",
                "--vers",
                "--root",
                "--target",
                "--features",
                "-F",
                "--profile",
                "--index",
                "--registry",
                "-j",
                "--jobs",
                "--bin",
                "--example",
                "--config",
                "-Z",
            }
        )
        if {"--version", "--vers"} & flags:
            return None
        unpinned = [
            crate for crate in positional(rest, value_flags) if "@" not in crate
        ]
        if unpinned:
            return f"cargo install of {', '.join(unpinned)} without --version"

    if tool == "go" and args[:1] == ["install"]:
        for spec in positional(args[1:]):
            if "@" not in spec and not spec.startswith((".", "/")):
                return f"go install of {spec} without @version"

    if tool == "gem" and args[:1] == ["install"]:
        if not {"-v", "--version"} & set(args):
            return "gem install without -v"

    python_install = (
        tool in {"pip", "pip3"}
        and args[:1] == ["install"]
        or tool == "uv"
        and args[:2] in (["tool", "install"], ["pip", "install"])
        or tool == "pipx"
        and args[:1] == ["install"]
    )
    if python_install:
        start = 2 if tool == "uv" else 1
        value_flags = frozenset(
            {
                "-r",
                "--requirement",
                "-c",
                "--constraint",
                "-e",
                "--editable",
                "--python",
                "-p",
                "--with",
                "--index-url",
                "--extra-index-url",
            }
        )
        unpinned = [
            spec
            for spec in positional(args[start:], value_flags)
            if not python_spec_has_version(spec)
        ]
        if unpinned:
            return f"python install of {', '.join(unpinned)} without ==version"
    if tool == "uvx" and args:
        spec = positional(args, frozenset({"--from", "--with", "--python", "-p"}))
        if "--from" not in args and spec and not python_spec_has_version(spec[0]):
            return f"uvx {spec[0]} without ==version"

    if (
        tool in {"cargo", "rustc", "rustup", "rustdoc"}
        and args
        and args[0].startswith("+")
    ):
        if is_floating_channel(args[0][1:]):
            return (
                f"`{tool} {args[0]}` floats (pin e.g. +1.98.0 or +nightly-YYYY-MM-DD)"
            )

    if tool == "rustup":
        if args[:2] == ["toolchain", "install"]:
            channels = positional(args[2:])
        elif args[:1] in (["install"], ["default"]):
            channels = positional(args[1:])
        elif args[:2] == ["override", "set"]:
            channels = positional(args[2:])
        else:
            channels = []
        floating = [channel for channel in channels if is_floating_channel(channel)]
        if floating:
            return f"rustup {' '.join(args[:2])} {floating[0]} floats (pin e.g. 1.98.0 or nightly-YYYY-MM-DD)"
    return None


def check_npx(args: list[str], tool: str) -> str | None:
    if {"--no", "--no-install", "--offline"} & set(args):
        return None
    specs = positional(args, frozenset({"-p", "--package", "-c", "--call"}))
    if "-p" in args or "--package" in args:
        index = args.index("-p") if "-p" in args else args.index("--package")
        specs = args[index + 1 : index + 2]
    if specs and not npm_spec_has_version(specs[0]):
        return f"{tool} {specs[0]} without a version (use name@x.y.z, or --no for a local dependency)"
    return None


def check_text(path: Path, text: str) -> list[Violation]:
    violations = []
    # A composite action input like `node-version:` whose `default:` follows on a later line.
    open_input: tuple[str, int] | None = None
    for number, code, raw in logical_lines(text):
        if not code.strip():
            continue
        indent = len(code) - len(code.lstrip())
        if open_input and indent <= open_input[1]:
            open_input = None
        if FLOAT_OK.search(raw):
            continue

        key = VERSION_KEY.match(code)
        if key and not key.group(2):
            open_input = (key.group(1), indent)
            continue
        if key and is_floating_value(key.group(2)):
            violations.append(
                Violation(
                    path,
                    number,
                    f"`{key.group(1)}: {unquote(key.group(2))}` floats; pin an exact version",
                )
            )
            continue

        default = re.match(r"^\s*default\s*:\s*(.*?)\s*$", code)
        if open_input and default:
            if is_floating_value(default.group(1)):
                violations.append(
                    Violation(
                        path,
                        number,
                        f"input `{open_input[0]}` defaults to `{unquote(default.group(1))}`, which floats; pin an exact version",
                    )
                )
            continue

        uses = USES.match(code)
        if uses:
            action, ref = uses.groups()
            if action in TOOLCHAIN_REF_ACTIONS and is_floating_value(ref):
                violations.append(
                    Violation(
                        path,
                        number,
                        f"`{action}@{ref}` floats; use `{action}@<version>`",
                    )
                )
            continue

        body = (
            code.split(":", 1)[1] if re.match(r"^\s*(?:-\s+)?run\s*:", code) else code
        )
        if re.search(r"@latest\b", body):
            violations.append(
                Violation(path, number, "`@latest` floats; pin an exact version")
            )
            continue
        if PIPED_INSTALLER.search(body) and not PINNED_PIPED_INSTALLER.search(body):
            violations.append(
                Violation(path, number, "piped installer without a *_VERSION= pin")
            )
            continue
        for command in split_commands(body):
            message = check_command(command)
            if message:
                violations.append(Violation(path, number, message))
                break
    return violations


def iter_files(paths: list[Path]):
    for path in paths:
        if path.is_dir():
            yield from sorted(
                p
                for p in path.rglob("*")
                if p.suffix in {".yml", ".yaml"} and p.is_file()
            )
        elif path.suffix in {".yml", ".yaml"}:
            yield path


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "paths", nargs="*", type=Path, help="files or directories (default: .github)"
    )
    args = parser.parse_args()
    paths = args.paths or list(DEFAULT_PATHS)

    violations = [
        v for path in iter_files(paths) for v in check_text(path, path.read_text())
    ]
    for violation in violations:
        print(violation.render(Path.cwd()), file=sys.stderr)
    if violations:
        print(
            f"\n{len(violations)} floating version(s). Pin them, or append `# float-ok: <reason>`.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
