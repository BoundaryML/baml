#!/usr/bin/env python3
"""Manage the BAML language release version surfaces."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
RELEASE_TOML = ROOT / "baml_language" / "release.toml"
BAML_VERSION_RS = ROOT / "baml_language" / "crates" / "baml_version" / "src" / "lib.rs"
PYPROJECT = ROOT / "baml_language" / "sdks" / "python" / "pyproject.toml"
PY_INIT = ROOT / "baml_language" / "sdks" / "python" / "src" / "baml_bridge" / "__init__.py"
VSIX_PACKAGE = ROOT / "typescript2" / "app-vscode-ext" / "package.json"
NODE_PACKAGE = ROOT / "baml_language" / "sdks" / "typescript" / "bridge_typescript" / "package.json"
NODE_NATIVE_JS = ROOT / "baml_language" / "sdks" / "typescript" / "bridge_typescript" / "dist" / "native.js"
WEB_PACKAGE = ROOT / "baml_language" / "sdks" / "typescript" / "bridge_typescript_web" / "package.json"
NPM_PACKAGES = (NODE_PACKAGE, WEB_PACKAGE)
RUST_BRIDGE_VERSION_RS = ROOT / "baml_language" / "sdks" / "rust" / "bridge_rust" / "src" / "version.rs"
RUST_BRIDGE_CARGO_TOML = ROOT / "baml_language" / "sdks" / "rust" / "bridge_rust" / "Cargo.toml"
WRAPPER_CARGO_TOML = ROOT / "baml_language" / "crates" / "baml" / "Cargo.toml"

SEMVER_RE = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")
CANONICAL_RE = re.compile(
    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-nightly\.(\d{8})\.([a-z]))?$"
)
SHA_RE = re.compile(r"^[a-z]$")

# Release-plan schema. Version 2 carries per-registry versions in a
# `registry_versions` map instead of a flat `pypi_version` field, so a new
# registry adds a map entry rather than a top-level field. The loader fails
# closed on any other schema.
PLAN_SCHEMA = 2

# Registries whose package version this plan carries. crates.io and npm both
# accept the canonical SemVer verbatim (identity translation); PyPI needs the
# `.devN` encoding (see `to_pypi_version`). No .NET/NuGet registry ships yet,
# so it is intentionally absent — a plan must never claim a registry it does
# not produce.
PLAN_REGISTRIES = ("pypi", "npm", "crates_io")


@dataclass(frozen=True, order=True)
class Version:
    major: int
    minor: int
    patch: int

    @classmethod
    def parse(cls, value: str) -> "Version":
        match = SEMVER_RE.fullmatch(value)
        if not match:
            raise ValueError(f"invalid canary version {value!r}; expected MAJOR.MINOR.PATCH")
        return cls(*(int(part) for part in match.groups()))

    def __str__(self) -> str:
        return f"{self.major}.{self.minor}.{self.patch}"

    def bump_major(self) -> "Version":
        return Version(self.major + 1, 0, 0)

    def bump_minor(self) -> "Version":
        return Version(self.major, self.minor + 1, 0)

    def bump_patch(self) -> "Version":
        return Version(self.major, self.minor, self.patch + 1)

    def next_patch(self) -> "Version":
        return self.bump_patch()


@dataclass(frozen=True)
class ReleasePlan:
    schema: int
    channel: str
    canary_version: str
    canonical_version: str
    registry_versions: dict[str, str]
    git_tag: str

    def to_json(self) -> str:
        return json.dumps(self.__dict__, indent=2, sort_keys=True) + "\n"

    # Per-registry accessors. The registry version is only an encoding of the
    # canonical version; host APIs and manifest identity use canonical_version.
    @property
    def pypi_version(self) -> str:
        return self.registry_versions["pypi"]

    @property
    def npm_version(self) -> str:
        return self.registry_versions["npm"]

    @property
    def crates_io_version(self) -> str:
        return self.registry_versions["crates_io"]


def fail(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_release_content(content: str) -> Version:
    section: str | None = None
    release: dict[str, str] = {}

    for raw_line in content.splitlines():
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue

        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue

        if section != "release":
            continue

        key, separator, value = line.partition("=")
        if not separator:
            fail(f"invalid release.toml line: {raw_line}")

        key = key.strip()
        value = value.strip()
        if len(value) < 2 or not value.startswith('"') or not value.endswith('"'):
            fail(f"release.{key} must be a quoted string")

        release[key] = value[1:-1]

    canary_version = release.get("canary_version")
    if canary_version is None:
        fail("release.canary_version must be a string")

    try:
        return Version.parse(canary_version)
    except ValueError as exc:
        fail(str(exc))


def parse_previous_release_content(content: str) -> Version:
    if "[release]" in content:
        return parse_release_content(content)

    section: str | None = None
    channel: dict[str, str] = {}
    for raw_line in content.splitlines():
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if section != "channel":
            continue
        key, separator, value = line.partition("=")
        if separator and value.strip().startswith('"') and value.strip().endswith('"'):
            channel[key.strip()] = value.strip()[1:-1]

    base_version = channel.get("base_version")
    if base_version is None:
        fail("previous baml_language/release.toml is invalid")
    try:
        return Version.parse(base_version)
    except ValueError as exc:
        fail(f"previous baml_language/release.toml is invalid: {exc}")


def load_release(path: Path = RELEASE_TOML) -> Version:
    try:
        content = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        fail(f"{path.relative_to(ROOT)} does not exist")
    return parse_release_content(content)


def write_release(version: Version) -> None:
    RELEASE_TOML.write_text(f'[release]\ncanary_version = "{version}"\n', encoding="utf-8")


def git_output(*args: str) -> str | None:
    try:
        return subprocess.check_output(
            ["git", *args],
            cwd=ROOT,
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def previous_release_toml() -> str | None:
    if not (ROOT / ".git").exists():
        return None

    candidates: list[str] = []
    base_ref = os.environ.get("GITHUB_BASE_REF")
    if base_ref:
        candidates.extend([f"origin/{base_ref}", base_ref])
    candidates.extend(["origin/canary", "origin/main"])

    for candidate in candidates:
        merge_base = git_output("merge-base", "HEAD", candidate)
        if not merge_base:
            continue
        content = git_output("show", f"{merge_base}:baml_language/release.toml")
        if content:
            return content
    return None


def today_utc() -> str:
    override = os.environ.get("BAML_LANGUAGE_VERSION_DATE")
    if override:
        if not re.fullmatch(r"\d{8}", override):
            fail("BAML_LANGUAGE_VERSION_DATE must be YYYYMMDD")
        return override
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d")


def command_output(command: list[str]) -> str | None:
    try:
        return subprocess.check_output(
            command,
            cwd=ROOT,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=30,
        )
    except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
        return None


def release_tags() -> list[str]:
    output = command_output(
        [
            "gh",
            "release",
            "list",
            "--repo",
            "BoundaryML/baml",
            "--limit",
            "200",
            "--json",
            "tagName",
            "--jq",
            ".[].tagName",
        ]
    )
    if output:
        return [line.strip() for line in output.splitlines() if line.strip()]

    output = command_output(["git", "ls-remote", "--tags", "https://github.com/BoundaryML/baml.git"])
    if output:
        tags: list[str] = []
        for line in output.splitlines():
            ref = line.rsplit("/", 1)[-1].removesuffix("^{}")
            if ref:
                tags.append(ref)
        return tags

    return []


def next_nightly_letter(base: Version, date: str, tags: list[str] | None = None) -> str:
    prefix = f"baml-language-{base}-nightly.{date}."
    used = sorted(
        tag.removeprefix(prefix)
        for tag in (tags if tags is not None else release_tags())
        if tag.startswith(prefix) and SHA_RE.fullmatch(tag.removeprefix(prefix))
    )
    if not used:
        return "a"

    max_index = max(ord(letter) - ord("a") for letter in used)
    if max_index >= 25:
        fail(
            f"26 nightly builds today for base {base}; wait for the next UTC day or cut a new canary release by bumping baml_language/release.toml [release].canary_version.",
            code=2,
        )
    return chr(ord("a") + max_index + 1)


def compute_version(channel: str) -> str:
    canary = load_release()
    if channel == "canary":
        return str(canary)
    if channel == "nightly":
        base = canary.next_patch()
        date = today_utc()
        letter = next_nightly_letter(base, date)
        return f"{base}-nightly.{date}.{letter}"
    fail(f"unsupported channel {channel!r}")


def to_pypi_version(canonical: str) -> str:
    match = CANONICAL_RE.fullmatch(canonical)
    if not match:
        fail(f"invalid canonical version {canonical!r}")
    major, minor, patch, date, letter = match.groups()
    if date is None:
        return f"{major}.{minor}.{patch}"
    index = ord(letter) - ord("a")
    return f"{major}.{minor}.{patch}.dev{date}{index:02d}"


def registry_versions_for(canonical: str) -> dict[str, str]:
    translations = {
        "pypi": to_pypi_version(canonical),
        "npm": canonical,
        "crates_io": canonical,
    }
    # Keep the map and the declared registry set in lockstep.
    assert set(translations) == set(PLAN_REGISTRIES)
    return translations


def make_plan(channel: str) -> ReleasePlan:
    canonical = compute_version(channel)
    return ReleasePlan(
        schema=PLAN_SCHEMA,
        channel=channel,
        canary_version=str(load_release()),
        canonical_version=canonical,
        registry_versions=registry_versions_for(canonical),
        git_tag=f"baml-language-{canonical}",
    )


def load_plan(path: Path) -> ReleasePlan:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"{path} does not exist")
    except json.JSONDecodeError as exc:
        fail(f"{path} is not valid JSON: {exc}")

    schema = data.get("schema")
    if schema != PLAN_SCHEMA:
        fail(
            f"{path} has release-plan schema {schema!r}, but this tool only supports "
            f"schema {PLAN_SCHEMA}. Regenerate it with `baml-language-version plan`."
        )

    try:
        raw_registry_versions = data["registry_versions"]
    except KeyError as exc:
        fail(f"{path} is missing {exc.args[0]!r}")
    if not isinstance(raw_registry_versions, dict):
        fail(f"{path} registry_versions must be a JSON object")
    registry_versions = {str(key): str(value) for key, value in raw_registry_versions.items()}
    missing = [name for name in PLAN_REGISTRIES if name not in registry_versions]
    if missing:
        fail(f"{path} registry_versions is missing {', '.join(missing)}")

    try:
        return ReleasePlan(
            schema=PLAN_SCHEMA,
            channel=str(data["channel"]),
            canary_version=str(data["canary_version"]),
            canonical_version=str(data["canonical_version"]),
            registry_versions=registry_versions,
            git_tag=str(data["git_tag"]),
        )
    except KeyError as exc:
        fail(f"{path} is missing {exc.args[0]!r}")


def replace_regex(path: Path, pattern: str, replacement: str) -> None:
    text = path.read_text(encoding="utf-8")
    new_text, count = re.subn(pattern, replacement, text, count=1, flags=re.MULTILINE)
    if count != 1:
        fail(f"could not update expected version surface in {path.relative_to(ROOT)}")
    path.write_text(new_text, encoding="utf-8")


def stamp(plan: ReleasePlan) -> None:
    BAML_VERSION_RS.parent.mkdir(parents=True, exist_ok=True)
    BAML_VERSION_RS.write_text(
        "\n".join(
            [
                "//! Stamped BAML language product version.",
                "",
                f'pub const CANONICAL_VERSION: &str = "{plan.canonical_version}";',
                f'pub const PYPI_VERSION: &str = "{plan.pypi_version}";',
                f'pub const CHANNEL: &str = "{plan.channel}";',
                f'pub const STABLE_VERSION: &str = "{plan.canary_version}";',
                "",
            ]
        ),
        encoding="utf-8",
    )
    replace_regex(PYPROJECT, r'^version = ".*"$', f'version = "{plan.pypi_version}"')
    # The Rust bridge cannot depend on the internal baml_version crate when
    # published; it carries its own stamped constant (and its loader's
    # version handshake compares the loaded engine against it).
    replace_regex(
        RUST_BRIDGE_VERSION_RS,
        r'^pub\(crate\) const CANONICAL_VERSION: &str = ".*";$',
        f'pub(crate) const CANONICAL_VERSION: &str = "{plan.canonical_version}";',
    )
    # The bridge crate publishes to crates.io, so its Cargo.toml version is a
    # literal (not the workspace `0.0.0-beta`) stamped from the plan's
    # crates.io registry version (identity of the canonical version).
    replace_regex(
        RUST_BRIDGE_CARGO_TOML,
        r'^version = ".*"$',
        f'version = "{plan.crates_io_version}"',
    )
    replace_regex(VSIX_PACKAGE, r'^  "version": ".*",$', f'  "version": "{plan.canonical_version}",')
    for package in NPM_PACKAGES:
        if package.exists():
            replace_regex(package, r'^  "version": ".*",$', f'  "version": "{plan.canonical_version}",')

    text = PY_INIT.read_text(encoding="utf-8")
    version_line = f'__version__ = "{plan.canonical_version}"\n'
    if re.search(r'^__version__ = ".*"$', text, flags=re.MULTILINE):
        text = re.sub(r'^__version__ = ".*"$', version_line.rstrip(), text, count=1, flags=re.MULTILINE)
    else:
        marker = "atexit.register(flush_events)\n"
        if marker in text:
            text = text.replace(marker, marker + "\n" + version_line, 1)
        else:
            text = text.rstrip() + "\n\n" + version_line
    if '__version__ = "' not in text:
        fail(f"failed to stamp __version__ in {PY_INIT.relative_to(ROOT)}")
    PY_INIT.write_text(text, encoding="utf-8")


def regenerate_node_bridge() -> None:
    if not NODE_PACKAGE.exists():
        return

    try:
        subprocess.run(
            ["pnpm", "install", "--frozen-lockfile", "--ignore-workspace", "--ignore-scripts"],
            cwd=NODE_PACKAGE.parent,
            check=True,
        )
        subprocess.run(
            ["pnpm", "build:debug"],
            cwd=NODE_PACKAGE.parent,
            check=True,
        )
    except FileNotFoundError:
        fail("pnpm is required to install and regenerate the Node bridge after a canary version bump")
    except subprocess.CalledProcessError as exc:
        fail(
            "failed to install or regenerate the Node bridge after stamping versions. "
            "Run `cd baml_language/sdks/typescript/bridge_typescript && "
            "pnpm install --frozen-lockfile --ignore-workspace --ignore-scripts && pnpm build:debug` "
            "for details.",
            code=exc.returncode,
        )


def sync_canary() -> None:
    stamp(make_plan("canary"))
    regenerate_node_bridge()


def check_release() -> None:
    current = load_release()
    previous = previous_release_toml()
    if previous is not None:
        previous_version = parse_previous_release_content(previous)
        if current < previous_version:
            fail(f"canary_version must not decrease: {current} < {previous_version}")

    if current.next_patch() <= current:
        fail(f"nightly base {current.next_patch()} must be greater than canary {current}")

    expected = make_plan("canary")
    mismatches: list[str] = []
    checks = {
        "baml_version::CANONICAL_VERSION": expected.canonical_version in BAML_VERSION_RS.read_text(encoding="utf-8"),
        "baml_version::PYPI_VERSION": expected.pypi_version in BAML_VERSION_RS.read_text(encoding="utf-8"),
        "python pyproject version": f'version = "{expected.pypi_version}"' in PYPROJECT.read_text(encoding="utf-8"),
        "python __version__": f'__version__ = "{expected.canonical_version}"' in PY_INIT.read_text(encoding="utf-8"),
        # Load-bearing beyond drift hygiene: the Rust bridge's loader
        # handshakes the loaded engine's version() against this constant,
        # in development builds too.
        "rust bridge CANONICAL_VERSION": (
            f'pub(crate) const CANONICAL_VERSION: &str = "{expected.canonical_version}";'
            in RUST_BRIDGE_VERSION_RS.read_text(encoding="utf-8")
        ),
        "rust bridge Cargo.toml version": (
            # stamp() writes this from crates_io_version; check the same
            # property (identity of canonical today, but the encodings may
            # diverge as PyPI's already does).
            f'version = "{expected.crates_io_version}"'
            in RUST_BRIDGE_CARGO_TOML.read_text(encoding="utf-8")
        ),
        "vsix package version": f'"version": "{expected.canonical_version}"' in VSIX_PACKAGE.read_text(encoding="utf-8"),
    }
    if NODE_PACKAGE.exists():
        checks["node package version"] = f'"version": "{expected.canonical_version}"' in NODE_PACKAGE.read_text(encoding="utf-8")
        if not NODE_NATIVE_JS.exists():
            mismatches.append(
                "node native loader version guards: "
                f"{NODE_NATIVE_JS.relative_to(ROOT)} is missing. Run "
                "`scripts/baml-language-version sync` and commit the generated output."
            )
        else:
            native_text = NODE_NATIVE_JS.read_text(encoding="utf-8")
            native_versions = sorted(
                set(re.findall(r"bindingPackageVersion !== '([^']+)'", native_text))
            )
            if not native_versions:
                mismatches.append(
                    "node native loader version guards: no napi version guards found in "
                    f"{NODE_NATIVE_JS.relative_to(ROOT)}"
                )
            elif native_versions != [expected.canonical_version]:
                mismatches.append(
                    "node native loader version guards: "
                    f"{NODE_NATIVE_JS.relative_to(ROOT)} embeds {', '.join(native_versions)}; "
                    f"expected {expected.canonical_version}. Run "
                    "`scripts/baml-language-version sync` and commit the generated output."
                )
    if WEB_PACKAGE.exists():
        checks["web package version"] = f'"version": "{expected.canonical_version}"' in WEB_PACKAGE.read_text(encoding="utf-8")

    for name, ok in checks.items():
        if not ok:
            mismatches.append(name)

    forbidden = command_output(
        [
            "rg",
            "-n",
            "BAML_RELEASE_VERSION|BAML_WRAPPER_VERSION|env!\\(\"CARGO_PKG_VERSION\"\\)",
            "baml_language/crates",
            "baml_language/sdks",
            "scripts",
            ".github/workflows",
        ]
    )
    if forbidden:
        allowed = []
        for line in forbidden.splitlines():
            if "tools_stow" in line or "crates/baml/src" in line:
                continue
            if "scripts/baml-language-version:" in line:
                continue
            allowed.append(line)
        if allowed:
            mismatches.append("deprecated version plumbing:\n" + "\n".join(allowed))

    wrapper_toml = WRAPPER_CARGO_TOML.read_text(encoding="utf-8")
    if "version.workspace" in wrapper_toml:
        mismatches.append("wrapper crate must use a literal [package].version")
    if not re.search(r'^version = "(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"$', wrapper_toml, flags=re.MULTILINE):
        mismatches.append("wrapper crate version must be literal MAJOR.MINOR.PATCH SemVer")

    if mismatches:
        fail("version check failed:\n" + "\n".join(f"- {item}" for item in mismatches))

    print(f"ok: canary_version {current}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("show")

    set_parser = subparsers.add_parser("set")
    set_parser.add_argument("version")

    bump_parser = subparsers.add_parser("bump")
    bump_group = bump_parser.add_mutually_exclusive_group(required=True)
    bump_group.add_argument("--major", action="store_true")
    bump_group.add_argument("--minor", action="store_true")
    bump_group.add_argument("--patch", action="store_true")

    compute_parser = subparsers.add_parser("compute")
    compute_parser.add_argument("--channel", choices=["canary", "nightly"], required=True)
    compute_parser.add_argument("--pypi", action="store_true")

    plan_parser = subparsers.add_parser("plan")
    plan_parser.add_argument("--channel", choices=["canary", "nightly"], required=True)
    plan_parser.add_argument("--out", type=Path, required=True)

    stamp_parser = subparsers.add_parser("stamp")
    stamp_parser.add_argument("--plan", type=Path, required=True)

    subparsers.add_parser("sync")
    subparsers.add_parser("check")

    args = parser.parse_args()

    if args.command == "show":
        print(load_release())
    elif args.command == "set":
        try:
            version = Version.parse(args.version)
        except ValueError as exc:
            fail(str(exc))
        write_release(version)
        sync_canary()
    elif args.command == "bump":
        version = load_release()
        if args.major:
            version = version.bump_major()
        elif args.minor:
            version = version.bump_minor()
        else:
            version = version.bump_patch()
        write_release(version)
        sync_canary()
    elif args.command == "compute":
        canonical = compute_version(args.channel)
        print(to_pypi_version(canonical) if args.pypi else canonical)
    elif args.command == "plan":
        args.out.write_text(make_plan(args.channel).to_json(), encoding="utf-8")
    elif args.command == "stamp":
        stamp(load_plan(args.plan))
    elif args.command == "sync":
        sync_canary()
    elif args.command == "check":
        check_release()


if __name__ == "__main__":
    main()
