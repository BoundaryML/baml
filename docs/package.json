{
  "name": "@baml/developer-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare:content && next build",
    "check:book": "node scripts/import-baml-book.mjs --check",
    "check:cli-reference": "node scripts/generate-cli-reference.mjs --check",
    "check:reference": "node scripts/generate-baml-reference.mjs --check",
    "check:runner-artifact": "node scripts/check-runner-artifact.mjs && node scripts/build-runner-bundle.mjs --check",
    "check:derived-policy": "node scripts/check-derived-content-policy.mjs",
    "dev": "node scripts/prepare-generated-docs.mjs --allow-unavailable && pnpm run generate:book && next dev",
    "generate:book": "node scripts/import-baml-book.mjs",
    "generate:cli-reference": "node scripts/generate-cli-reference.mjs",
    "generate:derived": "node scripts/prepare-generated-docs.mjs",
    "generate:reference": "node scripts/generate-baml-reference.mjs",
    "prepare:content": "pnpm run generate:derived && pnpm run generate:book",
    "produce:docs-metadata": "node scripts/produce-docs-metadata.mjs",
    "runner:artifact": "node scripts/build-runner-artifact.mjs",
    "runner:bundle": "node scripts/build-runner-bundle.mjs",
    "runner:browser": "node scripts/verify-runner-browser.mjs",
    "runner:measure": "node scripts/measure-wasm.mjs",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "pnpm run prepare:content && fumadocs-mdx && next typegen && tsc --noEmit",
    "verify:runner": "node scripts/verify-runnable-examples.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.25.2",
    "postcss": "^8.5.14",
    "playwright": "1.53.1",
    "smol-toml": "1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  }
}
