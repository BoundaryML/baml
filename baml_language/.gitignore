# Additional target directories that don't invalidate the main compile cache when changing linker settings,
# e.g. `CARGO_TARGET_DIR=target-maturin maturin build --release --strip` or
# `CARGO_TARGET_DIR=target-llvm-lines RUSTFLAGS="-Csymbol-mangling-version=v0" cargo llvm-lines -p ruff --lib`
/target*

# Generated test code (build.rs output written to src/ for stable insta paths)
crates/baml_tests/src/generated_tests.rs

thoughts/
rpi/

# Riptide artifacts (cloud-synced)
.humanlayer/tasks/

# insta pending snapshot scratch files (resolved by `cargo insta review`)
*.pending-snap

# Local scratch projects / fuzz repros (not part of the build)
workflow_scratch_files/

# Java/Gradle build artifacts
sdks/java/**/.gradle/
sdks/java/**/build/

# .bamlprof artifacts (profiling is default-on; BAML_PROFILE=0 opts out)
**/.baml/profiles/
_plan/
