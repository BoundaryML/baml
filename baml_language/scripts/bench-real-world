#!/usr/bin/env python3
"""Run real-world benchmarks comparing baml-cli against Python and Bun.

Each BAML workload is first compiled into a standalone packed binary via
`baml pack`, then that binary is invoked `--runs` times to time only the
runtime (VM, GC, builtins). Compile/parse cost is paid once per workload,
not once per run. For A/B comparison, the baseline's `baml pack` is used
to embed the baseline runtime into a separate packed binary.

Usage:
    ./scripts/bench-real-world                          # compare current build
    ./scripts/bench-real-world --baseline /path/to/other/baml-cli  # A/B compare
    ./scripts/bench-real-world --runs 20                # more runs for stability

Produces a markdown table with median wall-clock times and ratios.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from statistics import median, stdev

# ── Pre-assembled string fixtures for string benchmarks ──────────────────────
# Build these once in Python so the timed code is pure operation, no assembly.
# Each fixture is embedded as a string LITERAL in the generated workload, so
# the source program never spends time concatenating chunks at runtime.
#
# Short string: 27 bytes, splits into 6 tiny (~5 byte) segments.
# Exercises BexStr Inline path (≤ 54 bytes both source and segments).
_SHORT_SRC = "hello world foo bar baz qux"
_SHORT_DELIM = " "
# Medium string: ~575 bytes, splits into 8 medium (~71 byte) segments.
# Each segment exceeds the 54-byte inline threshold → uses BexStr::Slice
# (zero-copy view into the Flat parent).
_MED_CHUNK = "the quick brown fox jumps over the lazy dog and runs through the meadow"
_MED_SRC = "|".join([_MED_CHUNK] * 8)
_MED_DELIM = "|"
# Long string: ~5KB, splits into 10 long (~500 byte) segments.
# Heavy zero-copy Slice path — segments far exceed inline threshold.
_LONG_CHUNK = (
    "the quick brown fox jumps over the lazy dog and runs through the meadow "
    "while the sun sets behind the distant mountains casting long shadows "
    "across the rolling hills and the gentle breeze carries the scent of "
    "wildflowers and freshly cut grass through the warm summer air as birds "
    "sing in the trees and the world feels at peace with itself in this "
    "perfect moment of stillness and beauty that seems to stretch on forever "
    "without end or care for the troubles of yesterday or tomorrow only the "
    "present moment matters now"
)
_LONG_SRC = "###".join([_LONG_CHUNK] * 10)
_LONG_DELIM = "###"
# String with leading/trailing whitespace, for the trim benchmark. ~210 bytes
# overall, ~150 bytes of content + 30 spaces on each side. Trimmed body > 54
# bytes so the BexStr::Slice path is exercised (not just Inline).
_TRIM_SRC = (
    " " * 30
    + "the quick brown fox jumps over the lazy dog and runs through the meadow with great enthusiasm"
    + " " * 30
)


def _baml_lit(s):
    """Embed a string as a BAML string literal (C-style escapes via JSON)."""
    return json.dumps(s)


def _js_lit(s):
    return json.dumps(s)


def _py_lit(s):
    return repr(s)


# ── Workload definitions ──────────────────────────────────────────────────────

WORKLOADS = {
    "fib(32) recursive": {
        "baml": """
function fib(n: int) -> int {
  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}
function main() -> int { fib(32) }
""",
        "python": """
def fib(n):
    if n <= 1: return n
    return fib(n - 1) + fib(n - 2)
print(fib(32))
""",
        "js": "function fib(n){return n<=1?n:fib(n-1)+fib(n-2)}console.log(fib(32))",
