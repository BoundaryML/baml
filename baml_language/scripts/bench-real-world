function main() -> int {
  let keys = ["alpha","beta","gamma","delta","epsilon","zeta","eta","theta","iota","kappa","lambda","mu","nu","xi","omicron","pi","rho","sigma","tau","upsilon"];
  let m: map<string, int> = {};
  for (let i = 0; i < 200000; i += 1) {
    let k = keys[i % 20];
    let prev = m.get(k);
    if (prev != null) {
      m.set(k, prev + 1);
    } else {
      m.set(k, 1);
    };
  };
  let total = 0;
  for (let k in keys) {
    let v = m.get(k);
    if (v != null) { total += v; };
  };
  return total;
}
