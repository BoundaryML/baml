    # ── Word count: real-world string+map+hash workload ──────────────────────
    "word count 10k words": {
        "baml": """
function main() -> int {
  let text = "the quick brown fox jumps over the lazy dog and the fox runs and the dog watches and the cat meows and the bird sings and the sun shines and the wind blows and life is good and the world keeps spinning and time keeps moving forward without ever stopping for anyone to catch a breath of fresh air on a cold winter morning in the middle of nowhere ";
  let counts: map<string, int> = {};
  for (let i = 0; i < 200; i += 1) {
    let words = text.split(" ");
    for (let w in words) {
      let prev = counts.get(w);
      if (prev != null) {
        counts.set(w, prev + 1);
      } else {
        counts.set(w, 1);
      };
    };
  };
  return counts.keys().length();
}
""",
        "python": """
text = "the quick brown fox jumps over the lazy dog and the fox runs and the dog watches and the cat meows and the bird sings and the sun shines and the wind blows and life is good and the world keeps spinning and time keeps moving forward without ever stopping for anyone to catch a breath of fresh air on a cold winter morning in the middle of nowhere "
counts = {}
for i in range(200):
    for w in text.split(" "):
        counts[w] = counts.get(w, 0) + 1
print(len(counts))
""",
        "js": """
const text="the quick brown fox jumps over the lazy dog and the fox runs and the dog watches and the cat meows and the bird sings and the sun shines and the wind blows and life is good and the world keeps spinning and time keeps moving forward without ever stopping for anyone to catch a breath of fresh air on a cold winter morning in the middle of nowhere ";
const counts=new Map();
for(let i=0;i<200;i++)for(const w of text.split(" "))counts.set(w,(counts.get(w)||0)+1);
console.log(counts.size)
""",
    },
    # ── Recursive sort: quicksort exercises recursion + array allocation ─────
    "quicksort 5k": {
        "baml": """
function partition(arr: int[], lo: int, hi: int) -> int {
  let pivot = arr[hi];
  let i = lo - 1;
  for (let j = lo; j < hi; j += 1) {
    if (arr[j] <= pivot) {
      i += 1;
      let tmp = arr[i];
      arr[i] = arr[j];
      arr[j] = tmp;
    };
  };
  let tmp2 = arr[i + 1];
  arr[i + 1] = arr[hi];
  arr[hi] = tmp2;
  return i + 1;
}
function qsort(arr: int[], lo: int, hi: int) -> int {
  if (lo < hi) {
    let p = partition(arr, lo, hi);
    qsort(arr, lo, p - 1);
    qsort(arr, p + 1, hi);
  };
  return 0;
}
function main() -> int {
  let arr: int[] = [];
  for (let i = 0; i < 5000; i += 1) {
    arr.push((i * 2654435761) % 5000);
  };
  qsort(arr, 0, arr.length() - 1);
  return arr[0] + arr[4999];
}
""",
        "python": """
import sys
sys.setrecursionlimit(20000)
def partition(arr, lo, hi):
    pivot = arr[hi]
    i = lo - 1
    for j in range(lo, hi):
        if arr[j] <= pivot:
            i += 1
            arr[i], arr[j] = arr[j], arr[i]
    arr[i+1], arr[hi] = arr[hi], arr[i+1]
    return i + 1
def qsort(arr, lo, hi):
    if lo < hi:
        p = partition(arr, lo, hi)
        qsort(arr, lo, p - 1)
        qsort(arr, p + 1, hi)
arr = [(i * 2654435761) % 5000 for i in range(5000)]
qsort(arr, 0, len(arr) - 1)
print(arr[0] + arr[4999])
""",
        "js": """
function partition(a,lo,hi){const p=a[hi];let i=lo-1;for(let j=lo;j<hi;j++)if(a[j]<=p){i++;const t=a[i];a[i]=a[j];a[j]=t}const t=a[i+1];a[i+1]=a[hi];a[hi]=t;return i+1}
function qsort(a,lo,hi){if(lo<hi){const p=partition(a,lo,hi);qsort(a,lo,p-1);qsort(a,p+1,hi)}}
const arr=[];for(let i=0;i<5000;i++)arr.push((i*2654435761)%5000);
qsort(arr,0,arr.length-1);console.log(arr[0]+arr[4999])
""",
    },
    # ── String reverse via char_at + concat: stresses substring path ─────────
    "string reverse 280 chars x100": {
        "baml": """
function reverse(s: string) -> string {
  let result = "";
  let i = s.length() - 1;
  while (i >= 0) {
    result = result + s.char_at(i);
    i -= 1;
  };
  return result;
}
function main() -> int {
  let s = "the quick brown fox jumps over the lazy dog and the fox runs and the dog watches and the cat meows and the bird sings and the sun shines and the wind blows and life is good and the world keeps spinning and time keeps moving forward without ever stopping";
  let total = 0;
  for (let i = 0; i < 100; i += 1) {
    let r = reverse(s);
    total += r.length();
  };
  return total;
}
""",
        "python": """
def reverse(s):
    result = ""
    i = len(s) - 1
    while i >= 0:
        result = result + s[i]
        i -= 1
    return result
s = "the quick brown fox jumps over the lazy dog and the fox runs and the dog watches and the cat meows and the bird sings and the sun shines and the wind blows and life is good and the world keeps spinning and time keeps moving forward without ever stopping"
total = 0
for i in range(100):
    r = reverse(s)
    total += len(r)
print(total)
""",
        "js": """
function reverse(s){let r="";for(let i=s.length-1;i>=0;i--)r+=s[i];return r}
const s="the quick brown fox jumps over the lazy dog and the fox runs and the dog watches and the cat meows and the bird sings and the sun shines and the wind blows and life is good and the world keeps spinning and time keeps moving forward without ever stopping";
let t=0;for(let i=0;i<100;i++){const r=reverse(s);t+=r.length}console.log(t)
""",
    },
    # ── Array sum-of-squares: tight numeric loop with array reads ────────────
    "array sum of squares 1M": {
        "baml": """
function main() -> int {
  let arr: int[] = [];
  for (let i = 0; i < 1000; i += 1) { arr.push(i); };
  let total = 0;
  for (let k = 0; k < 1000; k += 1) {
    for (let x in arr) {
      total += x * x;
    };
  };
  return total;
}
""",
        "python": """
arr = list(range(1000))
total = 0
for k in range(1000):
    for x in arr:
        total += x * x
print(total)
""",
        "js": """
const arr=[];for(let i=0;i<1000;i++)arr.push(i);
let t=0;for(let k=0;k<1000;k++)for(const x of arr)t+=x*x;console.log(t)
""",
    },
    # ── Linked list ops: pointer chasing + object allocation ─────────────────
    "linked list build+sum 50k": {
        "baml": """
class Node {
  value: int
  next: Node?
}
function main() -> int {
  let head: Node? = null;
  for (let i = 0; i < 50000; i += 1) {
    head = Node { value: i, next: head };
  };
  let s = 0;
  let cur = head;
  while (cur != null) {
    s += cur.value;
    cur = cur.next;
  };
  return s;
}
""",
        "python": """
import sys
sys.setrecursionlimit(60000)
class Node:
    __slots__ = ('value', 'next')
    def __init__(self, value, nxt):
        self.value = value
        self.next = nxt
head = None
for i in range(50000):
    head = Node(i, head)
s = 0
cur = head
while cur is not None:
    s += cur.value
    cur = cur.next
print(s)
""",
        "js": """
class Node{constructor(v,n){this.value=v;this.next=n}}
let head=null;for(let i=0;i<50000;i++)head=new Node(i,head);
let s=0,cur=head;while(cur!==null){s+=cur.value;cur=cur.next}console.log(s)
""",
    },
}


def generate_chain_baml():
    lines = []
    for i in range(99):
        lines.append(f"function f{i}(n: int) -> int {{ f{i+1}(n + 1) }}")
    lines.append("function f99(n: int) -> int { n }")
    lines.append("""
function main() -> int {
  let s = 0;
  for (let i = 0; i < 10000; i += 1) { s += f0(0); };
  return s;
}""")
    return "\n".join(lines)


def generate_chain_python():
    lines = []
    for i in range(99):
        lines.append(f"def f{i}(n): return f{i+1}(n + 1)")
    lines.append("def f99(n): return n")
    lines.append("s = 0")
    lines.append("for _ in range(10000): s += f0(0)")
    lines.append("print(s)")
    return "\n".join(lines)


def generate_chain_js():
    lines = []
    for i in range(99):
        lines.append(f"function f{i}(n){{return f{i+1}(n+1)}}")
    lines.append("function f99(n){return n}")
    lines.append("let s=0;for(let i=0;i<10000;i++)s+=f0(0);console.log(s);")
    return "\n".join(lines)


# ── Runner ────────────────────────────────────────────────────────────────────

def time_command(cmd, runs=10):
    """Run a command multiple times, return list of wall-clock seconds."""
    times = []
    for i in range(runs):
        start = time.perf_counter()
        result = subprocess.run(cmd, capture_output=True, text=True, shell=isinstance(cmd, str))
        elapsed = time.perf_counter() - start
        if result.returncode != 0:
            if i == 0:
                # Print error on first failure only
                stderr = result.stderr.strip()
                # Strip ANSI codes
                import re
                stderr = re.sub(r'\x1b\[[0-9;]*m', '', stderr)
                lines = stderr.split('\n')
                err_lines = [l for l in lines if 'error' in l.lower() or 'traceback' in l.lower()]
                if err_lines:
                    sys.stderr.write(f" ERROR: {err_lines[0][:80]}\n")
            return None
        times.append(elapsed)
    return times


def fmt_ms(seconds, cov=None):
    """Format seconds as ms string. If cov (coefficient of variation 0-1) given, append (±X%)."""
    if seconds is None:
        return "—"
    ms = seconds * 1000
    if ms >= 1000:
        base = f"{ms:.0f}ms"
    elif ms >= 100:
        base = f"{ms:.0f}ms"
    elif ms >= 10:
        base = f"{ms:.1f}ms"
    else:
        base = f"{ms:.2f}ms"
    if cov is not None:
        base += f" ±{cov*100:.0f}%"
    return base


def fmt_ratio(a, b):
    """Format ratio a/b as string."""
    if b == 0:
        return "—"
    r = a / b
    if r >= 10:
        return f"{r:.0f}x"
    elif r >= 1:
        return f"{r:.1f}x"
    else:
        return f"{r:.2f}x"


def main():
    parser = argparse.ArgumentParser(description="Real-world BAML benchmarks")
    parser.add_argument("--baseline", help="Path to baseline baml-cli binary for A/B comparison")
    parser.add_argument("--runs", type=int, default=10, help="Number of runs per benchmark (default: 10)")
    parser.add_argument("--baml", default=None, help="Path to baml-cli (default: target/release/baml-cli)")
    parser.add_argument("--only-baml", action="store_true", help="Only run baml benchmarks, skip python/node/bun comparisons")
    parser.add_argument("--only", action="append", default=[], help="Run only workloads whose name contains this substring (case-insensitive, repeatable). e.g. --only concat --only split")
    parser.add_argument("--list", action="store_true", help="List all workload names and exit")
    parser.add_argument("--profile", action="store_true", help="Capture samply profiles of BAML execution (current + baseline if --baseline given). Writes one .json profile per workload to --profile-dir. Requires samply on PATH and profiling-mode binaries.")
    parser.add_argument("--profile-dir", default="./bench-profiles", help="Directory (in pwd) to write profile .json files. Default: ./bench-profiles")
    parser.add_argument("--profile-baml", default=None, help="Path to baml-cli built with --profile profiling (LTO + debug symbols). Default: derive from --baml path by replacing /release/ → /profiling/")
    parser.add_argument("--profile-baseline", default=None, help="Path to baseline baml-cli built with --profile profiling. Default: derive from --baseline path the same way")
    args = parser.parse_args()

    # Find binaries
    script_dir = Path(__file__).parent
    repo_root = script_dir.parent

    baml_cli = args.baml or str(repo_root / "target" / "release" / "baml-cli")
    if not os.path.isfile(baml_cli):
        print(f"ERROR: baml-cli not found at {baml_cli}")
        print("Run: cargo build --release --bin baml-cli")
        sys.exit(1)

    if args.only_baml:
        has_python = has_bun = has_node = False
    else:
        has_python = subprocess.run(["python3", "--version"], capture_output=True).returncode == 0
        has_bun = subprocess.run(["bun", "--version"], capture_output=True).returncode == 0
        has_node = subprocess.run(["node", "--version"], capture_output=True).returncode == 0
    has_baseline = args.baseline and os.path.isfile(args.baseline)

    runs = args.runs

    # Handle --list: just print workload names and exit
    if args.list:
        for n in WORKLOADS:
            print(n)
        sys.exit(0)

    # Filter workloads by --only substring matches (case-insensitive)
    if args.only:
        filters = [f.lower() for f in args.only]
        filtered = {n: w for n, w in WORKLOADS.items() if any(f in n.lower() for f in filters)}
        if not filtered:
            print(f"ERROR: no workloads match --only filters: {args.only}", file=sys.stderr)
            print(f"Available workloads (use --list to see all):", file=sys.stderr)
            for n in WORKLOADS:
                print(f"  - {n}", file=sys.stderr)
            sys.exit(1)
        workloads_to_run = filtered
        print(f"# Running {len(filtered)} of {len(WORKLOADS)} workloads matching {args.only}", file=sys.stderr)
    else:
        workloads_to_run = WORKLOADS

    # ── Set up profiling (--profile) ─────────────────────────────────────────
    profile_dir = None
    profile_baml_bin = None
    profile_base_bin = None
    if args.profile:
        # Verify samply is installed
        if subprocess.run(["which", "samply"], capture_output=True).returncode != 0:
            print("ERROR: --profile requires `samply` on PATH. Install with: cargo install samply", file=sys.stderr)
            sys.exit(1)

        # Resolve profiling-mode binaries
        def derive_profiling_path(release_path):
            # Replace /release/ → /profiling/ in any segment of the path
            return release_path.replace("/release/", "/profiling/")

        profile_baml_bin = args.profile_baml or derive_profiling_path(baml_cli)
        if not os.path.isfile(profile_baml_bin):
            print(f"ERROR: --profile baml binary not found at {profile_baml_bin}", file=sys.stderr)
            print("Build with: cargo build --profile profiling --bin baml-cli", file=sys.stderr)
            sys.exit(1)

        if has_baseline:
            profile_base_bin = args.profile_baseline or derive_profiling_path(args.baseline)
            if not os.path.isfile(profile_base_bin):
                print(f"WARNING: --profile baseline binary not found at {profile_base_bin} — skipping baseline profile", file=sys.stderr)
                profile_base_bin = None

        # Create profile output directory in pwd
        profile_dir = os.path.abspath(args.profile_dir)
        os.makedirs(profile_dir, exist_ok=True)
        print(f"# Profiles will be written to: {profile_dir}", file=sys.stderr)
        print(f"#   current baml-cli (profiling): {profile_baml_bin}", file=sys.stderr)
        if profile_base_bin:
            print(f"#   baseline baml-cli (profiling): {profile_base_bin}", file=sys.stderr)

    # Create temp files
    tmpdir = tempfile.mkdtemp(prefix="baml_bench_")

    results = {}

    for name, workload in workloads_to_run.items():
        baml_src = workload["baml"]
        py_src = workload["python"]
        js_src = workload["js"]

        # Handle chain generation
        if baml_src == "GENERATE_CHAIN":
            baml_src = generate_chain_baml()
            py_src = generate_chain_python()
            js_src = generate_chain_js()

        # Write temp files
        baml_file = os.path.join(tmpdir, f"{name.replace(' ', '_')}.baml")
        py_file = os.path.join(tmpdir, f"{name.replace(' ', '_')}.py")
        js_file = os.path.join(tmpdir, f"{name.replace(' ', '_')}.js")

        with open(baml_file, "w") as f:
            f.write(baml_src)
        with open(py_file, "w") as f:
            f.write(py_src)
        with open(js_file, "w") as f:
            f.write(js_src)

        row = {"name": name}
        total = len(workloads_to_run)
        idx = list(workloads_to_run.keys()).index(name) + 1
        is_tty = sys.stderr.isatty()

        if is_tty:
            sys.stderr.write(f"\n[{idx}/{total}] {name}\n")
            sys.stderr.flush()

        # ── Verify outputs match before timing ──
        def get_output(cmd):
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                return None
            return r.stdout.strip().split("\n")[-1].strip()

        expected = get_output([baml_cli, "run", "--file", baml_file, "-f", "main", "--", "main"])
        if expected is None:
            if is_tty:
                sys.stderr.write(f"       SKIP (baml failed to run)\n")
            continue

        mismatches = []
        checks = []
        if has_baseline:
            checks.append(("baseline", [args.baseline, "run", "--file", baml_file, "-f", "main", "--", "main"]))
        if has_python:
            checks.append(("python3", ["python3", "-S", py_file]))
        if has_node:
            checks.append(("node", ["node", js_file]))
        if has_bun:
            checks.append(("bun", ["bun", js_file]))

        for lang, cmd in checks:
            out = get_output(cmd)
            if out is not None and out != expected:
                mismatches.append((lang, out))

        if mismatches:
            if is_tty:
                sys.stderr.write(f"       MISMATCH: baml={expected}")
                for lang, out in mismatches:
                    sys.stderr.write(f", {lang}={out}")
                sys.stderr.write("\n")
            # Still run the benchmark but flag it
            row["mismatch"] = True

        def run_one(label, cmd):
            if is_tty:
                sys.stderr.write(f"       {label:>10s}: ")
                sys.stderr.flush()
            t = time_command(cmd, runs=runs)
            if t:
                med = median(t)
                # Trimmed stdev — drop top 20% (outliers from GC, system jitter, etc.)
                # This gives a more honest noise-floor estimate for benchmarks.
                t_sorted = sorted(t)
                keep = max(2, int(len(t_sorted) * 0.8))
                trimmed = t_sorted[:keep]
                sd = stdev(trimmed) if len(trimmed) > 1 else 0.0
                cov = sd / med if med > 0 else 0.0
                if is_tty:
                    sys.stderr.write(f"{fmt_ms(med):>8s} ±{cov*100:.1f}% (min={fmt_ms(min(t))}, max={fmt_ms(max(t))})\n")
                return (med, cov)
            else:
                if is_tty:
                    sys.stderr.write("FAIL\n")
                return None

        row["baml"] = run_one("baml", [baml_cli, "run", "--file", baml_file, "-f", "main", "--", "main"])

        # Pack the workload into a standalone binary and time that (pure-exec).
        # `baml pack` is the production deployment path — no compile cost per run.
        packed_bin = os.path.join(tmpdir, f"{name.replace(' ', '_').replace('(', '').replace(')', '').replace(',', '').replace(':', '')}.bin")
        pack_result = subprocess.run(
            [baml_cli, "pack", "--file", baml_file, "-o", packed_bin, "main"],
            capture_output=True, text=True,
        )
        if pack_result.returncode == 0 and os.path.isfile(packed_bin):
            row["baml_pack"] = run_one("pack", [packed_bin])
        else:
            if is_tty:
                sys.stderr.write(f"       pack: FAILED to build packed binary\n")

        if has_baseline:
            row["baseline"] = run_one("baseline", [args.baseline, "run", "--file", baml_file, "-f", "main", "--", "main"])
            # Also pack with baseline if pack-host is available next to it
            packed_base = packed_bin + ".baseline"
            pack_base = subprocess.run(
                [args.baseline, "pack", "--file", baml_file, "-o", packed_base, "main"],
                capture_output=True, text=True,
            )
            if pack_base.returncode == 0 and os.path.isfile(packed_base):
                row["baseline_pack"] = run_one("base_pack", [packed_base])

        if has_python:
            row["python"] = run_one("python3", ["python3", "-S", py_file])

        if has_node:
            row["node"] = run_one("node", ["node", js_file])

        if has_bun:
            row["bun"] = run_one("bun", ["bun", js_file])

        # ── Capture samply profiles (if --profile) ───────────────────────────
        if args.profile and profile_baml_bin:
            slug = name.replace(" ", "_").replace("(", "").replace(")", "").replace(",", "").replace(":", "").replace("+", "plus").replace("/", "_")

            curr_profile = os.path.join(profile_dir, f"{slug}.current.json")
            if is_tty:
                sys.stderr.write(f"       profile-curr: ")
                sys.stderr.flush()
            r = subprocess.run(
                ["samply", "record", "--save-only", "-o", curr_profile,
                 profile_baml_bin, "run", "--file", baml_file, "-f", "main", "--", "main"],
                capture_output=True, text=True,
            )
            if r.returncode == 0 and os.path.isfile(curr_profile):
                row["profile_current"] = curr_profile
                if is_tty:
                    sys.stderr.write(f"{os.path.relpath(curr_profile)}\n")
            else:
                if is_tty:
                    sys.stderr.write("FAIL\n")

            if profile_base_bin:
                base_profile = os.path.join(profile_dir, f"{slug}.baseline.json")
                if is_tty:
                    sys.stderr.write(f"       profile-base: ")
                    sys.stderr.flush()
                r = subprocess.run(
                    ["samply", "record", "--save-only", "-o", base_profile,
                     profile_base_bin, "run", "--file", baml_file, "-f", "main", "--", "main"],
                    capture_output=True, text=True,
                )
                if r.returncode == 0 and os.path.isfile(base_profile):
                    row["profile_baseline"] = base_profile
                    if is_tty:
                        sys.stderr.write(f"{os.path.relpath(base_profile)}\n")
                else:
                    if is_tty:
                        sys.stderr.write("FAIL\n")

        results[name] = row

    # ── Print results ─────────────────────────────────────────────────────────

    print()

    # Build header
    cols = ["Benchmark", "baml", "baml_pack"]
    if has_baseline:
        cols.append("baseline")
        cols.append("base_pack")
        cols.append("pack speedup")
    if has_python:
        cols.append("python3")
        cols.append("pack/py")
    if has_node:
        cols.append("node")
        cols.append("pack/node")
    if has_bun:
        cols.append("bun")
        cols.append("pack/bun")

    # Header
    print("| " + " | ".join(f"{c:>20s}" for c in cols) + " |")
    print("| " + " | ".join("-" * 20 for _ in cols) + " |")

    # Helper to unpack (median, cov) tuple safely
    def unpack(v):
        if v is None: return (None, None)
        return v if isinstance(v, tuple) else (v, None)

    # Significance helper: difference is significant if outside combined noise band
    def sig_marker(curr_med, curr_cov, base_med, base_cov):
        """Return ' *' if pack speedup is outside the ±2σ combined-noise band, else ''."""
        if not (curr_med and base_med and curr_cov is not None and base_cov is not None):
            return ""
        ratio = base_med / curr_med
        # Combined 2σ noise band ≈ 2 * sqrt(cov_curr^2 + cov_base^2)
        noise = 2.0 * ((curr_cov ** 2 + base_cov ** 2) ** 0.5)
        deviation = abs(ratio - 1.0)
        return " *" if deviation > noise else ""

    for name in workloads_to_run:
        row = results.get(name)
        if not row:
            continue

        flag = " (!)" if row.get("mismatch") else ""
        cells = [f"{name + flag:>20s}"]

        baml_ms, baml_cov = unpack(row.get("baml"))
        cells.append(f"{fmt_ms(baml_ms, baml_cov):>22s}" if baml_ms else f"{'FAIL':>22s}")

        pack_ms, pack_cov = unpack(row.get("baml_pack"))
        cells.append(f"{fmt_ms(pack_ms, pack_cov):>22s}" if pack_ms else f"{'—':>22s}")

        if has_baseline:
            base_ms, base_cov = unpack(row.get("baseline"))
            cells.append(f"{fmt_ms(base_ms, base_cov):>22s}" if base_ms else f"{'FAIL':>22s}")
            base_pack_ms, base_pack_cov = unpack(row.get("baseline_pack"))
            cells.append(f"{fmt_ms(base_pack_ms, base_pack_cov):>22s}" if base_pack_ms else f"{'—':>22s}")
            # Pack-vs-pack speedup — mark ' *' if significant beyond noise
            if pack_ms and base_pack_ms:
                marker = sig_marker(pack_ms, pack_cov, base_pack_ms, base_pack_cov)
                cells.append(f"{fmt_ratio(base_pack_ms, pack_ms) + marker:>14s}")
            else:
                cells.append(f"{'—':>14s}")

        if has_python:
            py_ms, _ = unpack(row.get("python"))
            cells.append(f"{fmt_ms(py_ms):>14s}" if py_ms else f"{'—':>14s}")
            if pack_ms and py_ms:
                cells.append(f"{fmt_ratio(pack_ms, py_ms):>12s}")
            else:
                cells.append(f"{'—':>12s}")

        if has_node:
            node_ms, _ = unpack(row.get("node"))
            cells.append(f"{fmt_ms(node_ms):>14s}" if node_ms else f"{'—':>14s}")
            if pack_ms and node_ms:
                cells.append(f"{fmt_ratio(pack_ms, node_ms):>12s}")
            else:
                cells.append(f"{'—':>12s}")

        if has_bun:
            bun_ms, _ = unpack(row.get("bun"))
            cells.append(f"{fmt_ms(bun_ms):>14s}" if bun_ms else f"{'—':>14s}")
            if pack_ms and bun_ms:
                cells.append(f"{fmt_ratio(pack_ms, bun_ms):>12s}")
            else:
                cells.append(f"{'—':>12s}")

        print("| " + " | ".join(cells) + " |")

    print()

    # ── Profile summary (if --profile was given) ─────────────────────────────
    if args.profile and profile_dir:
        print()
        print(f"Profiles written to {profile_dir}/")
        any_profiles = False
        for name in workloads_to_run:
            row = results.get(name, {})
            cp = row.get("profile_current")
            bp = row.get("profile_baseline")
            if cp or bp:
                any_profiles = True
                print(f"  [{name}]")
                if cp:
                    print(f"      current:  {os.path.relpath(cp)}")
                if bp:
                    print(f"      baseline: {os.path.relpath(bp)}")
        if any_profiles:
            print()
            print("To inspect a profile in the Firefox profiler UI:")
            print(f"  samply load {profile_dir}/<name>.current.json")

    # Cleanup
    import shutil
    shutil.rmtree(tmpdir, ignore_errors=True)


if __name__ == "__main__":
    main()
