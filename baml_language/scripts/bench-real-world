#!/usr/bin/env python3
"""Run real-world benchmarks comparing baml-cli against Python and Bun.

Usage:
    ./scripts/bench-real-world                          # compare current build
    ./scripts/bench-real-world --baseline /path/to/other/baml-cli  # A/B compare
    ./scripts/bench-real-world --runs 20                # more runs for stability

Produces a markdown table with median wall-clock times and ratios.
"""

import argparse
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from statistics import median

# ── Workload definitions ──────────────────────────────────────────────────────

WORKLOADS = {
    "fib(32) recursive": {
        "baml": """
function fib(n: int) -> int {
  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}
function main() -> int { fib(32) }
""",
        "python": """
def fib(n):
    if n <= 1: return n
    return fib(n - 1) + fib(n - 2)
print(fib(32))
""",
        "js": "function fib(n){return n<=1?n:fib(n-1)+fib(n-2)}console.log(fib(32))",
    },
    "fib iterative 100k": {
        "baml": """
function fib(n: int) -> int {
  let a = 0;
  let b = 1;
  for (let i = 0; i < n; i += 1) {
    let tmp = b;
    b = a + b;
    a = tmp;
  };
  return a;
}
function main() -> int {
  let s = 0;
  for (let i = 0; i < 100000; i += 1) { s += fib(50); };
  return s;
}
""",
        "python": """
def fib(n):
    a, b = 0, 1
    for _ in range(n): a, b = b, a + b
    return a
s = 0
for i in range(100000): s += fib(50)
print(s)
""",
        "js": """
function fib(n){let a=0,b=1;for(let i=0;i<n;i++){let t=b;b=a+b;a=t}return a}
let s=0;for(let i=0;i<100000;i++)s+=fib(50);console.log(s)
""",
    },
