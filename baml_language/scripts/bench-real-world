        else: x = 3 * x + 1
        steps += 1
    return steps
s = 0
for i in range(1, 100000): s += collatz_steps(i)
print(s)
""",
        "js": """
function collatz(n){let s=0,x=n;while(x!==1){x=x%2===0?x/2:3*x+1;s++}return s}
let s=0;for(let i=1;i<100000;i++)s+=collatz(i);console.log(s)
