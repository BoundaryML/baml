    for (let j = 0; j < arr.length() - i - 1; j += 1) {
      if arr[j] > arr[j + 1] {
        let tmp = arr[j];
        arr[j] = arr[j + 1];
        arr[j + 1] = tmp;
      };
    };
  };
  return arr[0] + arr[4999];
}
""",
        "python": """
