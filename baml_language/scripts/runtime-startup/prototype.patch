--- a/baml_language/crates/baml_exec/src/lib.rs
+++ b/baml_language/crates/baml_exec/src/lib.rs
@@ -40,3 +40,40 @@ pub use dispatch::{
 pub use envelope::{PACK_SECTION_NAME, PackEnvelope, PackMode, TargetEntry};
 pub use json_coerce::load_json_source;
 pub use output::{OutputFormat, format_value, write_output, write_output_with_context};
+
+/// Measurement-only prototype of an execution-ready artifact. Not a supported
+/// artifact format: loading serialized compact code still needs a verifier,
+/// and original disassembly metadata needs a separate deferred section.
+#[cfg(feature = "startup-experiment")]
+pub fn prepare_startup_experiment(program: &mut bex_vm_types::Program) {
+    use bex_vm_types::{ConstValue, Object, ObjectIndex};
+    program.validate().expect("compiler-produced program");
+    let floats =
+        bex_vm_types::types::box_compile_time_floats(&mut program.objects, &program.globals);
+    for global in &mut program.globals {
+        if let ConstValue::Float(value) = global {
+            *global = ConstValue::Object(ObjectIndex::from_raw(floats[&value.to_bits()]));
+        }
+    }
+    bex_vm::prepare_compact_code(&mut program.objects, &program.globals);
+    for object in &mut program.objects {
+        if let Object::Function(function) = object {
+            function
+                .bytecode
+                .compact
+                .as_mut()
+                .unwrap()
+                .defer_source_map();
+            // The executable image carries final PCs and code, so these
+            // compiler representations are unnecessary for this measurement.
+            function.bytecode.instructions.clear();
+            function.bytecode.meta.clear();
+            function.bytecode.line_table.clear();
+            function.bytecode.call_layouts.clear();
+            function.bytecode.jump_tables.clear();
+            function.bytecode.exception_table.clear();
+            function.bytecode.handler_context_table.clear();
+            function.bytecode.shield_table.clear();
+        }
+    }
+}
