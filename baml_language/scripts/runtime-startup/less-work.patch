+/// Diagnostic experiment: passing a registry to coercion does not initialize
+/// it. Primitive coercions never look up a class or recursive alias.
+trait WireLookup<T> {
+    fn get(&self, name: &baml_type::TypeName) -> Option<&T>;
+    fn len(&self) -> usize;
+}
+
+impl<T> WireLookup<T> for indexmap::IndexMap<baml_type::TypeName, T> {
+    fn get(&self, name: &baml_type::TypeName) -> Option<&T> {
+        indexmap::IndexMap::get(self, name)
+    }
+    fn len(&self) -> usize { indexmap::IndexMap::len(self) }
+}
+
+struct DeferredInboundDefinitions<'a> {
+    views: &'a std::sync::OnceLock<(
+        indexmap::IndexMap<baml_type::TypeName, RuntimeTy>,
+        indexmap::IndexMap<baml_type::TypeName, WireClassDefinition>,
+    )>,
+    aliases: &'a std::sync::OnceLock<indexmap::IndexMap<baml_type::TypeName, RuntimeTy>>,
+    context: &'a sys_types::EngineSysOpContext,
+}
+
+impl DeferredInboundDefinitions<'_> {
+    fn aliases(&self) -> &indexmap::IndexMap<baml_type::TypeName, RuntimeTy> {
+        if let Some(views) = self.views.get() { return &views.0; }
+        self.aliases.get_or_init(|| wire_definition_views(
+            self.context.type_alias_definitions.as_ref(),
+            &indexmap::IndexMap::new(),
+        ).0)
+    }
+    fn views(&self) -> &(
+        indexmap::IndexMap<baml_type::TypeName, RuntimeTy>,
+        indexmap::IndexMap<baml_type::TypeName, WireClassDefinition>,
+    ) {
+        self.views.get_or_init(|| wire_definition_views(
+            self.context.type_alias_definitions.as_ref(),
+            self.context.class_definitions.as_ref(),
+        ))
+    }
+}
+
+impl WireLookup<RuntimeTy> for DeferredInboundDefinitions<'_> {
+    fn get(&self, name: &baml_type::TypeName) -> Option<&RuntimeTy> {
+        self.aliases().get(name)
+    }
+    fn len(&self) -> usize { self.aliases().len() }
+}
+
+impl WireLookup<WireClassDefinition> for DeferredInboundDefinitions<'_> {
+    fn get(&self, name: &baml_type::TypeName) -> Option<&WireClassDefinition> {
+        self.views().1.get(name)
+    }
+    fn len(&self) -> usize { self.views().1.len() }
+}
