+/// Diagnostic experiment: defer owned schema views without deferring shutdown.
+pub struct Deferred<T>(Arc<std::sync::LazyLock<T, Box<dyn FnOnce() -> T + Send + Sync>>>);
+impl<T> Deferred<T> {
+    pub fn new(build: impl FnOnce() -> T + Send + Sync + 'static) -> Self {
+        Self(Arc::new(std::sync::LazyLock::new(Box::new(build))))
+    }
+    pub fn as_ref(&self) -> &T { &self.0 }
+}
+impl<T> Clone for Deferred<T> {
+    fn clone(&self) -> Self { Self(Arc::clone(&self.0)) }
+}
+impl<T> std::ops::Deref for Deferred<T> {
+    type Target=T;
+    fn deref(&self) -> &T { self.as_ref() }
+}
+impl<T: Send + Sync + 'static> From<Arc<T>> for Deferred<T> {
+    fn from(value: Arc<T>) -> Self {
+        Self::new(move || Arc::try_unwrap(value).unwrap_or_else(|_| panic!("diagnostic eager schema must have one owner")))
+    }
+}
