@@ -0,0 +1,19 @@
+//! Temporary diagnostic instrumentation; not a supported runtime API.
+use std::sync::{OnceLock, atomic::{AtomicU64, Ordering}};
+use std::time::Instant;
+const LABELS: [&str; 32] = ["engine_start", "engine_configuration", "program_validated", "callables_rendered", "builtins_attached", "compact_prepared", "functions_indexed", "program_converted", "objects_extracted", "floats_boxed", "engine_compact_prepared", "nominal_indices", "package_slots_reserved", "constants_resolved", "unsealed_heap_built", "packages_filled", "type_heads_bound", "switch_tables_verified", "functions_registered", "heap_built", "dispatch_tables", "name_maps", "globals", "telemetry_started", "package_initializers", "llm_definitions", "class_definitions", "enum_definitions", "permits", "runtime_io", "alias_definitions", "inbound_views"];
+static STAMPS: [AtomicU64; 32] = [const { AtomicU64::new(0) }; 32];
+static ORIGIN: OnceLock<Instant> = OnceLock::new();
+static ENABLED: OnceLock<bool> = OnceLock::new();
+pub fn mark(id: usize) {
+    if !*ENABLED.get_or_init(|| std::env::var_os("BAML_PROFILE_LOADING").is_some()) { return; }
+    STAMPS[id].store(ORIGIN.get_or_init(Instant::now).elapsed().as_nanos() as u64 + 1, Ordering::Relaxed);
+}
+pub fn emit() {
+    if !*ENABLED.get_or_init(|| false) { return; }
+    let values = STAMPS.iter().enumerate().filter_map(|(i,t)| {
+        let n=t.load(Ordering::Relaxed);
+        (n!=0).then(|| format!("\"{}\":{}", LABELS[i], n-1))
+    }).collect::<Vec<_>>();
+    eprintln!("BAML_LOADING_PROFILE:{{{}}}", values.join(","));
+}
