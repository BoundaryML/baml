<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add
      key="csharp-entry-evidence"
      value="%BAML_NATIVE_PROBE_FEED%" />
    <add
      key="nuget.org"
      value="https://api.nuget.org/v3/index.json"
      protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="csharp-entry-evidence">
      <package pattern="Baml.Bridge.MultiRidPackageProbe" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Google.*" />
      <package pattern="Grpc.*" />
      <package pattern="Microsoft.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
