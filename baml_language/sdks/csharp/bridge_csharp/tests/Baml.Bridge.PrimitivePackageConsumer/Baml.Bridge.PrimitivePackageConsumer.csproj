<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>Baml.CSharp.PrimitivePackageConsumer</AssemblyName>
    <BamlBridgePackageVersion
      Condition="'$(BamlBridgePackageVersion)' == ''">0.15.0</BamlBridgePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="baml-bridge"
      Version="[$(BamlBridgePackageVersion)]" />
  </ItemGroup>
</Project>
