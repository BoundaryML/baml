<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>Baml.Bridge.DocumentationConsumer</AssemblyName>
    <BamlBridgePackageVersion
      Condition="'$(BamlBridgePackageVersion)' == ''">0.15.0</BamlBridgePackageVersion>
    <BamlGeneratedSourceRoot
      Condition="'$(BamlGeneratedSourceRoot)' == ''">../../../../../sdk_tests/crates/csharp/primitive_slice/baml_client</BamlGeneratedSourceRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(BamlBridgeProjectReference)' != ''">
    <ProjectReference Include="$(BamlBridgeProjectReference)" />
  </ItemGroup>
  <ItemGroup Condition="'$(BamlBridgeProjectReference)' == ''">
    <PackageReference
      Include="baml-bridge"
      Version="[$(BamlBridgePackageVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="$(BamlGeneratedSourceRoot)/**/*.g.cs" />
    <Compile
      Include="$(BamlGeneratedSourceRoot)/**/*.g.cs"
      Link="baml_client/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
