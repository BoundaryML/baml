<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(BamlGeneratedProgramSource)' != ''">
    <Compile Include="$(BamlGeneratedProgramSource)" Link="BamlProgram.g.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(BamlNativeLibraryPath)' != ''">
    <None
      Include="$(BamlNativeLibraryPath)"
      Link="libbridge_cffi.so"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      ExcludeFromSingleFile="$(BamlNativeSidecar)" />
  </ItemGroup>
  <Target Name="RequireGeneratedProgramSource" BeforeTargets="CoreCompile">
    <Error
      Condition="'$(BamlGeneratedProgramSource)' == ''"
      Text="BamlGeneratedProgramSource must name the generated BamlProgram.g.cs evidence file." />
    <Error
      Condition="!Exists('$(BamlGeneratedProgramSource)')"
      Text="BamlGeneratedProgramSource does not exist: $(BamlGeneratedProgramSource)" />
  </Target>
  <Import Project="../Baml.NativeProbeMode.targets" />
</Project>
