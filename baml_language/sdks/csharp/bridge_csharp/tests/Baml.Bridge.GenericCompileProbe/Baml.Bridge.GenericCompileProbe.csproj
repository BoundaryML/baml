<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../Baml.Bridge.ManagedContractProbe/Baml.Bridge.ManagedContractProbe.csproj" />
    <Compile Include="GeneratedApi.cs" />
    <Compile
      Include="Positive.cs"
      Condition="'$(BamlNegativeCase)' == ''" />
    <Compile
      Include="$(BamlNegativeCase).cs"
      Condition="'$(BamlNegativeCase)' != ''" />
  </ItemGroup>
  <PropertyGroup
    Condition="'$(BamlNegativeCase)' == 'NegativeRawOptionalInference'
      Or '$(BamlNegativeCase)' == 'NegativeRawNullableInference'
      Or '$(BamlNegativeCase)' == 'NegativeComposedRaw'
      Or '$(BamlNegativeCase)' == 'NegativeBareNullInference'
      Or '$(BamlNegativeCase)' == 'NegativeResultOnlyInference'
      Or '$(BamlNegativeCase)' == 'NegativeNonNullableNull'
      Or '$(BamlNegativeCase)' == 'NegativeUnionRawInference'">
    <BamlNegativeCaseIsKnown>true</BamlNegativeCaseIsKnown>
  </PropertyGroup>
  <Target
    Name="ValidateBamlNegativeCase"
    BeforeTargets="CoreCompile">
    <Error
      Code="BAMLGEN001"
      Condition="'$(BamlNegativeCase)' != ''
        And '$(BamlNegativeCaseIsKnown)' != 'true'"
      Text="Unknown BamlNegativeCase '$(BamlNegativeCase)'." />
  </Target>
</Project>
