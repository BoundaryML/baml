from typing import TypedDict

from .vendor import trace
from .baml.spawn import CancelToken


class BamlOptions(TypedDict, total=False):
    trace: trace.Options | trace.ReservedSpan | None
    cancel: CancelToken | None
    timeout_ms: int | None

from typing import Any, Generic, Protocol, TypeVar
from baml_bridge import BamlStream as _BridgeStream, BamlFunctionSpec as _BridgeSpec

_N = TypeVar("_N")
_Y = TypeVar("_Y")
_F = TypeVar("_F")
_O = TypeVar("_O")


class BamlStream(_BridgeStream[_N, _Y, _F], Generic[_N, _Y, _F]):
    def next(self, *, _baml: BamlOptions | None = None) -> _N: ...
    async def next_async(self, *, _baml: BamlOptions | None = None) -> _N: ...
    def final(self, *, _baml: BamlOptions | None = None) -> _F: ...
    async def final_async(self, *, _baml: BamlOptions | None = None) -> _F: ...


class BamlFunctionSpec(_BridgeSpec[_O], Generic[_O]):
    def name(self, *, _baml: BamlOptions | None = None) -> str: ...
    async def name_async(self, *, _baml: BamlOptions | None = None) -> str: ...
    def arguments(self, *, _baml: BamlOptions | None = None) -> dict[str, Any]: ...
    async def arguments_async(self, *, _baml: BamlOptions | None = None) -> dict[str, Any]: ...
    def output_type(self, *, _baml: BamlOptions | None = None) -> Any: ...
    async def output_type_async(self, *, _baml: BamlOptions | None = None) -> Any: ...
    def prompt(self, *, _baml: BamlOptions | None = None) -> Any: ...
    async def prompt_async(self, *, _baml: BamlOptions | None = None) -> Any: ...
    def tools(self, *, _baml: BamlOptions | None = None) -> Any: ...
    async def tools_async(self, *, _baml: BamlOptions | None = None) -> Any: ...
    def client_id(self, *, _baml: BamlOptions | None = None) -> str: ...
    async def client_id_async(self, *, _baml: BamlOptions | None = None) -> str: ...
    def build_request(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> Any: ...
    async def build_request_async(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> Any: ...
    def parse(self, json: str, *, _baml: BamlOptions | None = None) -> _O: ...
    async def parse_async(self, json: str, *, _baml: BamlOptions | None = None) -> _O: ...
    def call(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> _O: ...
    async def call_async(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> _O: ...


from baml_bridge import BamlPyHandle

class _CallableHandle(Protocol):
    def _to_pyhandle(self) -> BamlPyHandle: ...
