from typing import TypedDict

from .vendor import trace
from .baml.spawn import CancelToken


class BamlOptions(TypedDict, total=False):
    trace: trace.Options | trace.ReservedSpan | None
    cancel: CancelToken | None
    timeout_ms: int | None

from typing import Any, Generic, Protocol, TypeVar
from baml_bridge import BamlStream as _BridgeStream, BamlFunctionSpec as _BridgeSpec

_N = TypeVar("_N")
_Y = TypeVar("_Y")
_F = TypeVar("_F")
_O = TypeVar("_O")


class BamlStream(_BridgeStream[_N, _Y, _F], Generic[_N, _Y, _F]):
    def next_sync(self, *, _baml: BamlOptions | None = None) -> _N: ...
    async def next(self, *, _baml: BamlOptions | None = None) -> _N: ...
    def final_sync(self, *, _baml: BamlOptions | None = None) -> _F: ...
    async def final(self, *, _baml: BamlOptions | None = None) -> _F: ...


class BamlFunctionSpec(_BridgeSpec[_O], Generic[_O]):
    def name_sync(self, *, _baml: BamlOptions | None = None) -> str: ...
    async def name(self, *, _baml: BamlOptions | None = None) -> str: ...
    def arguments_sync(self, *, _baml: BamlOptions | None = None) -> dict[str, Any]: ...
    async def arguments(self, *, _baml: BamlOptions | None = None) -> dict[str, Any]: ...
    def output_type_sync(self, *, _baml: BamlOptions | None = None) -> Any: ...
    async def output_type(self, *, _baml: BamlOptions | None = None) -> Any: ...
    def prompt_sync(self, *, _baml: BamlOptions | None = None) -> Any: ...
    async def prompt(self, *, _baml: BamlOptions | None = None) -> Any: ...
    def tools_sync(self, *, _baml: BamlOptions | None = None) -> Any: ...
    async def tools(self, *, _baml: BamlOptions | None = None) -> Any: ...
    def requested_model_sync(self, *, _baml: BamlOptions | None = None) -> str: ...
    async def requested_model(self, *, _baml: BamlOptions | None = None) -> str: ...
    def build_request_sync(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> Any: ...
    async def build_request(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> Any: ...
    def parse_sync(self, json: str, *, _baml: BamlOptions | None = None) -> _O: ...
    async def parse(self, json: str, *, _baml: BamlOptions | None = None) -> _O: ...
    def call_sync(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> _O: ...
    async def call(self, *, _baml: BamlOptions | None = None, **kwargs: Any) -> _O: ...


from baml_bridge import BamlPyHandle

class _CallableHandle(Protocol):
    def _to_pyhandle(self) -> BamlPyHandle: ...
