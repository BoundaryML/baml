# Generated content inside each test crate
**/generated/

# type_shapes/ commits its generated output so reviewers can diff
# codegen behavior directly. Re-allow the codegen output and helper
# scripts but keep build/runtime caches and the venv excluded.
!type_shapes/generated/
!type_shapes/generated/baml_sdk/
!type_shapes/generated/baml_sdk/**
!type_shapes/generated/pyproject.toml
!type_shapes/generated/test.sh
!type_shapes/generated/test.ps1
!type_shapes/generated/test_main.py

# Re-ignore Python runtime artifacts uv/pytest scatter through the SDK tree.
type_shapes/generated/baml_sdk/**/__pycache__/
type_shapes/generated/**/*.pyc
type_shapes/generated/uv.lock
