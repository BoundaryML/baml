{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "preserveSymlinks": true,
    "rootDir": ".",
    "types": ["node", "vitest"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
