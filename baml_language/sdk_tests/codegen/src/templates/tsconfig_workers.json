{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "preserveSymlinks": true,
    "rootDir": "workers",
    "types": ["@cloudflare/vitest-pool-workers/types", "node", "vitest"]
  },
  "include": ["workers/**/*.ts"],
  "exclude": [
    "node_modules",
    "workers/host_common_types.test.ts",
    "workers/host_recording_audit.test.ts"
  ]
}
