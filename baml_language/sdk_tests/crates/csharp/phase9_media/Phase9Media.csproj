<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <Deterministic>true</Deterministic>
    <AssemblyName>Baml.CSharp.Phase9Media</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(BamlBridgePackageVersion)' == ''">
    <ProjectReference Include="../../../../sdks/csharp/bridge_csharp/src/Baml.Bridge.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BamlBridgePackageVersion)' != ''">
    <PackageReference Include="baml-bridge" Version="[$(BamlBridgePackageVersion)]" />
  </ItemGroup>
</Project>
