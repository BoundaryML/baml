<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>Baml.CSharp.Phase6Slice</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../sdks/csharp/bridge_csharp/src/Baml.Bridge.csproj" />
    <Compile Include="baml_client/**/*.cs" />
    <Compile Include="Program.cs" Condition="'$(BamlNegativeCase)' == ''" />
    <Compile
      Include="CompileNegative/$(BamlNegativeCase).cs"
      Condition="'$(BamlNegativeCase)' != ''" />
  </ItemGroup>
  <PropertyGroup
    Condition="'$(BamlNegativeCase)' == 'BareNullInference'
      Or '$(BamlNegativeCase)' == 'ResultOnlyInference'
      Or '$(BamlNegativeCase)' == 'RawNullableInference'
      Or '$(BamlNegativeCase)' == 'StaticNullInference'">
    <BamlNegativeCaseIsKnown>true</BamlNegativeCaseIsKnown>
  </PropertyGroup>
  <Target Name="ValidateBamlNegativeCase" BeforeTargets="CoreCompile">
    <Error
      Code="BAMLGEN001"
      Condition="'$(BamlNegativeCase)' != ''
        And '$(BamlNegativeCaseIsKnown)' != 'true'"
      Text="Unknown BamlNegativeCase '$(BamlNegativeCase)'." />
  </Target>
</Project>
