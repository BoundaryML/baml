--- args
--graph
graph.mmd
--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_core = { path = "crates/app_core" }
app_cli = { path = "crates/app_cli" }
--- file crates/app_cli/Cargo.toml
[package]
name = "app_cli"
version = "0.1.0"
edition = "2021"

[dependencies]
zzz = "1"
app_core = { path = "../app_core" }
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
0
--- stdout
--- expect graph.mmd
flowchart TB
  subgraph ns_app ["app"]
    c_app_cli["app_cli"]
    c_app_core["app_core"]
  end
  c_app_cli --> c_app_core
  style ns_app fill:#dbe9f6,stroke:#1f77b4
  style c_app_cli fill:#ffffff,stroke:#1f77b4
  style c_app_core fill:#ffffff,stroke:#1f77b4
