--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file crates/app_core_test/Cargo.toml
[package]
name = "app_core_test"
version = "0.1.0"
edition = "2021"
--- file crates/app_core_tests/Cargo.toml
[package]
name = "app_core_tests"
version = "0.1.0"
edition = "2021"
--- file crates/app_core_types/Cargo.toml
[package]
name = "app_core_types"
version = "0.1.0"
edition = "2021"
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
0
--- stdout
ok
