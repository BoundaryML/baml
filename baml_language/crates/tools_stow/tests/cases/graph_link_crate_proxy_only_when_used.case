--- args
--graph
graph.mmd
--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_a = { path = "crates/app_a" }
lib_x = { path = "crates/lib_x" }
lib_y = { path = "crates/lib_y" }
--- file crates/app_a/Cargo.toml
[package]
name = "app_a"
version = "0.1.0"
edition = "2021"
--- file crates/lib_x/Cargo.toml
[package]
name = "lib_x"
version = "0.1.0"
edition = "2021"
--- file crates/lib_y/Cargo.toml
[package]
name = "lib_y"
version = "0.1.0"
edition = "2021"

[dependencies]
lib_x = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"
link_crates = ["lib_x", "app_a", "lib_unused"]

[[namespaces]]
name = "lib"
link_crates = ["lib_x"]
--- exit
0
--- stdout
--- expect graph.mmd
flowchart TB
  subgraph ns_app ["app"]
    c_app_a["app_a"]
  end
  subgraph ns_lib ["lib"]
    c_lib_x["lib_x"]
    c_lib_y["lib_y"]
  end
  c_lib_y --> c_lib_x
  style ns_app fill:#dbe9f6,stroke:#1f77b4
  style ns_lib fill:#fde3cf,stroke:#d95f02
  style c_app_a fill:#ffffff,stroke:#1f77b4
  style c_lib_x fill:#ffffff,stroke:#d95f02
  style c_lib_y fill:#ffffff,stroke:#d95f02
