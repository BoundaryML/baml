--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_core = { path = "crates/app_core" }
serde = "1"
tokio = "1"
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"

[dependencies]
tokio = { workspace = true }
serde = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
1
--- stdout
error[unsorted-deps]: app_core: crates/app_core/Cargo.toml: [dependencies] is not sorted: internal dependencies first, then external, each alphabetical
1 error(s)
