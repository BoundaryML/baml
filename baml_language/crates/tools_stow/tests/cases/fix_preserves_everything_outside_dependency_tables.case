name = "app_cli"
version = "0.1.0"
edition = "2021"
description = "kept"   # odd   spacing
keywords = [ "a",
             "b" ]

# About features.
[features]
default = [ ]

[dependencies]
serde = { workspace = true }
tokio = { workspace = true }

[lints]
workspace = true
