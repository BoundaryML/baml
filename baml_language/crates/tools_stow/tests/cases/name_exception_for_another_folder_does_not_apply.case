--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]
--- file crates/core_folder/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file stow.toml
[[namespaces]]
name = "app"
name_exceptions = { "other" = "app_core" }
--- exit
1
--- stdout
error[name-mismatch]: app_core: crates/core_folder/Cargo.toml: package name `app_core` does not match folder `core_folder`
1 error(s)
