--- args
--fix
--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_core = { path = "crates/app_core" }
serde = "1"
tokio = "1"

[package]
name = "app_root"
version = "0.1.0"
edition = "2021"

[dependencies]
tokio = { workspace = true }
serde = "1"
app_core = { workspace = true }
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
0
--- stdout
fixed Cargo.toml
ok
