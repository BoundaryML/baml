--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_core = { path = "crates/app_core" }
serde = "1"
tokio = "1"
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"

[target.'cfg(unix)'.build-dependencies]
serde = { workspace = true }

[dev-dependencies]
tokio = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
0
--- stdout
ok
