--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file crates/folder/Cargo.toml
[package]
name = "exact"
version = "0.1.0"
edition = "2021"
--- file crates/vendored_thing/Cargo.toml
[package]
name = "vendored_thing"
version = "0.1.0"
edition = "2021"

[dependencies]
zzz = "1"
aaa = "1"
--- file stow.toml
ignore_crates = ["vendored_*", "exact"]

[[namespaces]]
name = "app"
--- exit
0
--- stdout
ok
