--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_core = { path = "crates/app_core" }
lib_util = { path = "crates/lib_util" }
serde = "1"
--- file crates/app_cli/Cargo.toml
[package]
name = "app_cli"
version = "0.1.0"
edition = "2021"

[dependencies]
app_core = { workspace = true }
lib_util = { workspace = true }
serde = { workspace = true }
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file crates/lib_util/Cargo.toml
[package]
name = "lib_util"
version = "0.1.0"
edition = "2021"
--- file stow.toml
[[namespaces]]
name = "app"

[[namespaces]]
name = "lib"
--- exit
0
--- stdout
ok
