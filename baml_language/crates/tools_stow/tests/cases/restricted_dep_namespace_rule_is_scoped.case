--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
anyhow = "1"
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"

[dependencies]
anyhow = { workspace = true }
--- file crates/lib_core/Cargo.toml
[package]
name = "lib_core"
version = "0.1.0"
edition = "2021"

[dependencies]
anyhow = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"

[[namespaces.dependency_rules]]
pattern = "anyhow"
reason = "Not in app."

[[namespaces]]
name = "lib"
--- exit
1
--- stdout
error[restricted-dep]: app_core: crates/app_core/Cargo.toml: [dependencies] `anyhow` is not allowed here: Not in app.
1 error(s)
