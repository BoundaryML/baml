--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
Alpha = "1"
beta = "1"
Gamma = "1"
--- file crates/app_cli/Cargo.toml
[package]
name = "app_cli"
version = "0.1.0"
edition = "2021"

[dependencies]
Alpha = { workspace = true }
Gamma = { workspace = true }
beta = { workspace = true }
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"

[dependencies]
Alpha = { workspace = true }
beta = { workspace = true }
Gamma = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
1
--- stdout
error[unsorted-deps]: app_cli: crates/app_cli/Cargo.toml: [dependencies] is not sorted: internal dependencies first, then external, each alphabetical
1 error(s)
