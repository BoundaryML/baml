--- args
--graph
graph.mmd
--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_a = { path = "crates/app_a" }
app_b = { path = "crates/app_b" }
serde = { version = "1", features = ["derive"] }
--- file crates/app_a/Cargo.toml
[package]
name = "app_a"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { workspace = true, features = ["rc", "derive", "alloc"] }

[dev-dependencies]
serde = { workspace = true, features = ["std"] }
--- file crates/app_b/Cargo.toml
[package]
name = "app_b"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { workspace = true, features = ["derive"] }
--- file stow.toml
[graph]
external_deps = ["serde"]

[[namespaces]]
name = "app"
--- exit
0
--- stdout
--- expect graph.mmd
flowchart TB
  subgraph ns_app ["app"]
    c_app_a["app_a"]
    c_app_b["app_b"]
    x_app__serde["serde"]
    x_app__serde__alloc_rc_std["serde [alloc, rc, std]"]
  end
  c_app_a --> x_app__serde__alloc_rc_std
  c_app_b --> x_app__serde
  style ns_app fill:#dbe9f6,stroke:#1f77b4
  style c_app_a fill:#ffffff,stroke:#1f77b4
  style c_app_b fill:#ffffff,stroke:#1f77b4
  style x_app__serde fill:#d0d0d0,stroke:#606060
  style x_app__serde__alloc_rc_std fill:#d0d0d0,stroke:#606060
