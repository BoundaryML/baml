--- args
--fix
--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app_core = { path = "crates/app_core" }
app_util = { path = "crates/app_util" }
serde = { version = "1", features = ["derive"] }
tokio = "1"
zebra = "1"
--- file crates/app_cli/Cargo.toml
[package]
name = "app_cli"
version = "0.1.0"
edition = "2021"

[dependencies]
app_core = { path = "../app_core" }
serde = { version = "1", features = ["derive", "rc"] }
tokio = { version = "1", optional = true, default-features = false }
zebra = { git = "https://example.com/zebra", branch = "main" }
app_util = { version = "1", git = "https://example.com/util", rev = "abc" }
--- file crates/app_core/Cargo.toml
[package]
name = "app_core"
version = "0.1.0"
edition = "2021"
--- file crates/app_util/Cargo.toml
[package]
name = "app_util"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { workspace = true }
tokio = { workspace = true }
zebra = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"
--- exit
0
--- stdout
fixed crates/app_cli/Cargo.toml
ok
--- expect crates/app_cli/Cargo.toml
[package]
name = "app_cli"
version = "0.1.0"
edition = "2021"

[dependencies]
app_core = { workspace = true }
app_util = { workspace = true }
serde = { workspace = true, features = ["derive", "rc"] }
tokio = { workspace = true, optional = true, default-features = false }
zebra = { workspace = true }
