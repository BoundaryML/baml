--- args
--graph
graph.mmd
--- file Cargo.toml
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.dependencies]
app-core = { path = "crates/app_core" }
--- file crates/app_core/Cargo.toml
[package]
name = "app-core"
version = "0.1.0"
edition = "2021"
--- file crates/tool/Cargo.toml
[package]
name = "cargo-app"
version = "0.1.0"
edition = "2021"

[dependencies]
app-core = { workspace = true }
--- file stow.toml
[[namespaces]]
name = "app"
name_exceptions = { "tool" = "cargo-app", "app_core" = "app-core" }
approved_prefixes = ["x"]
--- exit
0
--- stdout
--- expect graph.mmd
flowchart TB
  subgraph ns_app ["app"]
    c_app_core["app-core"]
    c_cargo_app["cargo-app"]
  end
  c_cargo_app --> c_app_core
  style ns_app fill:#dbe9f6,stroke:#1f77b4
  style c_app_core fill:#ffffff,stroke:#1f77b4
  style c_cargo_app fill:#ffffff,stroke:#1f77b4
