---
source: crates/baml_tests/tests/fs.rs
expression: "stabilize(&output.bytecode, &root)"
---
function main() -> int {
    load_const "{TMPDIR}/data.bin"
    load_const "r+"
    dispatch_future baml.fs.file
    await
    store_var file
    load_var file
    load_const 0
    dispatch_future baml.fs.File.seek
    await
    pop 1
    load_var file
    load_const "AB"
    dispatch_future baml.fs.File.write
    await
    return
}
