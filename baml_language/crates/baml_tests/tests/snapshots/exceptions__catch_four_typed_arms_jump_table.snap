function risky(mode: int) -> int {
    load_var mode
    load_const 0
    cmp_op ==
    pop_jump_if_false L0
    jump L5

  L0:
    load_var mode
    load_const 1
    cmp_op ==
    pop_jump_if_false L1
    jump L4

  L1:
    load_var mode
    load_const 2
    cmp_op ==
    pop_jump_if_false L2
    jump L3

  L2:
