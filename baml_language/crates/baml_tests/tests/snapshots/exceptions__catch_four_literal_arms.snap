    load_var x
    load_const 1
    cmp_op ==
    pop_jump_if_false L1
    jump L4

  L1:
    load_var x
    load_const 2
    cmp_op ==
    pop_jump_if_false L2
    jump L3

  L2:
    load_const "other"
    throw

  L3:
    load_const "crash"
    throw

  L4:
    load_const "bang"
    throw

  L5:
    load_const "boom"
    throw
}

function main() -> int {
