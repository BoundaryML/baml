function user.User.promote(self: null, bonus: int) -> Report {
    load_var self
    load_var self
    load_field .age
    load_const 1
    bin_op +
    store_field .age
    load_var self
    load_var bonus
    call user.score
    store_var base
    alloc_instance user.Report
    load_var base
    load_field .score
    load_var bonus
    bin_op +
    init_field .score
    load_var base
    load_field .label
    init_field .label
    load_var base
    load_field .breakdown
    init_field .breakdown
    return
}

