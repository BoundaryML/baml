function user.User.promote(self: User, bonus: int) -> Report {
    load_var self
    copy 0
    load_field .age
    load_const 1
    bin_op +
    store_field .age
    load_var2 1 2
    call user.score
    store_var base
    load_var base
    load_field .score
    load_var bonus
    add_int
    load_var base
    load_field .label
    load_var base
    load_field .breakdown
    init_instance user.Report .score, .label, .breakdown
    return
}

function user.http_status(code: int) -> string {
    load_var code
    dense_tag [200, 201, 204, 400, 404, 500]
    jump_table [L6, L5, L4, L3, L2, L1], default L0

  L0:
    load_const "Unknown"
    store_var label
    jump L7

  L1: 500
    load_const "Internal Server Error"
    store_var label
    jump L7

  L2: 404
    load_const "Not Found"
    store_var label
    jump L7

  L3: 400
    load_const "Bad Request"
    store_var label
    jump L7

  L4: 204
    load_const "No Content"
    store_var label
    jump L7

  L5: 201
    load_const "Created"
    store_var label
    jump L7

  L6: 200
    load_const "OK"
    store_var label

  L7:
    load_const "HTTP "
    load_var label
    bin_op +
    return
}

