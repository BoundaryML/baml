---
source: crates/baml_tests/tests/bytecode_format/main.rs
---
function user.User.promote(self: User, bonus: int) -> Report {
    load_var self
    copy 0
    load_field .age
    load_const 1
    bin_op +
    store_field .age
    load_var2 1 2
    call user.score
    store_var base
    load_var base
    load_field .score
    load_var bonus
    add_int
    load_var base
    load_field .label
    load_var base
    load_field .breakdown
    init_instance user.Report .score, .label, .breakdown
    return
}

function user.http_status(code: int) -> string {
    load_var code
    dense_tag [200, 201, 204, 400, 404, 500]
    jump_table [L6, L5, L4, L3, L2, L1], default L0

  L0:
    load_const "Unknown"
    store_var label
    jump L7

  L1: 500
    load_const "Internal Server Error"
    store_var label
    jump L7

  L2: 404
    load_const "Not Found"
    store_var label
    jump L7

  L3: 400
    load_const "Bad Request"
    store_var label
    jump L7

  L4: 204
    load_const "No Content"
    store_var label
    jump L7

  L5: 201
    load_const "Created"
    store_var label
    jump L7

  L6: 200
    load_const "OK"
    store_var label

  L7:
    load_const "HTTP "
    load_var label
    bin_op +
    return
}

function user.score(input: User | ErrorInfo, threshold: int) -> Report {
    load_var input
    store_var _4
    load_var _4
    narrow_bind User, slot=4
    pop_jump_if_false L0
    jump L1

  L0:
    load_var input
    load_field .message
    store_var name
    jump L2

  L1:
    load_var _4
    load_field .name
    store_var name

  L2:
    load_var input
    store_var _8
    load_var _8
    narrow_bind User, slot=6
    pop_jump_if_false L3
    jump L4

  L3:
    load_var input
    load_field .code
    unary_op -
    store_var age
    jump L5

  L4:
    load_var _8
    load_field .age
    store_var age

  L5:
    load_var input
    store_var _13
    load_var _13
    narrow_bind User, slot=8
    pop_jump_if_false L6
    jump L7

  L6:
    load_var threshold
    store_var role_mult
    jump L12

  L7:
    load_var _13
    load_field .role
    discriminant
    jump_table [L11, L10, L9, L8], default L19

  L8: Role.Guest
    load_var threshold
    store_var role_mult
    jump L12

  L9: Role.Viewer
    load_var threshold
    store_var role_mult
    jump L12

  L10: Role.Editor
    load_var threshold
    store_var role_mult
    jump L12

  L11: Role.Admin
    load_var threshold
    store_var role_mult

  L12:
    load_var age
    load_const 2
    mul_int
    load_var role_mult
    add_int
    store_var_load_var base
    load_var role_mult
    cmp_int_op >
    pop_jump_if_false L13
    jump L14

  L13:
    load_var base
    store_var capped
    jump L15

  L14:
    load_var role_mult
    store_var capped

  L15:
    load_var2 10 7
    add_int
    store_var_load_var total
    load_var threshold
    cmp_int_op >
    load_const true
    cmp_op ==
    pop_jump_if_false L16
    jump L17

  L16:
    load_const " [LOW]"
    store_var suffix
    jump L18

  L17:
    load_const " [HIGH]"
    store_var suffix

  L18:
    load_var2 9 10
    load_var total
    load_type int
    alloc_array 3
    store_var scores
    load_var scores
    load_const 0
    load_var total
    store_array_element
    load_var scores
    load_const 0
    load_array_element
    load_var2 3 12
    bin_op +
    load_var2 9 7
    load_const "base"
    load_const "role"
    load_type string
    load_type int
    alloc_map 2
    init_instance user.Report .score, .label, .breakdown
    return

  L19:
    unreachable
}
