    make_cell
    store_var ?1
    load_var body
    make_closure .<lambda(run_test, 0)>, 1
    store_var base_run
    load_var runner
    load_const null
    cmp_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_var base_run
    load_var runner
    call_indirect
    call_indirect
    jump L2

  L1:
    load_var base_run
    call_indirect

  L2:
    return
}

