}

function testing.run_testset(run_children: () -> testing.TestSetReport, runner: (() -> testing.TestSetReport) -> () -> testing.TestSetReport?) -> testing.TestSetReport {
  197   0    load_var 2             (runner)
        1    load_const 0           (null)
        2    cmp_op ==              
        3    pop_jump_if_false +2   (to 5)
        4    jump +9                (to 13)
        5    load_var 2             (runner)
        6    is_type 1              
        7    pop_jump_if_false +8   (to 15)

  199   8    load_var 1             (run_children)
        9    load_var 2             (runner)
        10   call_indirect          
        11   store_var 3            (effective_run)
        12   jump +3                (to 15)

  198   13   load_var 1             (run_children)
        14   store_var 3            (effective_run)

  201   15   load_var 3             (effective_run)
        16   call_indirect          
