function user.User.promote(self: User, bonus: int) -> Report {
  9    0    load_var 1              (self)
       1    copy 0                  
       2    load_field 1            (age)
       3    load_const 0            (1)
       4    bin_op +                
       5    store_field 1           (age)

  10   6    load_var2 1 2           
       7    call 1267 ntypeargs=0   (user.score)
       8    store_var 3             (base)

  11   9    load_var 3              (base)
       10   load_field 0            (score)
       11   load_var 2              (bonus)
       12   add_int                 

  14   13   load_var 3              (base)
       14   load_field 1            (label)

  15   15   load_var 3              (base)
       16   load_field 2            (breakdown)
       17   init_instance 0         (user.Report .score, .label, .breakdown)
       18   return                  
}

function user.http_status(code: int) -> string {
  96    0    load_var 1     (code)
        1    dense_tag 0    
        2    jump_table 0   ([to 21, to 18, to 15, to 12, to 9, to 6], default to 3)

  103   3    load_const 0   ("Unknown")
        4    store_var 2    (label)

  96    5    jump +18       (to 23)

  102   6    load_const 1   ("Internal Server Error")
        7    store_var 2    (label)

  96    8    jump +15       (to 23)

  101   9    load_const 2   ("Not Found")
        10   store_var 2    (label)

  96    11   jump +12       (to 23)

  100   12   load_const 3   ("Bad Request")
        13   store_var 2    (label)

  96    14   jump +9        (to 23)

  99    15   load_const 4   ("No Content")
        16   store_var 2    (label)

  96    17   jump +6        (to 23)

  98    18   load_const 5   ("Created")
        19   store_var 2    (label)

  96    20   jump +3        (to 23)

  97    21   load_const 6   ("OK")
        22   store_var 2    (label)

  95    23   load_const 7   ("HTTP ")

  105   24   load_var 2     (label)
        25   bin_op +       
        26   return         
}

function user.score(input: User | ErrorInfo, threshold: int) -> Report {
  45   0     load_var 1              (input)
       1     store_var 4             (_4)
       2     load_var 4              (_4)
       3     narrow_bind 0 4         
       4     pop_jump_if_false +2    (to 6)
       5     jump +5                 (to 10)

  47   6     load_var 1              (input)
       7     load_field 1            (message)
       8     store_var 3             (name)

  45   9     jump +4                 (to 13)
       10    load_var 4              (_4)
       11    load_field 0            (name)
       12    store_var 3             (name)

  50   13    load_var 1              (input)
       14    store_var 6             (_8)
       15    load_var 6              (_8)
       16    narrow_bind 0 6         
       17    pop_jump_if_false +2    (to 19)
       18    jump +6                 (to 24)

  52   19    load_var 1              (input)
       20    load_field 0            (code)
       21    unary_op -              
       22    store_var 5             (age)

  50   23    jump +4                 (to 27)
       24    load_var 6              (_8)
       25    load_field 1            (age)
       26    store_var 5             (age)

  55   27    load_var 1              (input)
       28    store_var 8             (_13)
       29    load_var 8              (_13)
       30    narrow_bind 0 8         
       31    pop_jump_if_false +2    (to 33)
       32    jump +4                 (to 36)

  62   33    load_var 2              (threshold)
       34    store_var 7             (role_mult)

  55   35    jump +16                (to 51)
       36    load_var 8              (_13)
       37    load_field 2            (role)
       38    discriminant            
       39    jump_table 0            ([to 49, to 46, to 43, to 40], default to 102)

  60   40    load_var 2              (threshold)
       41    store_var 7             (role_mult)

  56   42    jump +9                 (to 51)

  59   43    load_var 2              (threshold)
       44    store_var 7             (role_mult)

  56   45    jump +6                 (to 51)

  58   46    load_var 2              (threshold)
       47    store_var 7             (role_mult)

  56   48    jump +3                 (to 51)

  57   49    load_var 2              (threshold)
       50    store_var 7             (role_mult)

  65   51    load_var 5              (age)
       52    load_const 1            (2)
       53    mul_int                 
       54    load_var 7              (role_mult)
       55    add_int                 
       56    store_var_load_var 9    (base)

  66   57    load_var 7              (role_mult)
       58    cmp_int_op >            
       59    pop_jump_if_false +2    (to 61)
       60    jump +4                 (to 64)

  69   61    load_var 9              (base)
       62    store_var 10            (capped)

  66   63    jump +3                 (to 66)

  67   64    load_var 7              (role_mult)
       65    store_var 10            (capped)

  71   66    load_var2 10 7          
       67    add_int                 
       68    store_var_load_var 11   (total)

  73   69    load_var 2              (threshold)
       70    cmp_int_op >            
       71    load_const 2            (true)
       72    cmp_op ==               
       73    pop_jump_if_false +2    (to 75)
       74    jump +4                 (to 78)

  75   75    load_const 3            (" [LOW]")
       76    store_var 12            (suffix)

  73   77    jump +3                 (to 80)

  74   78    load_const 4            (" [HIGH]")
       79    store_var 12            (suffix)

  79   80    load_var2 9 10          
       81    load_var 11             (total)
       82    load_type 5             
       83    alloc_array 3           
       84    store_var 13            (scores)

  80   85    load_var 13             (scores)
       86    load_const 6            (0)
       87    load_var 11             (total)
       88    store_array_element     

  81   89    load_var 13             (scores)
       90    load_const 6            (0)
       91    load_array_element      

  77   92    load_var2 3 12          
       93    bin_op +                

  83   94    load_var2 9 7           
       95    load_const 7            ("base")
       96    load_const 8            ("role")
       97    load_type 9             
       98    load_type 5             
       99    alloc_map 2             
       100   init_instance 0         (user.Report .score, .label, .breakdown)
       101   return                  
       102   unreachable             
}
