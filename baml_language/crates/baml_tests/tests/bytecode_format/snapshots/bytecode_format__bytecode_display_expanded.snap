  50   19    jump +4                        (to 23)

  51   20    load_var 1                     (input)
       21    load_field 1                   (age)
       22    store_var 4                    (age)

  55   23    load_var 1                     (input)
       24    is_type 0                      
       25    pop_jump_if_false +2           (to 27)
       26    jump +4                        (to 30)

  62   27    load_var 2                     (threshold)
       28    store_var 5                    (role_mult)

  55   29    jump +16                       (to 45)

  56   30    load_var 1                     (input)
       31    load_field 2                   (role)
       32    discriminant                   
       33    jump_table 0                   ([to 43, to 40, to 37, to 34], default to 102)

  60   34    load_var 2                     (threshold)
       35    store_var 5                    (role_mult)

  56   36    jump +9                        (to 45)

  59   37    load_var 2                     (threshold)
       38    store_var 5                    (role_mult)

  56   39    jump +6                        (to 45)

  58   40    load_var 2                     (threshold)
       41    store_var 5                    (role_mult)

  56   42    jump +3                        (to 45)

  57   43    load_var 2                     (threshold)
       44    store_var 5                    (role_mult)

  65   45    load_var 4                     (age)
       46    load_const 1                   (2)
       47    bin_op *                       
       48    load_var 5                     (role_mult)
       49    add_int                        
       50    store_var 6                    (base)

  66   51    load_var 6                     (base)
       52    load_var 5                     (role_mult)
       53    cmp_op >                       
       54    pop_jump_if_false +2           (to 56)
       55    jump +4                        (to 59)

  69   56    load_var 6                     (base)
       57    store_var 7                    (capped)

  66   58    jump +3                        (to 61)

  67   59    load_var 5                     (role_mult)
       60    store_var 7                    (capped)

  71   61    load_var 7                     (capped)
       62    load_var 5                     (role_mult)
       63    add_int                        
       64    store_var 8                    (total)

  73   65    load_var 8                     (total)
       66    load_var 2                     (threshold)
       67    cmp_op >                       
       68    load_const 2                   (true)
       69    cmp_op ==                      
       70    pop_jump_if_false +2           (to 72)
       71    jump +4                        (to 75)

  75   72    load_const 3                   (" [LOW]")
       73    store_var 9                    (suffix)

  73   74    jump +3                        (to 77)

  74   75    load_const 4                   (" [HIGH]")
       76    store_var 9                    (suffix)

  79   77    load_var 6                     (base)
       78    load_var 7                     (capped)
       79    load_var 8                     (total)
       80    alloc_array 3                  
       81    store_var 10                   (scores)

  80   82    load_var 10                    (scores)
       83    load_const 5                   (0)
       84    load_var 8                     (total)
       85    store_array_element            

  85   86    alloc_instance 5 ntypeargs=0   (user.Report)

  81   87    load_var 10                    (scores)
