function user.http_status(code: int) -> string {
  96    0    load_var 1     (code)
        1    dense_tag 0    
        2    jump_table 0   ([to 21, to 18, to 15, to 12, to 9, to 6], default to 3)

  103   3    load_const 0   ("Unknown")
        4    store_var 2    (label)

  96    5    jump +18       (to 23)

  102   6    load_const 1   ("Internal Server Error")
        7    store_var 2    (label)

  96    8    jump +15       (to 23)

  101   9    load_const 2   ("Not Found")
        10   store_var 2    (label)

  96    11   jump +12       (to 23)

  100   12   load_const 3   ("Bad Request")
        13   store_var 2    (label)

  96    14   jump +9        (to 23)

  99    15   load_const 4   ("No Content")
        16   store_var 2    (label)

  96    17   jump +6        (to 23)

  98    18   load_const 5   ("Created")
        19   store_var 2    (label)

  96    20   jump +3        (to 23)

  97    21   load_const 6   ("OK")
        22   store_var 2    (label)

  95    23   load_const 7   ("HTTP ")

  105   24   load_var 2     (label)
        25   bin_op +       
        26   return         
}

function user.score(input: User | ErrorInfo, threshold: int) -> Report {
  45   0     load_var 1                     (input)
       1     is_type 0                      
       2     pop_jump_if_false +2           (to 4)
       3     jump +5                        (to 8)

  47   4     load_var 1                     (input)
