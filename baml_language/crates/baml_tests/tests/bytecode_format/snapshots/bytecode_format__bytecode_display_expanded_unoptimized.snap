  45   11    jump +6                 (to 17)
       12    load_var 4              (_4)
       13    store_var 5             (u)

  46   14    load_var 5              (u)
       15    load_field 0            (name)
       16    store_var 3             (name)

  50   17    load_var 1              (input)
       18    store_var 8             (_8)
       19    load_var 8              (_8)
       20    narrow_bind 0 8         
       21    pop_jump_if_false +2    (to 23)
       22    jump +7                 (to 29)
       23    load_var 1              (input)
       24    store_var_load_var 10   (e)

  52   25    load_field 0            (code)
