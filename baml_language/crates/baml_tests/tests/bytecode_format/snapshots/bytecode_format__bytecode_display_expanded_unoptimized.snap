  73   85    jump +3                 (to 88)

  74   86    load_const 4            (" [HIGH]")
       87    store_var 17            (suffix)

  77   88    load_var2 3 17          
       89    bin_op +                
       90    store_var 18            (label)

  79   91    load_var2 14 15         
       92    load_var 16             (total)
       93    load_type 5             
       94    alloc_array 3           
       95    store_var 19            (scores)

  80   96    load_var 19             (scores)
       97    load_const 6            (0)
       98    load_var 16             (total)
