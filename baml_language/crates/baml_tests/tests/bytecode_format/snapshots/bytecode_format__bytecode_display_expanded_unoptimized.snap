       63    add_int                 
       64    store_var_load_var 14   (base)

  66   65    load_var 11             (role_mult)
       66    cmp_int_op >            
       67    pop_jump_if_false +2    (to 69)
       68    jump +4                 (to 72)

  69   69    load_var 14             (base)
       70    store_var 15            (capped)

  66   71    jump +3                 (to 74)

  67   72    load_var 11             (role_mult)
       73    store_var 15            (capped)

  71   74    load_var2 15 11         
       75    add_int                 
       76    store_var_load_var 16   (total)

  73   77    load_var 2              (threshold)
       78    cmp_int_op >            
       79    load_const 2            (true)
       80    cmp_op ==               
       81    pop_jump_if_false +2    (to 83)
       82    jump +4                 (to 86)

  75   83    load_const 3            (" [LOW]")
