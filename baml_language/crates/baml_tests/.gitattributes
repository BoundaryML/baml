# Snapshot test files
*.snap linguist-generated=true
*.snap -diff
*.snap merge=ours

# Alternative: treat as binary (more aggressive, hides content entirely)
# *.snap binary

# Mark snapshots directory as generated
snapshots/** linguist-generated=true

# Large stress test input - use LFS to avoid bloating repo
# Note: Snapshots are NOT in LFS so they remain diffable in PRs
**/parser_stress/large_file.baml filter=lfs diff=lfs merge=lfs -text
