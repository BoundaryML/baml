function user.Box.unwrap(self: null) -> void {
    load_var self
    load_field .value
    return
}

function user.Calculator.compute(self: null, a: int, b: int) -> int {
    load_var self
    load_field .op
    load_const "add"
    cmp_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_var a
    load_var b
    bin_op *
    jump L2

  L1:
    load_var a
    load_var b
    bin_op +

  L2:
    return
}

