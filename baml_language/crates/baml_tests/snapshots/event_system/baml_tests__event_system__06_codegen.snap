function user.emit_custom_event(name: string) -> null {
    load_const "user_action"
    load_var name
    load_const "action"
    alloc_map 1
    send_event
    return
}

function user.emit_multiple_events() -> null {
    load_const "step"
    load_const 1
    load_const "step"
    alloc_map 1
    send_event
    pop 1
    load_const "step"
    load_const 2
    load_const "step"
    alloc_map 1
    send_event
    pop 1
    load_const "step"
    load_const 3
    load_const "step"
    alloc_map 1
    send_event
    return
}

function user.nested_inner() -> int {
    load_const 10
    return
}

function user.nested_outer() -> int {
    call user.nested_inner
    load_const 1
    bin_op +
    return
}

function user.process_with_logging(input: string) -> string {
    load_const "start"
    load_var input
    load_const "event"
    load_const "input"
    alloc_map 2
    call baml.log.info
    pop 1
    load_const "processing"
    load_const "start"
    load_const "stage"
    alloc_map 1
    send_event
    pop 1
    load_const "Processed: "
    load_var input
    bin_op +
    store_var result
    load_const "processing"
    load_const "complete"
    load_const "stage"
    alloc_map 1
    send_event
    pop 1
    load_const "complete"
    load_var result
    load_const "event"
    load_const "result"
    alloc_map 2
    call baml.log.info
    pop 1
    load_var result
    return
}

function user.simple_function() -> int {
    load_const 42
    return
}

function user.test_logging() -> null {
    load_const "Starting process"
    load_const "message"
    alloc_map 1
    call baml.log.debug
    pop 1
    alloc_instance User
    load_const 123
    init_field .id
    load_const "Alice"
    init_field .name
    load_const "alice@example.com"
    init_field .email
    load_const "processing"
    load_const "user"
    load_const "status"
    alloc_map 2
    call baml.log.info
    pop 1
    load_const "Resource usage high"
    load_const "warning"
    alloc_map 1
    call baml.log.warn
    pop 1
    load_const "E001"
    load_const 3
    load_const "code"
    load_const "retries"
    alloc_map 2
    call baml.log.error
    return
}
