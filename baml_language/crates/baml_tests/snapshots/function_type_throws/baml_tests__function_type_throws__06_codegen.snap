function user.apply_and_throw(f: () -> int) -> int {
    load_var f
    call_indirect
    store_var result
    load_var result
    load_const 0
    cmp_op <
    pop_jump_if_false L0
    jump L1

  L0:
    load_var result
    return

  L1:
    load_const "negative result"
    throw
}

