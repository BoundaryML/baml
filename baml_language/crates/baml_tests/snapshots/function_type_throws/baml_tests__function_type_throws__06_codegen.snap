function user.may_fail(x: int) -> string {
    load_var x
    load_const 0
    cmp_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_const "ok"
    return

  L1:
    load_const "zero"
    throw
}

function user.safe_caller() -> string {
    load_const 1
    call user.may_fail
    jump L0
    load_var e
    throw_if_panic
    load_const "caught"

  L0:
    return
}

