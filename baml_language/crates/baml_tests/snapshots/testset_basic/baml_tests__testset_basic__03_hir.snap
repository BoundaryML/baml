  { registry.register_test_set("basic group", (testset: testing.TestSetCollector) -> { { testset.register_test("first", () -> { { assert <missing> } is_true(true) }, null); testset.register_test("second", () -> { { assert <missing> } is_true(true) }, null) } }, null) }
