function user.test_let_destructure_multiple_fields() -> string {
    alloc_instance Dog
    load_const "Rex"
    init_field .name
    load_const "Lab"
    init_field .breed
    store_var x
    load_var x
    load_field .name
    load_const " "
    bin_op +
    load_var x
    load_field .breed
    bin_op +
    return
}

