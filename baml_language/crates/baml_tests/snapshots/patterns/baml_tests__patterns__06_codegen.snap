function user.test_or_let_union_type() -> int {
    alloc_instance Bar
    load_const 42
    init_field .a
    store_var x
    load_var x
    is_type Foo
    pop_jump_if_false L0
    jump L1

  L0:
    load_var x
    is_type Bar
    pop_jump_if_false L1
    load_var x
    load_field .0
    store_var a

  L1:
    load_var x
    call user.accept_foo
    return
}

