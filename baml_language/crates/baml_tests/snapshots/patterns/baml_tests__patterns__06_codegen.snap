function user.accept_foo(f: Foo) -> int {
    load_var f
    load_field .a
    return
}

function user.test_deep_destructure(x: Outer) -> string {
    load_var x
    load_field .middle
    load_field .inner
    load_field .value
    return
}

function user.test_destructure_primitive(x: int) -> int {
    load_var x
    pop 1
    load_const false
    pop_jump_if_false L0
    jump L1

  L0:
    load_var _0
    return

  L1:
    load_const "unresolved local: val"
    call baml.sys.panic
    pop 1
    jump L2

  L2:
    unreachable
}

