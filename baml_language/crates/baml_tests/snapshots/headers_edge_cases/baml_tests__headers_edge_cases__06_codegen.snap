function user.ConsecutiveHeaders() -> string {
    notify_block First Header
    notify_block Second Header
    notify_block Third Header
    notify_block Subsection A
    notify_block Subsection B
    notify_block Subsection C
    load_const "multiple consecutive headers"
    return
}

function user.HeaderLevels() -> string {
    notify_block Level 1
    notify_block Level 2
    notify_block Level 3
    notify_block Level 4
    notify_block Level 5
    notify_block Level 6
    notify_block Level 7 - More than 6 levels
    notify_block Level 8
    notify_block Level 9
    load_const "deep nesting"
    return
}

function user.HeaderOnlyFunction() -> string {
    notify_block Just Headers
    notify_block No Code
    notify_block Only Documentation
    notify_block Pure Annotation
    notify_block No Expressions
    notify_block Until The End
    load_const "default"
    return
}

function user.HeadersAndComments() -> string {
    notify_block Header Before Comment
    notify_block Header After Comment
    notify_block Header After Doc Comment
    load_const "test"
    return
}

function user.HeadersAroundExpressions() -> string {
    notify_block Before Let
    notify_block After Let
    notify_block Before If
    load_const 5
    load_const 0
    cmp_op >
    pop_jump_if_false L0
    jump L1

  L0:
    notify_block Inside Else
    jump L2

  L1:
    notify_block Inside If

  L2:
    notify_block After If
    notify_block Before For
    load_const 1
    load_const 2
    load_const 3
    alloc_array 3
    store_var _4
    load_const 0
    store_var __for_idx

  L3:
    load_var __for_idx
    load_var _4
    call baml.Array.length
    cmp_op <
    pop_jump_if_false L4
    jump L5

  L4:
    notify_block After For
    notify_block Final Section
    load_const 5
    return

  L5:
    load_var _4
    load_var __for_idx
    load_array_element
    store_var i
    notify_block Inside For
    load_var __for_idx
    load_const 1
    bin_op +
    store_var __for_idx
    jump L3
}

function user.HeadersInComplexNesting() -> string {
    notify_block Main Function
    notify_block Inside Block Expression
    load_const true
    pop_jump_if_false L0
    jump L1

  L0:
    notify_block Inside Else
    load_const "else value"
    jump L2

  L1:
    notify_block Inside If True
    notify_block Very Deep Block
    notify_block Back to If Level
    load_const "deep value"

  L2:
    notify_block Back to Block Level
    store_var result
    notify_block Back to Function Level
    load_var result
    return
}

function user.HeadersWithSpecialChars() -> string {
    notify_block Header-With-Dashes
    notify_block Header_With_Underscores
    notify_block Header.With.Dots
    notify_block Header/With/Slashes
    notify_block Header\With\Backslashes
    notify_block Header|With|Pipes
    load_const "special chars"
    return
}

