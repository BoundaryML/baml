function user.ProcessAnalysis(analysis: user.Analysis) -> string  [expr] {
  { let score = analysis.score } if (score Gt 0.8) { return "Very positive: " Add analysis.sentiment } else if (score Gt 0.5) { return "Positive: " Add analysis.sentiment } else if (score Gt 0.2) { return "Neutral: " Add analysis.sentiment } else { return "Negative: " Add analysis.sentiment }
}
