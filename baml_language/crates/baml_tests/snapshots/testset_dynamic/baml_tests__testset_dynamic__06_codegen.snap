function user.$init_test(registry: testing.Registry) -> null {
    load_const "dynamic tests"
    make_closure .<lambda($init_test, 0)>, 0
    load_const null
    load_var registry
    load_const "register_test_set"
    load_map_element
    call_indirect
    pop 1
    load_const "conditional tests"
    make_closure .<lambda($init_test, 1)>, 0
    load_const null
    load_var registry
    load_const "register_test_set"
    load_map_element
    call_indirect
    pop 1
    load_const null
    return
}
