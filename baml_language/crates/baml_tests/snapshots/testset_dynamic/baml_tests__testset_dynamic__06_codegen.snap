source: crates/baml_tests/src/generated_tests.rs
---
function user.$init_test(registry: testing.Registry) -> null {
    load_var registry
    load_const "dynamic tests"
    make_closure .<lambda($init_test, 0)>, 0
    load_const null
    call assert.is_true
    pop 1
    load_var registry
    load_const "conditional tests"
    make_closure .<lambda($init_test, 2)>, 0
    load_const null
    call testing.TestSetCollector.register_test
    pop 1
    load_const null
    return
}
