=== TYPE INFERENCE ===
  Function CatchWithTypedArm:
    Return: Union([String, Literal(String("caught string"))])
  Function CatchAndRethrow:
    Return: String
  Function ChainedCatchClauses:
    Return: Union([String, Literal(String("first handler")), Literal(String("second handler"))])
  Function SingleCatchWildcard:
    Return: Union([String, Literal(String("caught"))])
  Function ThrowStatement:
    Return: Never
  Function MayFailIntOrString:
    Return: Union([Never, Never, Literal(String("ok"))])
  Function MayFail:
    Return: Union([Never, Literal(String("ok"))])
  Function SingleCatchTyped:
    Return: Union([String, Literal(String("caught string"))])
  Function AlsoMayFail:
    Return: Union([Never, Literal(String("also ok"))])
  Function NestedCatch:
    Return: Union([String, Union([String, Literal(String("inner caught"))])])
  Function CatchWithFallback:
    Return: Union([String, Literal(String("caught string")), Literal(String("caught int fallback"))])
  Function MultipleCatchArms:
    Return: Union([String, Literal(String("caught string")), Literal(String("caught int"))])
