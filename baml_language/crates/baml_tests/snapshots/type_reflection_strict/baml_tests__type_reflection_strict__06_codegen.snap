function user.assign_type_to_int(function_name: string) -> int {
    load_var function_name
    dispatch_future baml.llm.get_return_type
    await
    return
}

function user.pass_type_as_string(function_name: string) -> string {
    load_var function_name
    dispatch_future baml.llm.get_return_type
    await
    return
}

function user.type_to_type(function_name: string) -> type {
    load_var function_name
    dispatch_future baml.llm.get_return_type
    await
    return
}
