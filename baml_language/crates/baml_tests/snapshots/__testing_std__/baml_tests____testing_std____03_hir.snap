class testing.Registry {
  tests: testing.TestRegistration[]
  testsets: testing.TestSetRegistration[]
}
class testing.TestRegistration {
  name: string
  body: () -> null
  runner: testing.TestRunner?
}
class testing.TestSetCollector {
  tests: testing.TestRegistration[]
  testsets: testing.TestSetRegistration[]
}
class testing.TestSetRegistration {
  name: string
  collector: (testing.TestSetCollector) -> null
