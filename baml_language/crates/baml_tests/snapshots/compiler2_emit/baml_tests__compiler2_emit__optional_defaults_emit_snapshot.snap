function add(base: int, amount: int) -> int {
    load_var amount
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L0
    add_int base 2 -> amount

  L0:
    add_int base amount
    return
}

function main() -> int {
    load_const 12
    return
}
