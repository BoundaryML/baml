function DestructureQualifiedLet() -> int {
    let response = root.llm.openai.Response { text: "ok", score: 41 };

    let root.llm.openai.Response { score } = response;
    score
}

function DestructureQualifiedMatch() -> int {
    let response = root.llm.openai.Response { text: "ok", score: 42 };

    match (response) {
        root.llm.openai.Response { score: 0 } => 0,
        root.llm.openai.Response { score: let matched } => matched,
    }
}

function DestructureNamespaceQualifiedLet() -> int {
    let response = llm.openai.Response { text: "ok", score: 45 };

    let llm.openai.Response { score } = response;
    score
}

function DestructureNamespaceQualifiedMatch() -> int {
    let response = llm.openai.Response { text: "ok", score: 46 };

    match (response) {
        llm.openai.Response { score: 0 } => 0,
        llm.openai.Response { score: let matched } => matched,
    }
}

function TypePatternQualifiedLet() -> int {
    let response: root.llm.openai.Response = root.llm.openai.Response { text: "ok", score: 43 };

