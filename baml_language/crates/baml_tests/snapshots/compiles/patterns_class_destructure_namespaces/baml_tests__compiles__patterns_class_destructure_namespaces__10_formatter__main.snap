function GenericDestructureQualifiedLet() -> int {
    let boxed: root.llm.openai.Box<int> = root.llm.openai.Box<int> { value: 49 };

    let root.llm.openai.Box<int> { value } = boxed;
    value
}

function GenericDestructureNamespaceQualifiedLet() -> int {
    let boxed: llm.openai.Box<string> = llm.openai.Box<string> { value: "ok" };

    let llm.openai.Box<string> { value } = boxed;
    value.length()
}

function GenericTypePatternQualifiedMatch() -> int {
    let boxed: root.llm.openai.Box<int> | root.llm.openai.Box<string> = root.llm.openai.Box<int> { value: 50 };

    match (boxed) {
        root.llm.openai.Box<string> => 0,
        root.llm.openai.Box<int> => 50,
    }
}

function GenericTypePatternNamespaceQualifiedMatch() -> int {
    let boxed: llm.openai.Box<int> | llm.openai.Box<string> = llm.openai.Box<string> { value: "ready" };

    match (boxed) {
        llm.openai.Box<int> => 0,
        llm.openai.Box<string> => 51,
