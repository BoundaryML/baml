function user.Config.from_json(j: baml.json.json) -> Config {
    load_type Config
    load_var j
    call baml.json.to
    return
}

function user.GetResponse(cfg: Config) -> llm.Response {
    load_const "hello"
    load_var cfg
    load_field .model
    init_instance user.llm.Response .text, .model
    return
}

function user.llm.MakeResponse(cfg: Config) -> llm.Response {
    load_const "ok"
    load_var cfg
    load_field .model
    init_instance user.llm.Response .text, .model
    return
}

function user.llm.Response.from_json(j: baml.json.json) -> llm.Response {
    load_type llm.Response
    load_var j
    call baml.json.to
    return
}
