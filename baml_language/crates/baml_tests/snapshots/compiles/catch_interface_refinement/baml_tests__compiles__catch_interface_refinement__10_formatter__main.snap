---
source: crates/baml_tests/src/generated_tests.rs
---
// Regression: catch-arm reachability must respect `implements`.
//
// A concrete class arm refining an interface-typed throw fact is reachable
// (the runtime value behind `throws Failure` can be any implementer), and an
// interface arm covers concrete throw facts of implementing classes. Both
// directions previously scored NoMatch in ty_covers_fact/ty_may_match_fact
// and produced a false `E0063: unreachable arm`.
//
// This project must compile with ZERO diagnostics — the snapshot locks that.

interface Failure {
  function is_transient(self) -> bool throws never
}

class QuotaExceeded {
    quota_name: string,
}

implements Failure for QuotaExceeded {
  function is_transient(self) -> bool throws never { false }
}

class Throttled {
    retry_after_ms: int,
}

implements Failure for Throttled {
  function is_transient(self) -> bool throws never { true }
}

function provider_call(mode: int) -> string throws Failure | baml.errors.UnknownError {
    if (mode == 0) {
        throw Throttled { retry_after_ms: 250 };
    }
    if (mode == 1) {
        throw QuotaExceeded { quota_name: "daily" };
    }
    throw baml.errors.UnknownError { data: "socket reset", message: ["transport"] }
}

// Concrete refinement arms before the interface arm: all reachable.
function app(mode: int) -> string throws never {
    provider_call(mode) catch (e) {
        let q: QuotaExceeded => "quota: " + q.quota_name,
        let f: Failure => {
            if (f.is_transient()) {
                "retry"
            } else {
                "fail"
            }
        },
        let u: baml.errors.UnknownError => "unknown",
    }
}

// Interface arm over a locally-thrown concrete fact: also reachable. (No
// wildcard arm — `let f: Failure` COVERS the only throw fact, so a wildcard
// after it would correctly be unreachable.)
function local_throw() -> string throws never {
    let r: string = (throw Throttled { retry_after_ms: 1 }) catch (e) {
        let f: Failure => "classified",
    };
    r
}
