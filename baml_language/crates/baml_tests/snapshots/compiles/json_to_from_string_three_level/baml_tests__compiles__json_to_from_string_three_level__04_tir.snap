=== TIR2 ===
function user.level1<T>(s: string) -> T throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  { : T
    baml.json.from_string<T>(s) : T
  }
}
function user.level2<T>(s: string) -> T throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  { : T
    level1<T>(s) : T
  }
}
function user.level3<T>(s: string) -> T throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  { : T
    level2<T>(s) : T
  }
}
