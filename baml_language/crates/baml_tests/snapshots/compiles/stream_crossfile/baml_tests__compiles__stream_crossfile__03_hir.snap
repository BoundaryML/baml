class user.Education {
  school: string
  degree: user.Degree
  year: int
}
enum user.Degree {Bachelors, Masters, PhD}
type user.EducationList = user.Education[]
function user.from_json(j: baml.json.json) -> user.Education  [expr] {
  baml.json.from_string(baml.json.stringify(j))
}
function user.to_json(self: ?) -> baml.json.json  [expr] {
  map { "school": self.school.to_json(), "degree": self.degree.to_json(), "year": self.year.to_json() }
}
class user.Resume {
  name: string
  education: user.Education[]
  highest_degree: user.Degree
  aliases: user.EducationList
}
function user.from_json(j: baml.json.json) -> user.Resume  [expr] {
  baml.json.from_string(baml.json.stringify(j))
}
function user.to_json(self: ?) -> baml.json.json  [expr] {
  map { "name": self.name.to_json(), "education": self.education.to_json(), "highest_degree": self.highest_degree.to_json(), "aliases": self.aliases.to_json() }
}
