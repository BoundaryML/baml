function user.Calculate() -> int {
    load_const 3
    load_const 3
    mul_int
    store_var b
    load_const 3
    load_var b
    bin_op +
    load_var b
    load_const 2
    bin_op /
    load_const 1
    bin_op -
    bin_op *
    return
}

function user.FieldAccess(user: User) -> string {
    load_var user
    load_field .profile
    load_field .settings
    load_field .theme
    return
}

function user.IndexAccess(users: IndexUser[]) -> string {
    load_var users
    load_const 0
    load_array_element
    load_field .name
    return
}

