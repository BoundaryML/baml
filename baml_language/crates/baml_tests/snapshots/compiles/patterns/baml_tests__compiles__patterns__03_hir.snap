=== HIR2 ===
class user.Bird {
  name: string
}
class user.Cat {
  name: string
  indoor: bool
}
class user.Fish {
  name: string
  freshwater: bool
}
function user.test_chained_or_head_precedes_chain(x: user.Cat | user.Fish | user.Bird) -> string  [expr] {
  {  } match (x) { let y: user.Cat | user.Fish: user.Cat | user.Fish | user.Bird => "pet", _ => "other" }
}
function user.test_or_same_bindings(x: user.Cat | user.Fish) -> string  [expr] {
  {  } match (x) { Cat { name: let name } | Fish { name: let name } => name }
}
