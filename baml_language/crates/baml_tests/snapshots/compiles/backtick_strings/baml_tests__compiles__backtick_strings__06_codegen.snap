function user.BacktickInCondition() -> int {
    load_const "abc"
    call baml.String.length
    load_const 0
    cmp_op >
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 0
    jump L2

  L1:
    load_const 1

  L2:
    return
}

