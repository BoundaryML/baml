---
source: crates/baml_tests/src/generated_tests.rs
---
function user.Config.from_json(j: baml.json.json) -> Config {
    load_type Config
    load_var j
    call baml.json.to
    return
}

function user.llm.Response.from_json(j: baml.json.json) -> llm.Response {
    load_type llm.Response
    load_var j
    call baml.json.to
    return
}

function user.llm.UseConfig(cfg: Config) -> llm.Response {
    load_var cfg
    load_field .key
    init_instance user.llm.Response .text
    return
}
