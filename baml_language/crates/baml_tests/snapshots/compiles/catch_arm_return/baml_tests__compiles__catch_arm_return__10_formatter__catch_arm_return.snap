// B-246: a braceless `return` compiles cleanly as a `catch`/`match` arm value
// (it is a diverging `never`-typed expression, like `throw`). This project also
// pins the formatter: a braceless arm body wraps into `{ return …; }` and the
// output round-trips (see the `10_formatter` snapshot), covering both the
// `catch`-arm and `match`-arm wrap paths.

function may_throw(x: int) -> int throws string {
    if (x == 0) {
        throw "boom"
    }
    x
}

// Braceless `return` in a catch arm.
function via_catch(x: int) -> int {
    may_throw(x) catch (e) {
        _ => {
            return -1;
        }
    }
}

// Braceless `return` in a match arm.
function via_match(x: int) -> int {
    match (x) {
        0 => {
            return -1;
        },
        _ => x,
    }
}
