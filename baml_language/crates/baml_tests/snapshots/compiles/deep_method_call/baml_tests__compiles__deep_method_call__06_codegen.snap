function user.A.from_json(j: baml.json.json) -> A {
    load_type A
    load_var j
    call baml.json.to
    return
}

function user.B.from_json(j: baml.json.json) -> B {
    load_type B
    load_var j
    call baml.json.to
    return
}

function user.B.greet(self: B) -> string {
    load_var self
    load_field .label
    return
}

function user.test_deep_field(a: A) -> string {
    load_var a
    load_field .b
    load_field .label
    return
}

function user.test_deep_method(a: A) -> string {
    load_var a
    load_field .b
    call user.B.greet
    return
}

function user.test_direct_method(b: B) -> string {
    load_var b
    call user.B.greet
    return
}
