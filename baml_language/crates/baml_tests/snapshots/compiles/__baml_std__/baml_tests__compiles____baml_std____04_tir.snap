function baml.llm.Client.execute_once_stream<TStream, TFinal>(self: baml.llm.Client, context: baml.llm.ExecutionContext, active_delay_ms: int) -> baml.llm.Stream<TStream, TFinal> throws never {
  { : never
    match (self.client_type : baml.llm.ClientType) : never
      ClientType.Primitive =>
        { : never
          let primitive = self.to_primitive_client() : baml.llm.PrimitiveClient
          let return_type = reflect.type_of() : type
          let prompt = primitive.render_prompt(context.jinja_string, context.args, return_type) : baml.llm.PromptAst
          let specialized = primitive.specialize_prompt(prompt) : baml.llm.PromptAst
          let http_request = primitive.build_request_stream(specialized, return_type) : baml.http.Request
          let sse = root.http.fetch_sse(http_request) : baml.http.SseStream
          let stream: Stream<TStream, TFinal> = self.__make_stream(sse, context.function_name) : baml.llm.Stream<TStream, TFinal>
          return stream : baml.llm.Stream<TStream, TFinal>
        }
      ClientType.Fallback =>
        { : never
          for sub in self.sub_clients
            { : never
              let result2: Stream<TStream, TFinal> = : unknown -> baml.llm.Stream<TStream, TFinal>
                catch (sub.execute_stream(context, active_delay_ms) : baml.llm.Stream<TStream, TFinal>) : unknown
                  catch (e)
                    _ =>
                      { : never
                        continue
                      }
              return result2 : baml.llm.Stream<TStream, TFinal>
            }
          throw root.errors.DevOther { message: "All orchestration..." } : baml.errors.DevOther
        }
      ClientType.RoundRobin =>
        { : never
          if (self.sub_clients.length() == 0 : bool) : void
            { : never
              throw root.errors.DevOther { message: "RoundRobin client..." } : baml.errors.DevOther
            }
          let idx = self.counter % self.sub_clients.length() : int
          self.counter Add= 1 : int
          let result3: Stream<TStream, TFinal> = self.sub_clients[idx].execute_stream(context, active_delay_ms) : baml.llm.Stream<TStream, TFinal>
          return result3 : baml.llm.Stream<TStream, TFinal>
        }
  }
}
function baml.llm.Client.__make_stream<TStream, TFinal>(self: baml.llm.Client, sse: baml.http.SseStream, function_name: string) -> baml.llm.Stream<TStream, TFinal> throws never {
  { : baml.llm.Stream<TStream, TFinal>
    let primitive = self.to_primitive_client() : baml.llm.PrimitiveClient
    let return_type = get_return_type(function_name) : type
    let stream_return_type = get_stream_return_type(function_name) : type
    let acc = primitive.new_stream_accumulator() : baml.llm.StreamAccumulator
    let cache: StreamCache<TStream, TFinal> = StreamCache.new(return_type, stream_return_type) : baml.llm.StreamCache<TStream, TFinal>
    Stream { _client: primitive, _acc: acc, _sse: sse, _cache: cache } : baml.llm.Stream<TStream, TFinal>
  }
}
function baml.llm.Client.execute_oneshot<T>(self: baml.llm.Client, context: baml.llm.ExecutionContext, inherited_delay_ms: int) -> T throws never {
