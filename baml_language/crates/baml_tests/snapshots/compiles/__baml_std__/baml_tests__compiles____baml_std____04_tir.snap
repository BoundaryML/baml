function baml.llm.Client.execute_stream<TStream, TFinal>(self: baml.llm.Client, context: baml.llm.ExecutionContext, inherited_delay_ms: int) -> baml.llm.Stream<TStream, TFinal> throws never {
  { : never
    match (self.retry : baml.llm.RetryPolicy | null) : never
      r: RetryPolicy =>
        { : never
          let current_delay = r.initial_delay_ms + 0.0 : float
          { : void
            let attempt = 0 : 0 -> int
            while attempt <= r.max_retries
              { : never
                let attempt_delay = inherited_delay_ms : int
                if (attempt > 0 : bool) : void
                  { : void
                    attempt_delay = root.math.trunc(current_delay) : int
                    let next = current_delay * r.multiplier : float
                    if (next > r.max_delay_ms + 0.0 : bool) : void
                      { : void
                        current_delay = r.max_delay_ms + 0.0 : float
                      }
                    else
                      { : void
                        current_delay = next : float
                      }
                  }
                if (attempt == r.max_retries : bool) : void
                  { : void
                    attempt_delay = inherited_delay_ms : int
                  }
                let result2: Stream<TStream, TFinal> = : unknown -> baml.llm.Stream<TStream, TFinal>
                  catch (self.execute_once_stream(context, attempt_delay) : baml.llm.Stream<TStream, TFinal>) : unknown
