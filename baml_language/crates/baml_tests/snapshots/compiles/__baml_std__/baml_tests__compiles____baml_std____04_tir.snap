function baml.llm.Client.build_plan_with_state(self: baml.llm.Client, planner_state: baml.llm.PlannerState) -> baml.llm.OrchestrationStep[] throws never {
  { : baml.llm.OrchestrationStep[]
    match (self.retry : baml.llm.RetryPolicy | null) : baml.llm.OrchestrationStep[]
      r: RetryPolicy =>
        { : baml.llm.OrchestrationStep[]
          let result: OrchestrationStep[] = [] : baml.llm.OrchestrationStep[]
          let current_delay = r.initial_delay_ms + 0.0 : float
          { : void
            let attempt = 0 : 0 -> int
            while attempt <= r.max_retries
              { : void
                let delay = 0 : 0 -> int
                if (attempt > 0 : bool) : void
                  { : void
                    delay = root.math.trunc(current_delay) : int
                    let next = current_delay * r.multiplier : float
                    if (next > r.max_delay_ms + 0.0 : bool) : void
                      { : void
                        current_delay = r.max_delay_ms + 0.0 : float
                      }
                    else
                      { : void
                        current_delay = next : float
                      }
                  }
                let inner = self.build_attempt_with_state(planner_state) : baml.llm.OrchestrationStep[]
                for step in inner
                  { : void
                    result.push(OrchestrationStep { primitive_client: step.primitive_client, delay_ms: delay }) : int
                  }
              }
          }
          result : baml.llm.OrchestrationStep[]
