function baml.llm.Client.execute_once_oneshot<T>(self: baml.llm.Client, context: baml.llm.ExecutionContext, active_delay_ms: int) -> T throws never {
  { : T
    match (self.client_type : baml.llm.ClientType) : T
      ClientType.Primitive =>
        { : T
          let primitive = self.to_primitive_client() : baml.llm.PrimitiveClient
          let return_type = reflect.type_of() : type
          let prompt = primitive.render_prompt(context.jinja_string, context.args, return_type) : baml.llm.PromptAst
          let specialized = primitive.specialize_prompt(prompt) : baml.llm.PromptAst
          let http_request = primitive.build_request(specialized, return_type) : baml.http.Request
          let http_response = root.http.send(http_request) : baml.http.Response
          if (http_response.ok() : bool) : T
            { : T
              let body = http_response.text() : string
              let result: T = : unknown -> T
                catch (primitive.parse<T>(body) : T) : unknown
                  catch (e)
                    _ =>
                      { : never
                        if (active_delay_ms > 0 : bool) : void
                          { : null
                            root.sys.sleep(active_delay_ms) : null
                          }
                        throw e : baml.errors.LlmClient
                      }
              result : T
            }
          else
            { : never
              let error_body = : string | "" -> string
                catch (http_response.text() : string) : string | ""
                  catch (e)
                    _ =>
                      { : ""
                        "" : ""
                      }
              if (active_delay_ms > 0 : bool) : void
                { : null
                  root.sys.sleep(active_delay_ms) : null
                }
              throw root.errors.DevOther { message: "HTTP request fail..." + error_body } : baml.errors.DevOther
            }
        }
      ClientType.Fallback =>
        { : never
          for sub in self.sub_clients
            { : never
              let result2: T = : unknown -> T
                catch (sub.execute_oneshot<T>(context, active_delay_ms) : T) : unknown
                  catch (e)
                    _ =>
                      { : never
                        continue
                      }
              return result2 : T
            }
          throw root.errors.DevOther { message: "All orchestration..." } : baml.errors.DevOther
        }
      ClientType.RoundRobin =>
        { : never
          if (self.sub_clients.length() == 0 : bool) : void
            { : never
              throw root.errors.DevOther { message: "RoundRobin client..." } : baml.errors.DevOther
            }
          let idx = self.counter % self.sub_clients.length() : int
          self.counter Add= 1 : int
          let result3: T = self.sub_clients[idx].execute_oneshot<T>(context, active_delay_ms) : T
          return result3 : T
