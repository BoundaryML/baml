function baml.llm.render_prompt(client: baml.llm.Client, function_name: string, args: map<string, unknown>) -> baml.llm.PromptAst throws never {
  { : baml.llm.PromptAst
    let jinja_string = get_jinja_template(function_name) : string
    let return_type = get_return_type(function_name) : type
    let primitive_client = client.to_primitive_client() : baml.llm.PrimitiveClient
    let prompt = primitive_client.render_prompt(jinja_string, args, return_type) : baml.llm.PromptAst
    primitive_client.specialize_prompt(prompt) : baml.llm.PromptAst
  }
}
function baml.llm.build_request(client: baml.llm.Client, function_name: string, args: map<string, unknown>) -> baml.http.Request throws never {
  { : baml.http.Request
    let primitive_client = client.to_primitive_client() : baml.llm.PrimitiveClient
    let specialized_prompt = render_prompt(client, function_name, args) : baml.llm.PromptAst
    primitive_client.build_request(specialized_prompt) : baml.http.Request
  }
}
function baml.llm.build_request_stream(client: baml.llm.Client, function_name: string, args: map<string, unknown>) -> baml.http.Request throws never {
  { : baml.http.Request
    let primitive_client = client.to_primitive_client() : baml.llm.PrimitiveClient
    let specialized_prompt = render_prompt(client, function_name, args) : baml.llm.PromptAst
    primitive_client.build_request_stream(specialized_prompt) : baml.http.Request
  }
}
function baml.llm.parse<T, S>(function_name: string, json: string) -> T throws never {
  { : T
    let return_type = get_return_type(function_name) : type
    let stream_return_type = get_stream_return_type(function_name) : type
    let cache = StreamCache.new(return_type, stream_return_type) : baml.llm.StreamCache<T, S>
    __sap_parse_final<T>(json, cache) : T
  }
}
function baml.llm.call_llm_function<T>(client: baml.llm.Client, function_name: string, args: map<string, unknown>) -> T throws never {
  { : T
    let jinja_string = get_jinja_template(function_name) : string
    let context = ExecutionContext { jinja_string: jinja_string, args: args, function_name: function_name } : baml.llm.ExecutionContext
    let result: T = client.execute_oneshot<T>(context, 0) : T
    result : T
  }
}
function baml.llm.stream_llm_function<T, S>(client: baml.llm.Client, function_name: string, args: map<string, unknown>) -> baml.llm.Stream<T, S> throws never {
