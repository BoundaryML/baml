}
function baml.time.max(self: ?, other: baml.time.Instant) -> baml.time.Instant  [expr] {
  {  } if (other._nanoseconds Gt self._nanoseconds) {  } other else {  } self
}
function baml.time.min(self: ?, other: baml.time.Instant) -> baml.time.Instant  [expr] {
