function user.Box.from_json(j: baml.json.json) -> Box<T> {
    load_type Box<#0>
    load_var j
    call baml.json.to
    return
}

function user.User.from_json(j: baml.json.json) -> User {
    load_type User
    load_var j
    call baml.json.to
    return
}

function user.test_generic_capture(box: Box<User>) -> string {
    load_var ?1
    make_cell
    store_var ?1
    load_var box
    make_closure .<lambda(test_generic_capture, 0)>, 1
    call_indirect
    return
}

function user.test_generic_chain(box: Box<User>) -> string {
    load_var box
    load_field .value
    load_field .0
    return
}

function user.test_nested_generic_chain(box: Box<Box<User>>) -> string {
    load_var box
    load_field .value
    load_field .0
    load_field .0
    return
}
