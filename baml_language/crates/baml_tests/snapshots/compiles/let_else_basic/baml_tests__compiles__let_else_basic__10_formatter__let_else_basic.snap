// Rust-style `let ... else` — refutable pattern with a diverging else block.
// The else block must end in `return`/`throw`; bindings flow into the rest
// of the enclosing scope on the success path.

// Narrow a union via let-else; on the non-int branch we early-return.
function narrow_or_default(v: int | string) -> int {
    let n: int = v else {
        return 0;
    };
    n
}

// Multiple let-else statements in series — each independently narrows.
function chain_two(v: int | string, w: int | string) -> int {
    let a: int = v else {
        return -1;
    };
    let b: int = w else {
        return -2;
    };
    a + b
}

// Let-else's else block can throw too — `throw` is also divergent.
function narrow_or_throw(v: int | string) -> int {
    let n: int = v else {
        throw "expected int";
    };
    n
}
