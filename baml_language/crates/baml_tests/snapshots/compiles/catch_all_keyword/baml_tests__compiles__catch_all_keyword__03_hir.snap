=== HIR2 ===
function user.CatchAllTyped(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch_all (e) { string => "caught string", int => "caught int" }
}
function user.CatchAllWildcard(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch_all (e) { _ => "caught all" }
}
function user.CatchThenCatchAll(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch (e) { string => "caught string" } catch_all (e2) { _ => "caught rest" }
}
function user.MayFailIntOrString(x: int) -> string  [expr] {
  {  } match (x) { 0 => throw "string error", 1 => throw 42, _ => "ok" }
}
function user.PartialCatch(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch (e) { string => "caught string" }
}
