function user.AppConfig.from_json(j: baml.json.json) -> AppConfig {
    load_type AppConfig
    load_var j
    call baml.json.to
    return
}

function user.CallOpenAI(cfg: AppConfig) -> llm.openai.OpenAIResponse {
    load_const "response"
    load_const "gpt-4"
    init_instance user.llm.openai.OpenAIResponse .text, .model
    return
}

function user.llm.openai.OpenAIResponse.from_json(j: baml.json.json) -> llm.openai.OpenAIResponse {
    load_type llm.openai.OpenAIResponse
    load_var j
    call baml.json.to
    return
}
