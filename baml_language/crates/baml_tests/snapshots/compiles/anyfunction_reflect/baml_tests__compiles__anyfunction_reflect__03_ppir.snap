  { let f: baml.AnyFunction = web_search; let g: baml.AnyFunction<Returns = user.Doc[] | string, Throws = user.ToolError> = web_search; let widened: baml.AnyFunction<Returns = user.Doc[] | string | int, Throws = user.ToolError> = g; let bare: baml.AnyFunction = g; return 0 }
