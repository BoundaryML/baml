class testing.FlatTestReport {
  outcome: testing.Outcome
  passed: int
  failed: int
  total: int
  failed_names: string[]
  messages: string[]
  results: testing.FlatTestResult[]
}
class testing.FlatTestResult {
  name: string
  outcome: testing.Outcome
  messages: string[]
  duration_ms: int
  run_count: int
}
class testing.NamedChildReport {
  name: string
  report: testing.ChildReport
}
class testing.RunReport {
  outcome: testing.Outcome
  duration_ms: int
  message: string?
}
class testing.TestReport {
  outcome: testing.Outcome
  runs: testing.RunReport[]
}
class testing.TestSetChild {
  name: string
  run: testing.ChildReportThunk
}
class testing.TestSetReport {
  outcome: testing.Outcome
  passed: int
  failed: int
  total: int
  failed_names: string[]
  results: testing.ChildReport[]
}
type testing.ChildReport = testing.TestReport | testing.TestSetReport
type testing.ChildReportThunk = () -> testing.ChildReport throws never
type testing.Outcome = "pass" | "fail" | "error"
type testing.TestBody = () -> void throws unknown
type testing.TestReportThunk = () -> testing.TestReport throws never
type testing.TestRunner = (testing.TestReportThunk) -> testing.TestReportThunk throws never
type testing.TestSetBody = (TestCollector) -> void throws unknown
type testing.TestSetReportThunk = () -> testing.TestSetReport throws never
type testing.TestSetRunner = (testing.TestSetChild[]) -> testing.TestSetReport throws never
