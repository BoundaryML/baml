  { let passed = 0; let failed = 0; let has_error = false; let failed_names: string[] = []; let results: ChildReport[] = []; for named_result in named_results { let result = named_result.report; results.push(result); let outcome = match (result) { report: TestReport => report.outcome, report: TestSetReport => report.outcome } } if (outcome Eq "pass") { passed Add= 1 } else { failed Add= 1; let child_failed_names = match (result) { report: TestReport => [named_result.name], report: TestSetReport => if (report.failed_names.length() Gt 0) {  } report.failed_names else {  } [named_result.name] }; for name in child_failed_names {  } failed_names.push(name) } if (outcome Eq "error") { has_error = true } else {  } null; let outcome: Outcome = if (has_error) {  } "error" else if (failed Eq 0) {  } "pass" else {  } "fail" } TestSetReport { outcome: outcome, passed: passed, failed: failed, total: results.length(), failed_names: failed_names, results: results }
}
