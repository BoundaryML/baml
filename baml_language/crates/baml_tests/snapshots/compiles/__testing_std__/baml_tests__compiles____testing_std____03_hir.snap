function testing.FailFast() -> TestSetRunner  [expr] {
  { return (children) -> TestSetReport { {  } root.run_children_sequential(children, true) } }
}
function testing.PassRate(threshold: float) -> TestSetRunner  [expr] {
  { if (threshold Lt 0.0 Or threshold Gt 1.0) {  } baml.sys.panic("testing.PassRate ...") else {  } null; return (children) -> TestSetReport { { let report = root.run_children_parallel(children); let outcome: Outcome = if (report.total Eq 0) {  } "pass" else if (root._int_to_float(report.passed) Div root._int_to_float(report.total) Ge threshold) {  } "pass" else {  } "fail" } TestSetReport { outcome: outcome, passed: report.passed, failed: report.failed, total: report.total, failed_names: report.failed_names, results: report.results } } }
}
function testing.Quorum(n: int, m: int) -> TestRunner  [expr] {
  { if (n Le 0) {  } baml.sys.panic("testing.Quorum re...") else if (m Lt 0 Or m Gt n) {  } baml.sys.panic("testing.Quorum re...") else {  } null; return (run_once) -> TestReportThunk { {  } () -> TestReport { { let runs: RunReport[] = []; let passes = 0; { let i = 0; while i Lt n { let report = run_once(); for run in report.runs {  } runs.push(run) } if (report.outcome Eq "pass") { passes Add= 1 } else {  } null }; let outcome: Outcome = if (passes Ge m) {  } "pass" else {  } "fail" } TestReport { outcome: outcome, runs: runs } } } }
}
function testing.Retry(max_attempts: int) -> TestRunner  [expr] {
  { if (max_attempts Le 0) {  } baml.sys.panic("testing.Retry req...") else {  } null; return (run_once) -> TestReportThunk { {  } () -> TestReport { { let runs: RunReport[] = []; let passed = false; let attempts = 0; while attempts Lt max_attempts And Not passed { let report = run_once(); attempts Add= 1; for run in report.runs {  } runs.push(run) } if (report.outcome Eq "pass") { passed = true } else {  } null; let outcome: Outcome = if (passed) {  } "pass" else {  } "fail" } TestReport { outcome: outcome, runs: runs } } } }
}
function testing.Sequential() -> TestSetRunner  [expr] {
  { return (children) -> TestSetReport { {  } root.run_children_sequential(children, false) } }
}
function testing._int_to_float(value: int) -> float  [expr] {
  {  } float.parse(baml.unstable.string(value)) catch_all (e) { _ => baml.sys.panic("failed to convert...") }
}
function testing.run_children_sequential(children: TestSetChild[], fail_fast: bool) -> TestSetReport  [expr] {
  { let named_results: NamedChildReport[] = []; for child in children { let report = child.run(); named_results.push(NamedChildReport { name: child.name, report: report }); let outcome = match (report) { r: TestReport => r.outcome, r: TestSetReport => r.outcome } } if (fail_fast And outcome Ne "pass") { return root.aggregate_reports(named_results) } else {  } null } root.aggregate_reports(named_results)
}

