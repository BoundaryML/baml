class testing.RunReport {
  outcome: testing.Outcome
  duration_ms: int
}
class testing.TestReport {
  outcome: testing.Outcome
  runs: testing.RunReport[]
}
class testing.TestSetReport {
  outcome: testing.Outcome
  passed: int
  failed: int
  total: int
  results: testing.ChildReport[]
}
type testing.ChildReport = testing.TestReport | testing.TestSetReport
type testing.Outcome = "pass" | "fail" | "error"
type testing.TestBody = () -> void throws unknown
type testing.TestReportThunk = () -> testing.TestReport throws never
type testing.TestRunner = (testing.TestReportThunk) -> testing.TestReportThunk throws never
type testing.TestSetBody = (testing.TestCollector) -> void throws unknown
type testing.TestSetReportThunk = () -> testing.TestSetReport throws never
type testing.TestSetRunner = (testing.TestSetReportThunk) -> testing.TestSetReportThunk throws never
