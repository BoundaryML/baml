            ts.collector(sub_collector) : void
            let elapsed = baml.sys.now_ms() - start : int
            let sub_registry = TestRegistry { collector: sub_collector, expansions: map {  }, loading_time_ms: elapsed } : testing.TestRegistry
            self.expansions.set(name, sub_registry) : testing.TestRegistry?
