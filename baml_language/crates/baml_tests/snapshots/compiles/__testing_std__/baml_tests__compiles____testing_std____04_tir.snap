function testing.glob_match(subject: string, pattern: string) -> bool throws never {
  { : true
    let parts = pattern.split("*") : string[]
    let n = parts.length() : int
    if (n == 1 : bool) : void
      { : never
        return subject.index_of(pattern) != null : bool
      }
    let first = parts[0] : string
    let last = parts[n - 1] : string
    if (Not subject.starts_with(first) : bool) : void
      { : never
        return false : false
      }
    if (Not subject.ends_with(last) : bool) : void
      { : never
        return false : false
      }
    let start = first.length() : int
    let end_limit = subject.length() - last.length() : int
    if (start > end_limit : bool) : void
      { : never
        return false : false
      }
    let pos = start : int
    { : void
      let i = 1 : 1 -> int
      while i < n - 1
        { : void
          let part = parts[i] : string
          if (part != "" : bool) : void
            { : void
              if let <pat> = subject.substring(pos, end_limit).index_of(part) { 1 stmts } else { 1 stmts } : void
            }
        }
    }
    true : true
  }
}
function testing.any_pattern_matches(pats: string[], canonical_id: string) -> bool throws never {
  { : false
