function testing.subtree_excluded(prefix: string, excludes: string[]) -> bool throws never {
  { : false
    let descendant_prefix = prefix + "::" : string
    for pattern in excludes
      { : void
        if (pattern.index_of("*") == null && descendant_prefix.index_of(pattern) != null : bool) : void
          { : never
            return true : true
          }
        if (pattern.ends_with("*") && root.glob_match(descendant_prefix, pattern) : bool) : void
          { : never
            return true : true
          }
      }
    false : false
  }
}
function testing.pattern_may_match_descendant(pattern: string, prefix: string) -> bool throws never {
  { : true | bool
    let descendant_prefix = prefix + "::" : string
    match (pattern.index_of("*") : int | null) : true | bool
      null =>
        true : true
      star: int =>
        { : bool
          let literal = pattern.substring(0, star) : string
          descendant_prefix.starts_with(literal) || literal.starts_with(descendant_prefix) : bool
        }
  }
}
function testing.subtree_may_be_selected(prefix: string, include: string[], exclude: string[]) -> bool throws never {
