        null : null
      }
    return : (run_once: testing.TestReportThunk) -> testing.TestReportThunk throws never
      (run_once) -> TestReportThunk { ... } : (run_once: testing.TestReportThunk) -> testing.TestReportThunk throws never
        {
          () -> TestReport { ... }
            {
              let runs: RunReport[] = []
              let passed = false
              let attempts = 0
              while (attempts < max_attempts && Not passed)
                {
                  let report = run_once()
                  attempts Add= 1
                  for run in report.runs
                    {
                      runs.push(run)
                    }
                  if (report.outcome == "pass")
                    {
                      passed = true
                    }
                  else
                    {
                      null
                    }
                }
              let outcome: Outcome = ...
                if (passed)
                  {
                    "pass"
                  }
                else
                  {
                    "fail"
                  }
              TestReport { outcome: outcome, runs: runs }
            }
        }
  }
}
