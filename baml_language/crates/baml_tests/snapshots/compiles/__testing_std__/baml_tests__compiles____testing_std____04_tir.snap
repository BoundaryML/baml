function testing.aggregate_reports(named_results: testing.NamedChildReport[]) -> testing.TestSetReport throws never {
  { : testing.TestSetReport
    let passed = 0 : 0 -> int
    let failed = 0 : 0 -> int
    let has_error = false : false -> bool
    let failed_names: string[] = [] : string[]
    let results: ChildReport[] = [] : testing.ChildReport[]
    let result_names: string[] = [] : string[]
    for named_result in named_results
      { : void
        let result = named_result.report : testing.ChildReport
        results.push(result) : int
        result_names.push(named_result.name) : int
        let outcome = : testing.Outcome
          match (result : testing.ChildReport) : testing.Outcome
            report: TestReport =>
              report.outcome : testing.Outcome
            report: TestSetReport =>
              report.outcome : testing.Outcome
        if (outcome == "pass" : bool) : void
          { : void
            passed Add= 1 : int
          }
        else
          { : void
            failed Add= 1 : int
            let child_failed_names = : string[]
              match (result : testing.ChildReport) : string[]
                report: TestReport =>
                  [named_result.name] : string[]
                report: TestSetReport =>
                  if (report.failed_names.length() > 0 : bool) : string[]
                    { : string[]
                      report.failed_names : string[]
                    }
                  else
                    { : string[]
                      [named_result.name] : string[]
                    }
            for name in child_failed_names
              { : int
                failed_names.push(name) : int
              }
            if (outcome == "error" : bool) : void
              { : void
                has_error = true : true
              }
            else
              { : null
                null : null
              }
          }
      }
    let outcome: Outcome = : "error" | "pass" | "fail" -> "error" | "fail" | "pass"
      if (has_error : bool) : "error" | "pass" | "fail"
        { : "error"
          "error" : "error"
        }
      else
        if (failed == 0 : bool) : "pass" | "fail"
          { : "pass"
            "pass" : "pass"
          }
        else
          { : "fail"
            "fail" : "fail"
          }
    TestSetReport { outcome: outcome, passed: passed, failed: failed, total: results.length(), failed_names: failed_names, results: results, result_names: result_names } : testing.TestSetReport
  }
}
