                    }
                  else
                    { : testing.LeafCounts
                      LeafCounts { passed: tsr.passed, failed: tsr.failed, tolerated: 0, total: tsr.total } : testing.LeafCounts
                    }
              }
        passed Add= delta.passed : int
        failed Add= delta.failed : int
        tolerated Add= delta.tolerated : int
        total Add= delta.total : int
      }
    LeafCounts { passed: passed, failed: failed, tolerated: tolerated, total: total } : testing.LeafCounts
