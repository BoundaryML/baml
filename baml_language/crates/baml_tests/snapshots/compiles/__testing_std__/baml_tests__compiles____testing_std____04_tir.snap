function testing.Quorum(n: int, m: int) -> testing.TestRunner throws never {
  { : never
    if (n <= 0 : bool) : null
      { : never
        baml.sys.panic("testing.Quorum re...") : never
      }
    else
      if (m < 0 || m > n : bool) : null
        { : never
          baml.sys.panic("testing.Quorum re...") : never
        }
      else
        { : null
          null : null
        }
    return : (run_once: testing.TestReportThunk) -> testing.TestReportThunk throws never
      (run_once) -> TestReportThunk { ... } : (run_once: testing.TestReportThunk) -> testing.TestReportThunk throws never
        {
          () -> TestReport { ... }
            {
              let runs: RunReport[] = []
              let passes = 0
              {
                let i = 0
                while (i < n)
                  {
                    let report = run_once()
                    for run in report.runs
                      {
                        runs.push(run)
                      }
                    if (report.outcome == "pass")
                      {
                        passes Add= 1
                      }
                    else
                      {
                        null
                      }
                  }
              }
              let outcome: Outcome = ...
                if (passes >= m)
                  {
                    "pass"
                  }
                else
                  {
                    "fail"
                  }
              TestReport { outcome: outcome, runs: runs }
            }
        }
  }
}
