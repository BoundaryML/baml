      { : null
        null : null
      }
    return : (children: testing.TestSetChild[]) -> testing.TestSetReport throws never
      (children) -> TestSetReport { ... } : (children: testing.TestSetChild[]) -> testing.TestSetReport throws never
        {
          let report = root.run_children_parallel(children)
          let outcome: Outcome = ...
            if (report.total == 0)
              {
                "pass"
              }
            else
              if (root._int_to_float(report.passed) / root._int_to_float(report.total) >= threshold)
                {
                  "pass"
                }
              else
                {
                  "fail"
                }
          TestSetReport { outcome: outcome, passed: report.passed, failed: report.failed, total: report.total, failed_names: report.failed_names, results: report.results }
        }
  }
}
