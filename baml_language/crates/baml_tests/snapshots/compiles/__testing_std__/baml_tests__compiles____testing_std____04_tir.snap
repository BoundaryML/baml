function testing.run_test(body: testing.TestBody, runner: testing.TestRunner | null) -> testing.TestReport throws never {
  { : testing.TestReport
    let base_run: TestReportThunk = : () -> testing.TestReport throws never
      () -> TestReport { ... } : () -> testing.TestReport throws never
        {
          let start = baml.time.Instant.now()
          let result = ...
            { 1 stmts + tail } catch_all (e) { p: baml.panics.UserPanic => { 0 stmts + tail }, p: baml.panics.AssertionFailed => { 0 stmts + tail }, baml.panics.Panic => { 0 stmts + tail }, _ => { 0 stmts + tail } }
          let duration = ...
            start.elapsed().to_milliseconds().to_int() catch (_) { baml.errors.InvalidArgument { message: message } => baml.sys.panic("testing: test dur..." + message) }
          TestReport { outcome: result.outcome, runs: [RunReport { outcome: result.outcome, duration_ms: duration, message: result.message }] }
        }
    match (runner : testing.TestRunner | null) : testing.TestReport
      null =>
        base_run() : testing.TestReport
      r: TestRunner =>
        { : testing.TestReport
          let wrapped: TestReportThunk = r(base_run) : () -> testing.TestReport throws never
          wrapped() : testing.TestReport
        }
  }
}
