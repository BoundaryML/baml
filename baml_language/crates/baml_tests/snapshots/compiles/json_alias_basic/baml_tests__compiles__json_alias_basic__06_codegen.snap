function user.MakeWrapper() -> Wrapper {
    load_const null
    init_instance user.Wrapper .data
    return
}

function user.MatchJson(j: baml.json.json) -> string {
    load_var j
    type_tag
    jump_table [L4, L2, L5, L6, L3, _, L1, L0], default L8

  L0: map
    load_const "map"
    jump L7

  L1: list
    load_const "array"
    jump L7

  L2: string
    load_const "string"
    jump L7

  L3: float
    load_const "float"
    jump L7

  L4: int
    load_const "int"
    jump L7

  L5: bool
    load_const "bool"
    jump L7

  L6: null
    load_const "null"

  L7:
    return

  L8:
    unreachable
}

