class user.foo {
  x: int
}
function user.from_json(j: baml.json.json) -> user.foo  [expr] {
  user.foo { x: baml.json.from_json(baml.json.field(j, "x")) }
}
function user.to_json(self: ?) -> baml.json.json  [expr] {
  map { "x": baml.json.to_json(self.x) }
}
function user.to_string(self: ?) -> string  [expr] {
  baml.unstable.string(self)
}
