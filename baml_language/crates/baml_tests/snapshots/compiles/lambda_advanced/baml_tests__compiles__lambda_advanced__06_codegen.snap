function user.test_shadowing() -> string {
    load_const "999"
    store_var x
    load_const 1
    load_const 2
    load_const 3
    alloc_array 3
    make_closure .<lambda(test_shadowing, 0)>, 0
    call baml.Array.map
    store_var _5
    load_const 0
    store_var __for_idx

  L0:
    load_var __for_idx
    load_var _5
    call baml.Array.length
    cmp_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var x
    return

  L2:
    load_var _5
    load_var __for_idx
    load_array_element
    store_var y
    load_const 0
    store_var i

  L3:
    load_var i
    load_var y
    cmp_op <
    pop_jump_if_false L4
    jump L5

  L4:
    load_var __for_idx
    load_const 1
    add_int
    store_var __for_idx
    jump L0

  L5:
    load_var x
    load_const "1"
    bin_op +
    store_var x
    load_var i
    load_const 1
    add_int
    store_var i
    jump L3
}

