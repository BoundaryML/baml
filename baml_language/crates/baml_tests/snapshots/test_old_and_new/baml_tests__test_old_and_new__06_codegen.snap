function user.$init_test(registry: testing.Registry) -> null {
    load_const "new style"
    make_closure .<lambda($init_test, 0)>, 0
    load_const null
    load_var registry
    load_const "register_test"
    load_map_element
    call_indirect
    pop 1
    load_const null
    return
}

function user.Greet(name: string) -> string {
    load_const "Hello, {name}!"
    return
}
