// BEP-049 §7 + §11: backtick interpolation is strict-typed. Values
// interpolated with `${...}` are wrapped with `.to_string()` at lowering;
// if the type doesn't have a `to_string` method, the compiler errors at
// type-check time rather than silently rendering "null" / "<undefined>" /
// some other invented form.
//
// Quote from BEP §7 (rationale for strict-bool truthiness): "It also
// surfaces null-handling bugs in prompts at type-check time instead of
// at LLM-call time." Same logic applies to null and missing-to_string
// interpolation: the error fires before the LLM is ever called.
//
// This fixture pins the diagnostic wording for the three canonical cases:
//   (A) null literal interpolation
//   (B) custom class without a to_string method
//   (E) optional (nullable) primitive interpolation

// (A) Interpolating a `null` literal.
function case_a_null_interp() -> string {
    let x: int? = null;
    `val: ${x}`
}

// (B) Interpolating an instance of a class that has no to_string method.
class FooNoToString {
    x: int,
}

function case_b_class_without_to_string() -> string {
    let f = FooNoToString { x: 1 };
    `val: ${f}`
}

// (E) Interpolating an optional/nullable primitive. Same root cause as (A):
// `int?` has no direct `to_string`; the user must coalesce or unwrap first.
function get_count() -> int? {
    42
}

function case_e_optional_int_interp() -> string {
    let c = get_count();
    `count: ${c}`
}
