// Two or more class fields that serialize to the same JSON key produce an
// unsatisfiable schema (B-615): `ctx.output_format()` renders duplicate keys and
// a required shadowed field can never be parsed. Each of these classes must be
// rejected with E0149.

// Case 1: two fields share the same @alias value.
class AliasVsAlias {
    a: string @alias("x"),
    b: string @alias("x"),
}

// Case 2: a field's declared name equals another field's @alias.
class NameVsAlias {
    x: string,
    b: string @alias("x"),
}

// Case 3: three fields collapse onto one key via a mix of the above.
class TripleCollision {
    first: string @alias("shared"),
    second: string @alias("shared"),
    shared: string,
}

// Case 4: a double-quoted alias and a raw-string alias normalize to the same
// value and collide.
class NormalizedCollision {
    a: string @alias("q"),
    b: string @alias(#"q"#),
}

// ─── Controls: these must NOT be flagged ─────────────────────────────────────

// A field whose alias equals its OWN name is fine (single occupant of key `a`).
class AliasEqualsOwnName {
    a: string @alias("a"),
    b: string,
}

// A @skip'd field is excluded from the schema, so it cannot collide.
class SkippedDoesNotCollide {
    a: string @alias("x"),
    b: string @alias("x") @skip,
}

// Distinct aliases, distinct names — no collision.
class AllDistinct {
    a: string @alias("alpha"),
    b: string @alias("beta"),
    c: string,
}
