  baml.llm.call_llm_function(GPT4, "HelloWorld", map { "name": name })
}
function user.HelloWorld$build_request(name: string) -> baml.http.Request  [expr] {
  baml.llm.build_request(GPT4, "HelloWorld", map { "name": name })
}
