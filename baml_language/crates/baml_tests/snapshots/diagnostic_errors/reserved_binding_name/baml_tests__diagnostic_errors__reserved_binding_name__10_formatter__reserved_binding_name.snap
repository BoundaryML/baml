// The compiler spells `baml` in the paths its desugars emit (`spawn { .. }`
// lowers to `baml.spawn.Plan.new(..)`, `env.X` to `baml.env.ref(..)`), and
// those paths resolve in the user's own scope. A binding named `baml`, a value
// or a body `type`, wins over the package, so every desugared path in its scope
// would fail. The binding is refused instead.

function local_binding() -> int {
    let baml = 5;
    baml
}

function parameter(baml: int) -> int throws never {
    baml
}

function lambda_parameter() -> int throws never {
    let f = (baml: int) -> int throws never {
        baml
    };
    f(1)
}

class Box {
    baml: int,
}

function destructured(b: Box) -> int throws never {
    let Box { baml } = b;
    baml
}

function for_in_binding(xs: int[]) -> int throws never {
    let total = 0;
    for (let baml in xs) {
        total += baml;
    }
    total
}

function catch_binding() -> string {
    {
        throw "x"
    } catch (baml) {
        _ => "caught"
    }
}

function static_type_binding() -> int throws never {
    type baml = int;
    1
}

function runtime_type_binding(t: reflect.Type) -> int throws never {
    type baml = unreflect(t);
    1
}

// A refused binding is reported once, at its name. Nothing in its scope
// reports because of it: a value binding reads as an error type wherever it
// is used (so the desugared `spawn` and `env.X` paths stay silent, while the
// task body is still checked), and a refused `type` binding never enters
// scope, so `spawn` keeps its meaning.
function refused_value_in_scope() -> int {
    let baml = 5;
    let task = spawn { 1 };
    let home = env.HOME;
    baml + 1
}

function refused_parameter_in_scope(baml: int) -> int {
    let task = spawn { 1 };
    baml
}

function refused_type_in_scope() -> int throws never {
    type baml = int;
    let task = spawn { 1 };
    1
}

function task_body_still_checked() -> int {
    let baml = 5;
    let task = spawn { undefined_in_body + 1 };
    0
}

// An ITEM may still take the name: an item does not shadow a package root the
// way a local does, so these are legal and produce no diagnostic.
class baml {
    label: string,
}

function baml_item() -> int throws never {
    7
}

// Only the roots the compiler emits are reserved. `#4543` ruled that a
// language root is otherwise an ordinary package a user name may shadow, so a
// local named `reflect` stays legal (pinned by `ns_fixtures/ns_reflect_shadowing`).
function reflect_local() -> int throws never {
    let reflect = 1;
    reflect + 1
}
