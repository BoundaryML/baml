type TpZeroPair = (0, 0);

function type_test_never_matches(t: (int, int), u: (int, int)) -> bool {
    let nested = match (t, 1) {
        ((0, 0), _) => true,
        _ => false,
    };
    let held = (t, 1);
    match (t) {
        (0, 0) => true,
        let z: (0, 0) => true,
        let a: TpZeroPair => true,
        _ => nested || held.0 is (0, 0) || u is (int?, int),
    }
}

