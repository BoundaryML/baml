// The legacy `@@dynamic` block attribute was removed with the TypeBuilder
// feature by BEP-066 (runtime type construction is `baml.reflect` now).
// It used to silently no-op; each use must surface E0098 instead.

class DynamicClass {
    name: string,
    @@dynamic
}

enum DynamicEnum {
    Red,
    Green,
    @@dynamic
}

// Unknown block attributes are still passed through silently; only the
// removed `@@dynamic` is rejected. Dotted names that merely contain the
// word (`@@stream.dynamic`) are not affected.
class OtherAttrs {
    name: string,
    @@some_future_attribute
    @@stream.dynamic
}
