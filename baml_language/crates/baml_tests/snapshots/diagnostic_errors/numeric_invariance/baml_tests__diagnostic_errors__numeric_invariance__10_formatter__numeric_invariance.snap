---
source: crates/baml_tests/src/generated_tests.rs
---
// Regression tests for numeric subtyping invariance.
//
// Numeric types do not widen across representations in the type system. `int`
// is not a subtype of `bigint` (i64 vs heap BigInt) or `float` (i64 values past
// 2^53 are not exactly representable as f64). The only conversions are the
// `bigint × int` operators and the FFI boundary — never an implicit move or
// subtype coercion. `List`/`Map` are invariant for the same reason.

// Scalar int -> float is rejected.
function IntToFloat(x: int) -> float {
    x
}

// An int *literal* into a float slot is also rejected; write `1.0` explicitly.
function IntLiteralToFloat() -> float {
    1
}

// Scalar int -> bigint is rejected; write `1n` (or convert via an operator /
// the FFI boundary).
function IntToBigint(x: int) -> bigint {
    x
}

// An int *literal* into a bigint slot is also rejected; write `1n`.
function IntLiteralToBigint() -> bigint {
    1
}

// An `int[]` variable is not assignable to a `bigint[]` slot.
function IntArrayToBigintArray() -> bigint[] {
    let a = [1, 2];
    a
}

// A non-empty int-literal array does not satisfy a `bigint[]` slot directly;
// the element literals must be written as `bigint` (`[1n, 2n]`).
function IntLiteralArrayToBigint() -> bigint[] {
    [1, 2]
}

// `int[]` is not assignable to `float[]`.
function IntArrayToFloatArray() -> float[] {
    let a = [1, 2];
    a
}

// Nested: `int[][]` is not assignable to `bigint[][]`.
function NestedIntArrayToBigint() -> bigint[][] {
    [[1], [2]]
}

// `map<string, int>` is not assignable to `map<string, bigint>`.
function IntMapToBigintMap() -> map<string, bigint> {
    let m = { "a": 1 };
    m
}

// A map literal with int values does not satisfy a `map<string, bigint>` slot.
function IntMapLiteralToBigint() -> map<string, bigint> {
    { "a": 1 }
}

// Arithmetic with an Optional operand is invalid — `null + int` has no
// meaningful result; the user must unwrap first.
function OptionalIntPlusInt(x: int?, y: int) -> int {
    x + y
}

// Bitwise with an Optional operand is invalid for the same reason.
function OptionalIntAndInt(x: int?, y: int) -> int {
    x & y
}

// Ordering between an Optional and a non-null operand is invalid —
// `null < int` has no meaningful ordering. Equality (`==`/`!=`) is the
// idiom for null-checking and remains permissive.
function OptionalIntLtInt(x: int?, y: int) -> bool {
    x < y
}

// Float vs bigint equality, even through an Optional, is always `false`: no
// `float?` value can equal a `bigint` (they are disjoint — `float? | bigint`
// only pairs disjoint members). `==`/`!=` are permissive across types, so this
// is a "comparison is always false" *warning*, not a hard error.
function OptionalFloatEqBigint(x: float?, y: bigint) -> bool {
    x == y
}

// And ordering with the float-bigint mix is also rejected — the Optional
// rejection fires first, but either reason is sound.
function OptionalFloatLtBigint(x: float?, y: bigint) -> bool {
    x < y
}

// Class fields are invariant — `{ count: 1 }` is not an instance of a
// class with a `count: bigint` field. The runtime does no field-level
// widening, so this must be a compile error; write `count: 1n`.
class BigintHolder {
    count: bigint,
}

function IntFieldIntoBigintClass() -> BigintHolder {
    BigintHolder { count: 1 }
}

// An `int` default for a `bigint` parameter is rejected — `int` is not a
// subtype of `bigint`. Write `0n`.
function BigintParamDefaultInt(x: bigint = 0) -> bigint {
    x
}
