function baml.llm.PlannerState.rr_local_offset(self: baml.llm.PlannerState, client_name: string) -> int {
    load_const 0
    store_var offset
    load_var self
    load_field .rr_client_names
    store_var _iter
    load_var _iter
    call baml.Array.length
    store_var _len
    load_const 0
    store_var _i

  L0:
    load_var _i
    load_var _len
    cmp_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var offset
    return

  L2:
    load_var _iter
    load_var _i
    load_array_element
    store_var seen_name
    load_var _i
    load_const 1
    bin_op +
    store_var _i
    load_var seen_name
    load_var client_name
    cmp_op ==
    pop_jump_if_false L0
    load_var offset
    load_const 1
    bin_op +
    store_var offset
    jump L0
}

function baml.llm.PlannerState.rr_pick_index(self: baml.llm.PlannerState, client_name: string, sub_client_count: int) -> int {
    load_var self
    load_var client_name
    call baml.llm.PlannerState.rr_local_offset
    store_var local_offset
    load_var self
    load_field .rr_client_names
    load_var client_name
    call baml.Array.push
    pop 1
    load_var client_name
    dispatch_future baml.llm.round_robin_peek
    await
    load_var local_offset
    bin_op +
    load_var sub_client_count
    bin_op %
    return
}

function baml.llm.build_attempt(llm_client: baml.llm.Client) -> baml.llm.OrchestrationStep[] {
    load_var llm_client
    alloc_instance baml.llm.PlannerState
    copy 0
    alloc_array 0
    store_field .rr_client_names
    call baml.llm.build_attempt_with_state
    return
}

function baml.llm.build_attempt_with_state(llm_client: baml.llm.Client, planner_state: baml.llm.PlannerState) -> baml.llm.OrchestrationStep[] {
    load_var llm_client
    load_field .client_type
    discriminant
    copy 0
    load_const baml.llm.ClientType.Primitive
    cmp_op ==
    pop_jump_if_false L0
    pop 1
    jump L9

  L0:
    copy 0
    load_const baml.llm.ClientType.Fallback
    cmp_op ==
    pop_jump_if_false L1
    pop 1
    jump L4

  L1:
    pop 1
    load_var llm_client
    load_field .sub_clients
    call baml.Array.length
    load_const 0
