function truthiness.tr_and(a: string | null, b: int) -> bool {
    load_var a
    unary_op truthy
    jump_if_false_or_pop L0
    jump L1

  L0:
    store_var _3
    jump L2

  L1:
    load_var b
    store_var _3
    load_var _3
    unary_op truthy
    store_var _3

  L2:
    load_var _3
    return
}

function truthiness.tr_bigint(v: bigint) -> string {
    load_var v
    unary_op truthy
    pop_jump_if_true L0
    load_const "F"
    jump L1

  L0:
    load_const "T"

  L1:
    return
}

