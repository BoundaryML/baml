function truthiness.tr_countdown(n: int) -> int {
    load_const 0
    store_var steps
    load_var n
    store_var remaining

  L0:
    load_var remaining
    unary_op truthy
    pop_jump_if_true L1
    load_var steps
    return

  L1:
    load_var remaining
    load_const 1
    sub_int
    store_var remaining
    load_var steps
    load_const 1
    add_int
    store_var steps
    jump L0
}

