---
source: crates/baml_tests/src/corpus.rs
---
function bools.$init_test_ns_bools_bools(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.bools"
    load_const "bool_random_covers_both_values"
    make_closure .<lambda($init_test_ns_bools_bools, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.bools"
    load_const "bool_random_seeded_is_reproducible"
    make_closure .<lambda($init_test_ns_bools_bools, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.bools"
    load_const "bool_random_default_rng_runs"
    make_closure .<lambda($init_test_ns_bools_bools, 2)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function bools.bool_random_covers_both_values() -> bool {
    call user.bools.bool_random_seed
    call baml.random.Xoshiro256PlusPlus.new
    store_var rng
    load_const 0
    store_var t
    load_const 0
    store_var f
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 1000
    cmp_int_op <
    pop_jump_if_false L1
    jump L4

  L1:
    load_var t
    load_const 400
    cmp_int_op >
    jump_if_false L2
    pop 1
    load_var f
    load_const 400
    cmp_int_op >

  L2:
    jump_if_false L3
    pop 1
    load_var2 2 3
    add_int
    load_const 1000
    cmp_int_op ==

  L3:
    return

  L4:
    load_var rng
    call baml.Bool.random
    pop_jump_if_false L5
    jump L6

  L5:
    load_var f
    load_const 1
    add_int
    store_var f
    jump L7

  L6:
    load_var t
    load_const 1
    add_int
    store_var t

  L7:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

function bools.bool_random_default_rng_runs() -> bool {
    load_const <omitted>
    call baml.Bool.random
    store_var r
    load_var r
    jump_if_false L0
    jump L1

  L0:
    pop 1
    load_var r
    unary_op !

  L1:
    return
}

function bools.bool_random_seed() -> uint8array {
    load_const b"\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80"
    call baml.deep_copy
    return
}

function bools.bool_random_seeded_is_reproducible() -> bool {
    call user.bools.bool_random_seed
    call baml.random.Xoshiro256PlusPlus.new
    store_var a
    call user.bools.bool_random_seed
    call baml.random.ChaCha20.new
    store_var b
    call user.bools.bool_random_seed
    call baml.random.ChaCha20.new
    store_var c
    load_const true
    store_var ok
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 100
    cmp_int_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var ok
    return

  L2:
    load_var b
    call baml.Bool.random
    store_var _12
    load_var c
    call baml.Bool.random
    store_var _14
    load_var2 6 7
    cmp_op !=
    pop_jump_if_false L3
    load_const false
    store_var ok

  L3:
    load_var a
    call baml.Bool.random
    pop 1
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}
