function fs.fs_file_write_on_readonly_errors_fn() -> bool {
    load_const "write_readonly.txt"
    call user.fs.fs_tmp
    store_var path
    load_var path
    load_const "content"
    sys_op baml.fs.write
    pop 1
    load_var path
    load_const "r"
    sys_op baml.fs.open
    load_const "should fail"
    sys_op baml.fs.File.write
    pop 1
    jump L2
