function floats.float_random_distinct_values() -> bool {
    load_const 1.0
    store_var min_seen
    load_const 0.0
    store_var max_seen
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 100
    cmp_int_op <
    pop_jump_if_true L1
    load_var2 2 1
    sub_float
    load_const 0.5
    cmp_float_op >
    return

  L1:
    load_const <omitted>
    call baml.Float.random
    store_var r
    load_var2 4 1
    cmp_float_op <
    pop_jump_if_false L2
    load_var r
    store_var min_seen

  L2:
    load_var2 4 2
    cmp_float_op >
    pop_jump_if_false L3
    load_var r
    store_var max_seen

  L3:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

function floats.float_random_in_unit_interval_and_covers_both_halves() -> bool {
    load_const true
    store_var ok
    load_const 0
    store_var below
    load_const 0
    store_var above
    load_const 0
    store_var i

  L0:
