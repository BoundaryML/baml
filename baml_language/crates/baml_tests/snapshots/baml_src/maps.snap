function maps.edit_map_key_helper() -> int {
    load_const 123
    load_const "hi"
    load_type string
    load_type int
    alloc_map 1
    store_var map
    load_var map
    load_const "hi"
    load_const 42
    load_const 4
    bin_op -
    store_map_element
    load_var map
    load_const "hi"
    load_var map
    load_const "hi"
    load_map_element
    load_const 4
    bin_op +
    store_map_element
    load_var map
    load_const "hi"
    load_map_element
    return
}

