function maps.use_map_contains_helper() -> string {
    load_const "world"
    load_const "hello"
    load_type string
    load_type string
    alloc_map 1
    store_var map
    load_type string
    load_type string
    load_var map
    load_const "hello"
    call baml.Map.has
    pop_jump_if_false L0
    jump L1

  L0:
    load_const "hi"
    jump L2

  L1:
    load_var map
    load_const "hello"
    load_map_element

  L2:
    return
}

