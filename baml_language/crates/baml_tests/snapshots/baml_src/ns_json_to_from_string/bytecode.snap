    call baml.json.to_string
    store_var s
    load_type json_to_from_string.Container<json_to_from_string.User>
    load_var s
    call baml.json.from_string
    load_field .item
    load_field .0
    return
}

function json_to_from_string.enum_variant_from_string_name() -> string {
    load_type json_to_from_string.Color
    load_const "\"Blue\""
    call baml.json.from_string
    discriminant
    load_const Color.Blue
    cmp_int_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_const "other"
    jump L2

  L1:
    load_const "Blue"

  L2:
    return
}

function json_to_from_string.enum_variant_roundtrip_eq() -> bool {
    load_const user.json_to_from_string.Color.Blue
