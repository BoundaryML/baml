function json_to_from_string.alias_field_decodes_raw_name_val() -> string {
    load_type json_to_from_string.ProfileAlias
    load_const "{\"display_name\":\"Ada\"}"
    call baml.json.from_string
    load_field .display_name
    return
}

function json_to_from_string.check_decode_error_path_contains_field() -> bool {
    load_type json_to_from_string.Outer
    load_const "{\"inner\":{}}"
    call baml.json.from_string
    store_var u
    jump L2
    load_var e
    store_var _4
    load_var _4
    narrow_bind baml.json.JsonDecodeError, slot=3
    pop_jump_if_false L0
    jump L1

  L0:
    load_var e
    rethrow

  L1:
    load_var _4
    load_field .path
    load_const ".inner.value"
    call assert.contains
    pop 1
    load_const true
    jump L3

  L2:
    load_const false

  L3:
    return
}

function json_to_from_string.closure_captures_type_arg_name() -> string {
    load_type json_to_from_string.UserSimple
    call user.json_to_from_string.make_decoder
    store_var f
    load_const "{\"name\":\"Ada\"}"
    load_var f
    call_indirect
    load_field .name
    return
}

