    call baml.json.to_string
    store_var s
    load_type json_to_from_string.Color
    load_var s
    call baml.json.from_string
    load_const user.json_to_from_string.Color.Blue
    alloc_variant user.json_to_from_string.Color
    call baml.ops.equals_equals
