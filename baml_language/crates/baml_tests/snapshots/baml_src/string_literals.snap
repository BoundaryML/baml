function string_literals.json_body() -> string {
    load_const "{\"input\":\"hello\\nworld\",\"model\":\"m\"}"
    return
}

function string_literals.json_body_is_parseable_fn() -> bool {
    call user.string_literals.json_body
    store_var _2
    load_type map<string, string>
    load_var _2
    call baml.json.from_string
    store_var parsed
    load_var parsed
    load_const "input"
    load_map_element
    call baml.String.to_utf8
    call baml.Uint8Array.to_hex
    load_const "68656c6c6f0a776f726c64"
    cmp_op ==
    jump_if_false L0
    pop 1
    load_var parsed
    load_const "model"
    load_map_element
    load_const "m"
    cmp_op ==

  L0:
    return
}

