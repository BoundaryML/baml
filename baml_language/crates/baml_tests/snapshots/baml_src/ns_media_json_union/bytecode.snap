function media_json_union.rejects_media_json(json: string) -> bool {
    load_type #0
    load_var json
    call baml.json.from_string
    pop 1
    jump L2
    load_var e
    is_type baml.json.JsonDecodeError
    pop_jump_if_false L0
    jump L1

  L0:
    load_var e
    rethrow

  L1:
    load_const true
    jump L3

  L2:
    load_const false

  L3:
    return
}
