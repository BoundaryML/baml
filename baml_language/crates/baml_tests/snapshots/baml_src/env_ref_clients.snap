    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    load_const <omitted>
    call openai.GenericClient.new
    call openai.GenericClient.resolved_base_url
    jump L2
    load_var e
    is_type baml.errors.InvalidArgument
    pop_jump_if_false L0
    jump L1

  L0:
    load_var e
    rethrow

  L1:
    load_var e
    load_field .message

  L2:
    return
}

