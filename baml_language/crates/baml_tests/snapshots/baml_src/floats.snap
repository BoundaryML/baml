function floats.float_random_distinct_values() -> bool {
    load_const 1.0
    store_var min_seen
    load_const 0.0
    store_var max_seen
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 100
    cmp_int_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var max_seen
    load_var min_seen
    sub_float
    load_const 0.5
    cmp_float_op >
    return

  L2:
    call baml.Float.random
    store_var r
    load_var r
    load_var min_seen
    cmp_float_op <
    pop_jump_if_false L3
    load_var r
    store_var min_seen

  L3:
    load_var r
    load_var max_seen
    cmp_float_op >
    pop_jump_if_false L4
    load_var r
    store_var max_seen

  L4:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

function floats.float_random_in_unit_interval_and_covers_both_halves() -> bool {
    load_const true
    store_var ok
    load_const 0
    store_var below
    load_const 0
    store_var above
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 1000
    cmp_int_op <
    pop_jump_if_false L1
    jump L4

  L1:
    load_var ok
    jump_if_false L2
    pop 1
    load_var below
    load_const 350
    cmp_int_op >=

  L2:
    jump_if_false L3
    pop 1
    load_var above
    load_const 350
    cmp_int_op >=

  L3:
    return

  L4:
    call baml.Float.random
    store_var r
    load_var r
    load_const 0.0
    cmp_float_op <
    jump_if_false L5
    jump L6

  L5:
    pop 1
    load_var r
    load_const 1.0
    cmp_float_op >=

  L6:
    pop_jump_if_false L7
    load_const false
    store_var ok

  L7:
    load_var r
    load_const 0.5
    cmp_float_op <
    pop_jump_if_false L8
    jump L9

  L8:
    load_var above
    load_const 1
    add_int
    store_var above
    jump L10

  L9:
    load_var below
    load_const 1
    add_int
    store_var below

  L10:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

function floats.float_random_returns_a_float() -> bool {
    call baml.Float.random
    store_var r
    load_var r
    load_const 0.0
    cmp_float_op >=
    jump_if_false L0
    pop 1
    load_var r
    load_const 1.0
    cmp_float_op <

  L0:
    return
}
