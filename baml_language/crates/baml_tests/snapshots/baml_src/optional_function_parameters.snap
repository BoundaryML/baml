    store_var ?1
    load_const user.optional_function_parameters.combine
    store_deref ?1
    load_const 1
    load_const 5
    load_var _2
    make_closure .<optional-adapter(ofp_optional_dropping_adapter_uses_defaults_for_hidden_params, 0)>, 1
