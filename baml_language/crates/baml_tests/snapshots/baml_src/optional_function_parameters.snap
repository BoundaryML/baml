function optional_function_parameters.score(query: string, max_results: int, filter: string | null, chunk_size: int) -> int {
    load_var max_results
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L0
    load_const 10
    store_var max_results

  L0:
    load_var filter
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L1
    load_const null
    store_var filter

  L1:
    load_var chunk_size
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L2
    load_var query
    call baml.String.length
    store_var chunk_size

  L2:
    load_var filter
    load_const null
    call baml.ops.equals_equals
    pop_jump_if_false L3
    jump L4

  L3:
    load_const 100
    store_var filter_bonus
    jump L5

  L4:
    load_const 0
    store_var filter_bonus

  L5:
    load_var2 2 4
    add_int
    load_var filter_bonus
    add_int
    return
}
