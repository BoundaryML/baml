function optional_function_parameters.classify(value: int | null) -> int {
    load_var value
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L0
    load_const 7
    store_var value

  L0:
    load_var value
    load_const null
    call baml.ops.equals_equals
    pop_jump_if_false L1
    jump L2

  L1:
    load_var value
    jump L3

  L2:
    load_const 1

  L3:
    return
}

function optional_function_parameters.combine(x: int, a: int, b: int) -> int {
    load_var a
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L0
    load_const 10
    store_var a

  L0:
    load_var b
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L1
    load_const 100
    store_var b

  L1:
    load_var x
    load_const 100
    mul_int
    load_var a
    load_const 10
    mul_int
    add_int
    load_var b
    add_int
    return
}

