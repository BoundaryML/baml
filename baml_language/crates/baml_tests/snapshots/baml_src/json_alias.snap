function json_alias.foo_data() -> baml.json.json {
    load_const null
    init_instance user.json_alias.Foo .data
    load_field .data
    return
}

function json_alias.json_array_len() -> int {
    load_const 1
    load_const 2
    load_const 3
    load_type baml.json.json
    alloc_array 3
    store_var_load_var arr
    is_type baml.json.json[]
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 1
    unary_op -
    jump L2

  L1:
    load_var arr
    container_len

  L2:
    return
}

function json_alias.json_map_has_key() -> bool {
    load_const "value"
    load_const "key"
    load_type string
    load_type baml.json.json
    alloc_map 1
    store_var_load_var m
    is_type map<string, baml.json.json>
    pop_jump_if_false L0
    jump L1

  L0:
    load_const false
    jump L2

  L1:
    load_var m
    container_len
    store_var _4
    load_var _4
    load_const 1
    cmp_int_op ==

  L2:
    return
}

function json_alias.match_json(j: baml.json.json) -> string {
    load_var j
    type_tag
    jump_table [L4, L2, L5, L6, L3, _, L1, L0], default L8

  L0: map
    load_const "map"
    jump L7

  L1: list
    load_const "array"
    jump L7

  L2: string
    load_const "string"
    jump L7

  L3: float
    load_const "float"
    jump L7

  L4: int
    load_const "int"
    jump L7

  L5: bool
    load_const "bool"
    jump L7

  L6: null
    load_const "null"

  L7:
    return

  L8:
    unreachable
}
