function while_loops.while_loops_fib(n: int) -> int {
    load_const 0
    store_var a
    load_const 1
    store_var b

  L0:
    load_var n
    load_const 0
    cmp_int_op >
    pop_jump_if_false L1
    jump L2

  L1:
    load_var a
    return

  L2:
    sub_int_var_const 1 1
    store_var n
    add_int_var_var_store 2 3 4
    move_local 3 2
    move_local 2 4
    jump L0
}

function while_loops.while_loops_gcd(a: int, b: int) -> int {
  L0:
    load_var a
    load_var b
    cmp_int_op !=
    pop_jump_if_false L1
    jump L2

  L1:
    load_var a
    return

  L2:
    load_var a
    load_var b
    cmp_int_op >
    pop_jump_if_false L3
    jump L4

  L3:
    sub_int_var_var 2 1
    store_var b
    jump L0

  L4:
    sub_int_var_var 1 2
    store_var a
    jump L0
}
