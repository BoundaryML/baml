function while_loops.while_loops_break_at_two() -> int {
    load_const 1
    store_var a

  L0:
    cmp_int_lt_var_const_br_false 1 1 +6
    add_int_var_const_store 1 0 1
    load_var a
    load_const 2
    cmp_int_op ==
    pop_jump_if_false L0
    load_var a
    return
}

