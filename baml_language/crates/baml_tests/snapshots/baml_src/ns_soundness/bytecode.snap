function soundness.$init_test_ns_soundness_soundness(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.soundness"
    load_const "call_result_immediate_right_operand_subtraction"
    make_closure .<lambda($init_test_ns_soundness_soundness, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.soundness"
    load_const "phi_like_right_operand_subtraction"
    make_closure .<lambda($init_test_ns_soundness_soundness, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
