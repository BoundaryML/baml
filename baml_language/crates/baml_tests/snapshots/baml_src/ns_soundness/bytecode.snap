    load_const "cross_block_let_mutation"
    make_closure .<lambda($init_test_ns_soundness_soundness, 3)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.soundness"
    load_const "cross_block_let_mutation_false_branch"
    make_closure .<lambda($init_test_ns_soundness_soundness, 4)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
