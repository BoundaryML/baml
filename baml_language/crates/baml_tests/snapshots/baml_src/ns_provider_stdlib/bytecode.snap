function provider_stdlib.$init_test_ns_provider_stdlib_provider_stdlib(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.provider_stdlib"
    load_const "provider stdlib exposes typed JSON paths and schemas"
    make_closure .<lambda($init_test_ns_provider_stdlib_provider_stdlib, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.provider_stdlib"
    load_const "provider stdlib JSON paths preserve brackets in quoted keys"
    make_closure .<lambda($init_test_ns_provider_stdlib_provider_stdlib, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.provider_stdlib"
    load_const "provider stdlib exposes schema aligned parsing"
    make_closure .<lambda($init_test_ns_provider_stdlib_provider_stdlib, 2)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function provider_stdlib.provider_schema() -> baml.json.json {
    load_type provider_stdlib.ProviderSchemaExample
    sys_op baml.json.schema
    return
}

function provider_stdlib.provider_schema_values() -> string {
    call user.provider_stdlib.provider_schema
    store_var schema
    load_type string
    load_var schema
    load_const ".type"
    call baml.json.path
    load_type string
    load_var schema
    load_const ".properties.name.type"
    call baml.json.path
    store_var _10
    load_type string[]
    load_var schema
    load_const ".required"
    call baml.json.path
    store_var _14
    load_type string
    load_var _14
    load_const ","
    call baml.Array.join
    store_var _13
    load_type string
    load_var schema
    load_const ".properties.missing.type"
    load_const "missing"
    call baml.json.path_or
    store_var _18
    load_const "|"
    bin_op +
    load_var _10
    bin_op +
    load_const "|"
    bin_op +
    load_var _13
    bin_op +
    load_const "|"
    bin_op +
    load_var _18
    bin_op +
    return
}
