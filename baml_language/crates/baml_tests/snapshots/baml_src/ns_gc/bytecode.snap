---
source: crates/baml_tests/src/corpus.rs
---
function gc.$init_test_ns_gc_gc(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.gc"
    load_const "test_heavy_allocation_loop"
    make_closure .<lambda($init_test_ns_gc_gc, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.gc"
    load_const "test_map_survives_gc_during_operations"
    make_closure .<lambda($init_test_ns_gc_gc, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function gc.gc_build_map() -> map<string, int> {
    load_const 1
    load_const 4
    load_const 9
    load_const 16
    load_const 25
    load_const "a"
    load_const "b"
    load_const "c"
    load_const "d"
    load_const "e"
    load_type string
    load_type int
    alloc_map 5
    return
}

function gc.gc_heavy_allocation_loop() -> int {
    load_const 0
    store_var sum
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 1000
    cmp_int_op <
    pop_jump_if_true L1
    load_var sum
    return

  L1:
    load_var2 1 2
    load_var i
    load_const 2
    mul_int
    load_var i
    load_const 3
    mul_int
    load_type int
    alloc_array 3
    load_const 2
    load_array_element
    add_int
    store_var sum
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

function gc.gc_map_survives_pressure() -> int {
    call user.gc.gc_build_map
    store_var m
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 500
    cmp_int_op <
    pop_jump_if_true L1
    load_var m
    container_len
    return

  L1:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}
