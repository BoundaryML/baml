function match_types.all_guarded_main() -> string {
    load_const 1
    load_const false
    call user.match_types.classify_all_guarded
    return
}

function match_types.classify_all_guarded(x: int, flag: bool) -> string {
    load_var x
    is_type 0
    pop_jump_if_false L0
    load_var flag
    pop_jump_if_true L5

  L0:
    load_var x
    is_type 1
    pop_jump_if_false L1
    load_var flag
    pop_jump_if_true L4

  L1:
    load_var x
    is_type 2
    pop_jump_if_false L2
    load_var flag
    pop_jump_if_true L3

  L2:
    load_const "fallback"
    jump L6

  L3:
    load_const "two"
    jump L6

  L4:
    load_const "one"
    jump L6

  L5:
    load_const "zero"

  L6:
    return
}

