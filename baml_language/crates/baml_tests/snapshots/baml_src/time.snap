function time.$init_test_ns_time_time(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "instant_parse_epoch"
    make_closure .<lambda($init_test_ns_time_time, 0)>, 0
    load_const null
    call testing.TestCollector.register_test
    pop 1
    load_var registry
    load_const "instant_parse_one_second"
