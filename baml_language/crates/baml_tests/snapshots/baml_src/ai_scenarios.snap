    bin_op +
    load_const "] "
    bin_op +
    load_var summary
    bin_op +
    return
}

function ai_scenarios.wf_durable_step(ckpt: ai_scenarios.WfCheckpoint, coord: string, compute: () -> T throws baml.errors.UnknownError) -> T {
    load_var compute
    call_indirect
    return
}

function ai_scenarios.wf_fetch_doc(url: string) -> ai_scenarios.WfDoc {
    load_const "contents of "
    load_var url
    bin_op +
    init_instance user.ai_scenarios.WfDoc .text
    return
}

function ai_scenarios.wf_model_text(p: baml.ai.Provider, prompt: string) -> string {
    load_var p
    is_type baml.ai.Traced
    pop_jump_if_false L0
    jump L16

  L0:
    load_var p
    is_type baml.ai.OpenAiCompatible
    pop_jump_if_false L1
    jump L16

  L1:
    load_var p
    is_type baml.ai.ToolLoop
    pop_jump_if_false L2
    jump L16

  L2:
    load_var p
    is_type baml.ai.Retry
    pop_jump_if_false L3
    jump L16

  L3:
    load_var p
    is_type baml.ai.OpenAi
    pop_jump_if_false L4
    jump L16

  L4:
    load_var p
    is_type baml.ai.Gemini
    pop_jump_if_false L5
    jump L16

  L5:
    load_var p
    is_type baml.ai.OpenAiResponses
    pop_jump_if_false L6
    jump L16

  L6:
    load_var p
    is_type baml.ai.RoundRobin
    pop_jump_if_false L7
    jump L16

  L7:
    load_var p
    is_type baml.ai.Fallback
    pop_jump_if_false L8
    jump L16

  L8:
    load_var p
    is_type baml.ai.OpenAiStrict
    pop_jump_if_false L9
    jump L16

  L9:
    load_var p
    is_type baml.ai.Anthropic
    pop_jump_if_false L10
    jump L16

  L10:
    load_var p
    is_type baml.llm.Client
    pop_jump_if_false L11
    jump L16

  L11:
    load_var p
    is_type ai_scenarios.MeteredEcho
    pop_jump_if_false L12
    jump L16

  L12:
    load_var p
    is_type ai_scenarios.EchoProvider
    pop_jump_if_false L13
    jump L16

  L13:
    load_var p
    is_type ai_scenarios.CountingEcho
    pop_jump_if_false L14
    jump L16

  L14:
    load_var p
    is_type ai_scenarios.AlwaysFailProvider
    pop_jump_if_false L15
    jump L16

  L15:
    load_const "client cannot produce a value"
    init_instance baml.errors.Unsupported .message
    throw

  L16:
    load_type string
    load_var2 1 2
    load_type baml.ai.HttpProvider
    load_const "call"
    virtual_call nargs=2 ntypeargs=1
    store_var _0
    load_var _0
    return
}
