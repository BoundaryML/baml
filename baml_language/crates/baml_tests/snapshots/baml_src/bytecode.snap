function shadowing_declarations_are_reachable() -> int {
    load_const true
    init_instance user.int .shadowed
    load_field .shadowed
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 0
    jump L2

  L1:
    load_const 5
    init_instance user.string .shadowed
    load_field .shadowed

  L2:
    return
}
