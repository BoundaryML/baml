function $init_test_builtin_type_shadowing(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root"
    load_const "builtin_statics_survive_a_shadowing_declaration"
    make_closure .<lambda($init_test_builtin_type_shadowing, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root"
    load_const "annotation_position_denotes_the_builtin"
    make_closure .<lambda($init_test_builtin_type_shadowing, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root"
    load_const "shadowing_declarations_stay_reachable_qualified"
    make_closure .<lambda($init_test_builtin_type_shadowing, 2)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

