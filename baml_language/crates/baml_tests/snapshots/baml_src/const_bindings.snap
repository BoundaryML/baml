function const_bindings.$init_test_ns_const_bindings_const_bindings(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.const_bindings"
    load_const "let_and_const_bindings_execute_the_same"
    make_closure .<lambda($init_test_ns_const_bindings_const_bindings, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function const_bindings.const_bindings_with_const() -> int {
    load_const 0
    store_var sum
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 4
    cmp_int_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var sum
    return

  L2:
    load_var2 1 2
    add_int
    store_var sum
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

function const_bindings.const_bindings_with_let() -> int {
    load_const 0
    store_var sum
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 4
    cmp_int_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var sum
    return

  L2:
    load_var2 1 2
    add_int
    store_var sum
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}
