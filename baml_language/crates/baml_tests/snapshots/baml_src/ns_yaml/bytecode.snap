function yaml.<(user.yaml.YamlWrappedName as baml.FromJson)>.from_json(j: baml.json.json) -> yaml.YamlWrappedName {
    load_var j
    load_const "name"
    call baml.json.field
    store_var _4
    load_type string
    load_var _4
    call baml.json.from_json
    store_var _3
    load_const "wrapped:"
    load_var _3
    bin_op +
    init_instance user.yaml.YamlWrappedName .name
    return
}
