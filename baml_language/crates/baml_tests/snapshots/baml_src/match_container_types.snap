function match_container_types.classify_list(x: int[] | string[]) -> string {
    load_var x
    is_type int[]
    pop_jump_if_false L0
    jump L1

  L0:
    load_const "strings"
    jump L2

  L1:
    load_const "ints"

  L2:
    return
}

