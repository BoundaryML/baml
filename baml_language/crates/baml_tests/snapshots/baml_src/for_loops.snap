function for_loops.for_loops_c_for_sum_to_ten() -> int {
    load_const 0
    store_var s
    load_const 1
    store_var i

  L0:
    load_var i
    load_const 10
    cmp_int_op <=
    pop_jump_if_false L1
    jump L2

  L1:
    load_var s
    return

  L2:
    load_var s
    load_var i
    add_int
    store_var s
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

