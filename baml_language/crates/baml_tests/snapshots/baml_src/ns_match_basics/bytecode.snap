function match_basics.union_with_duplicates() -> string {
    load_const 1
    load_const 1
    cmp_int_op ==
    pop_jump_if_false L0
    jump L4

  L0:
    load_const 1
    load_const 2
    cmp_int_op ==
    pop_jump_if_false L1
    jump L4

  L1:
    load_const 1
    load_const 3
    cmp_int_op ==
    pop_jump_if_false L2
    jump L3

  L2:
    load_const "other"
    jump L5

  L3:
    load_const "three"
    jump L5

  L4:
    load_const "one or two"

  L5:
    return
}
