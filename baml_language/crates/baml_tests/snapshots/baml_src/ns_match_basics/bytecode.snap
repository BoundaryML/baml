    load_const 204
    dense_tag [200, 201, 202, 204, 400, 401, 403, 404, 500, 501, 502, 503]
    jump_table [L3, L3, L3, L3, L2, L2, L2, L2, L1, L1, L1, L1], default L0

  L0:
    load_const "other"
    jump L4

  L1: 503
    load_const "server error"
    jump L4

  L2: 404
    load_const "client error"
    jump L4

  L3: 204
    load_const "success"

  L4:
    return
}

