function match_basics.as_expression_in_arithmetic() -> int {
    load_const 2
    load_const 1
    cmp_int_op ==
    pop_jump_if_false L0
    jump L3

  L0:
    load_const 2
    load_const 2
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
    load_const 0
    jump L4

  L2:
    load_const 20
    jump L4

  L3:
    load_const 10

  L4:
    load_const 1
    bin_op +
    return
}

