function regex.apply_terms(text: string, terms: regex.Term[]) -> string {
    load_var ?6
    make_cell
    store_var ?6
    load_var text
    store_var out
    load_var terms
    load_type baml.iter.Iterable<Error = never, Item = regex.Term>
    load_const "iter"
    virtual_call nargs=1 ntypeargs=0
    store_var _4

  L0:
    load_var _4
    load_type baml.iter.Iterator<Error = never, Item = regex.Term>
    load_const "next"
    virtual_call nargs=1 ntypeargs=0
    store_var _5
    load_var _5
    is_type baml.iter.Done
    pop_jump_if_false L1
    jump L2

  L1:
    load_const null
    make_cell
    store_var t
    load_var _5
    store_deref ?6
    load_deref ?6
    load_field .from
    load_const true
    call baml.regex.word
    store_var _9
    load_type never
    load_var2 3 7
    load_var t
    make_closure .<lambda(apply_terms, 0)>, 1
    call baml.String.replace_all
    store_var out
    jump L0

  L2:
    load_var out
    return
}

function regex.compile_dynamic(pattern: string, backtracking: bool) -> baml.regex.Regex {
    load_var2 1 2
    call baml.regex.compile
    return
}

function regex.reject(m: baml.regex.Match) -> string {
    load_var m
    load_field .text
    init_instance user.regex.Unknown .term
    throw
}

function regex.rewrite_without_effects(text: string, spaces: baml.regex.Regex) -> string {
    load_type unknown
