    load_const "call_with_arguments"
    make_closure .<lambda($init_test_ns_functions_functions, 6)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.functions"
    load_const "unused_variable_does_not_affect_result"
    make_closure .<lambda($init_test_ns_functions_functions, 7)>, 0
