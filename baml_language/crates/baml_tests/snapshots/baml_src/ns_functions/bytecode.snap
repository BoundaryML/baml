}

function functions.add(a: int, b: int) -> int {
    load_var2 1 2
    add_int
    return
}

function functions.call_twice(f: (int, int) -> int throws never, x: int, y: int) -> int {
    load_var2 2 3
    load_var f
    call_indirect
    load_var2 2 3
    load_var f
    call_indirect
    add_int
    return
}

function functions.call_with_arguments_fn() -> int {
    load_const 1
    load_const 2
    call user.functions.one_of
    return
}

function functions.early_return(x: int) -> int {
    load_var x
    load_const 42
    cmp_int_op ==
    pop_jump_if_true L0
    load_var x
    load_const 5
    add_int
    jump L1

  L0:
    load_const 1

  L1:
    return
}

function functions.early_return_nested() -> int {
    load_const 0
    return
}

function functions.fib(n: int) -> int {
    load_var n
    load_const 1
    cmp_int_op <=
    pop_jump_if_true L0
    load_var n
    load_const 1
    sub_int
    call user.functions.fib
    load_var n
    load_const 2
    sub_int
    call user.functions.fib
    add_int
    jump L1

  L0:
    load_var n

  L1:
    return
}

function functions.fib_main() -> int {
    load_const 3
    call user.functions.fib
    return
}

function functions.function_as_value_main() -> int {
    load_type never
    load_const user.functions.add
    load_const 20
    load_const 1
    call user.functions.call_twice
    return
}

