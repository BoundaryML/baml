function to_string_interface.<(user.to_string_interface.DmcGreeter as baml.ToString)>.to_string(self: to_string_interface.DmcGreeter) -> string {
    load_const "Hello, "
    load_var self
    load_field .name
    bin_op +
    return
}

function to_string_interface.<(user.to_string_interface.IouPoint as baml.ToString)>.to_string(self: to_string_interface.IouPoint) -> string {
    load_type int
    load_var self
    load_field .x
    call baml.String.from
    store_var _5
    load_type int
    load_var self
    load_field .y
    call baml.String.from
    store_var _8
    load_const "("
    load_var _5
    bin_op +
    load_const ", "
    bin_op +
    load_var _8
    bin_op +
    load_const ")"
    bin_op +
    return
}

function to_string_interface.<(user.to_string_interface.OvrPoint as baml.ToString)>.to_string(self: to_string_interface.OvrPoint) -> string {
    load_type int
    load_var self
    load_field .x
    call baml.String.from
    store_var _5
    load_type int
    load_var self
    load_field .y
    call baml.String.from
    store_var _8
    load_const "("
    load_var _5
    bin_op +
    load_const ", "
    bin_op +
    load_var _8
    bin_op +
    load_const ")"
    bin_op +
    return
}

function to_string_interface.dmc_render() -> string {
    load_const "world"
    init_instance user.to_string_interface.DmcGreeter .name
    load_type baml.ToString
    load_const "to_string"
    virtual_call nargs=1 ntypeargs=0
    store_var _0
    load_var _0
    return
}

function to_string_interface.drc_render() -> string {
    load_type to_string_interface.DrcPoint
    load_const 1
    load_const 2
    init_instance user.to_string_interface.DrcPoint .x, .y
    call baml.String.from
    return
}

