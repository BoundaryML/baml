function ints.count_zeros_plus_ones(n: int) -> int {
    load_var n
    call baml.Int.count_zeros
    store_var _2
    load_var n
    call baml.Int.count_ones
    store_var _3
    load_var _2
    load_var _3
    add_int
    return
}

function ints.int_random_distinct_values_in_wide_range() -> bool {
    load_const 1000
    store_var min_seen
    load_const 0
    store_var max_seen
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 100
    cmp_int_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var max_seen
    load_var min_seen
    sub_int
    load_const 500
    cmp_int_op >=
    return

  L2:
    load_const 0
    load_const 1000
    call baml.Int.random
    store_var r
    load_var r
    load_var min_seen
    cmp_int_op <
    pop_jump_if_false L3
    load_var r
    store_var min_seen

  L3:
    load_var r
    load_var max_seen
    cmp_int_op >
    pop_jump_if_false L4
    load_var r
    store_var max_seen

  L4:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

