    store_var r
    call baml.Int.min_value
    store_var _6
    load_var r
    load_var _6
    cmp_int_op >=
    jump_if_false L0
    pop 1
    call baml.Int.max_value
    store_var _8
    load_var r
    load_var _8
    cmp_int_op <=

  L0:
    return
}

function ints.int_random_in_range_and_covers_endpoints() -> bool {
    load_const true
    store_var ok
    load_const false
    store_var saw_lo
    load_const false
    store_var saw_hi
    load_const 0
    store_var i

  L0:
    load_var i
    load_const 1000
    cmp_int_op <
    pop_jump_if_false L1
    jump L4

  L1:
    load_var ok
    jump_if_false L2
    pop 1
    load_var saw_lo

  L2:
    jump_if_false L3
    pop 1
    load_var saw_hi

  L3:
    return

  L4:
    load_const 0
    load_const 10
    call baml.Int.random
    store_var r
    load_var r
    load_const 0
    cmp_int_op <
    jump_if_false L5
    jump L6

  L5:
    pop 1
    load_var r
    load_const 10
    cmp_int_op >=

  L6:
    pop_jump_if_false L7
    load_const false
    store_var ok

  L7:
    load_var r
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L8
    load_const true
    store_var saw_lo

  L8:
    load_var r
    load_const 9
    cmp_int_op ==
    pop_jump_if_false L9
    load_const true
    store_var saw_hi

  L9:
    load_var i
    load_const 1
    add_int
    store_var i
    jump L0
}

