function match_optimization.classify_binary_search_eight_arms(x: int) -> int {
    load_var x
    dense_tag [0, 10, 20, 30, 40, 50, 60, 70]
    jump_table [L8, L7, L6, L5, L4, L3, L2, L1], default L0

  L0:
    load_const 99
    jump L9

  L1: 70
    load_const 7
    jump L9

  L2: 60
    load_const 6
    jump L9

  L3: 50
    load_const 5
    jump L9

  L4: 40
    load_const 4
    jump L9

  L5: 30
    load_const 3
    jump L9

  L6: 20
    load_const 2
    jump L9

  L7: 10
    load_const 1
    jump L9

  L8: 0
    load_const 0

  L9:
    return
}

function match_optimization.classify_binary_search_negative_sparse(x: int) -> string {
    load_var x
    dense_tag [-100, -50, -10, -1]
    jump_table [L4, L3, L2, L1], default L0

  L0:
    load_const "other"
    jump L5

  L1: -1
    load_const "d"
    jump L5

  L2: -10
    load_const "c"
    jump L5

  L3: -50
    load_const "b"
    jump L5

  L4: -100
    load_const "a"

  L5:
    return
}

function match_optimization.classify_binary_search_spanning_zero_sparse(x: int) -> string {
    load_var x
    dense_tag [-100, -1, 1, 100]
    jump_table [L4, L3, L2, L1], default L0

  L0:
    load_const "other"
    jump L5

  L1: 100
    load_const "hundred"
    jump L5

  L2: 1
    load_const "one"
    jump L5

  L3: -1
    load_const "neg one"
    jump L5

  L4: -100
    load_const "neg hundred"

  L5:
    return
}

function match_optimization.classify_binary_search_sparse_four_arms_param(x: int) -> int {
    load_var x
    dense_tag [0, 30, 60, 99]
    jump_table [L4, L3, L2, L1], default L0

  L0:
    load_const 999
    jump L5

  L1: 99
    load_const 199
    jump L5

  L2: 60
    load_const 160
    jump L5

  L3: 30
    load_const 130
    jump L5

  L4: 0
    load_const 100

  L5:
    return
}

function match_optimization.classify_if_else_chain_three_arms(x: int) -> int {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L3

  L0:
    load_var x
    load_const 1
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
    load_const 999
    jump L4

  L2:
    load_const 101
    jump L4

  L3:
    load_const 100

  L4:
    return
}

function match_optimization.classify_jump_table_dense_four_arms_param(x: int) -> int {
    load_var x
    jump_table [L4, L3, L2, L1], default L0

  L0:
