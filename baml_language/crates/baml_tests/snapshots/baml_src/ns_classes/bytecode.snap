function classes.MutableNumber.add(self: classes.MutableNumber, other: classes.MutableNumber) -> bool {
    load_var self
    copy 0
    load_field .value
    load_var other
    load_field .value
    bin_op +
    store_field .value
    load_const true
    return
}

function classes.Number.add(self: classes.Number, other: classes.Number) -> classes.Number {
    load_var self
    load_field .value
    load_var other
    load_field .value
    add_int
    init_instance user.classes.Number .value
    return
}

