function glob.scan_throws_on_broken_symlink_when_opted_in_fn() -> bool {
    load_const "broken_throw"
    call user.glob.glob_tmp
    store_var root
    load_var root
    load_const true
    init_instance baml.fs.MkdirOptions .recursive
    sys_op baml.fs.mkdir
    pop 1
    load_var root
    load_const "/real.txt"
    bin_op +
    load_const "content"
    sys_op baml.fs.write
    pop 1
    load_const "ln -s "
    load_var root
    bin_op +
    load_const "/missing.txt "
    bin_op +
    load_var root
    bin_op +
    load_const "/dangling.txt"
    bin_op +
    load_const null
    sys_op baml.sys.shell
    pop 1
    load_const "*.txt"
    sys_op baml.glob.new
    store_var g
    load_var2 2 1
    load_const null
    load_const null
    load_const true
    load_const true
    load_const null
    init_instance baml.glob.ScanOptions .cwd, .dot, .absolute, .follow_symlinks, .throw_error_on_broken_symlink, .only_files
    sys_op baml.glob.Glob.scan
    pop 1
    jump L2
    load_var e
    is_type baml.errors.Io
    pop_jump_if_false L0
    jump L1

  L0:
    load_var e
    rethrow

  L1:
    load_const true
    store_var threw
    jump L3

  L2:
    load_const false
    store_var threw

  L3:
    load_const "rm -rf "
    load_var root
    bin_op +
    load_const null
    sys_op baml.sys.shell
    pop 1
    load_var threw
    return
}
