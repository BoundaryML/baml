function strings.strings_concat() -> string {
    load_const "Hello World"
    return
}

function strings.strings_del() -> string {
    load_const b"\x7f"
    call baml.deep_copy
    call baml.String.from_utf8
    return
}

function strings.strings_form_feed() -> string {
    load_const b"\x0c"
    call baml.deep_copy
    call baml.String.from_utf8
    return
}

function strings.strings_from_code_points_negative() -> string {
    load_const -1
    load_type int
    alloc_array 1
    call baml.String.from_code_points
    return
}

function strings.strings_from_code_points_surrogate() -> string {
    load_const 55296
    load_type int
    alloc_array 1
    call baml.String.from_code_points
    return
}

function strings.strings_from_code_points_too_large() -> string {
    load_const 1114112
    load_type int
    alloc_array 1
    call baml.String.from_code_points
    return
}

function strings.strings_from_utf8_invalid() -> string {
    load_const b"\xff"
    call baml.deep_copy
    call baml.String.from_utf8
    return
}

function strings.strings_low_controls() -> string {
    load_const b"\x00\x01\x1f"
    call baml.deep_copy
    call baml.String.from_utf8
    return
}

function strings.strings_nbsp() -> string {
    load_const b"\xc2\xa0"
    call baml.deep_copy
    call baml.String.from_utf8
    return
}

function strings.strings_nul_and_del() -> string {
    load_const b"\x00\x7f"
    call baml.deep_copy
    call baml.String.from_utf8
    return
}
