=== PPIR ===
function user.fixtures.catch_all_keyword.CatchAllTyped(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch_all (e) { string => "caught string", int => "caught int" }
}
function user.fixtures.catch_all_keyword.CatchAllWildcard(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch_all (e) { _ => "caught all" }
}
function user.fixtures.catch_all_keyword.CatchThenCatchAll(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch (e) { string => "caught string" } catch_all (e2) { _ => "caught rest" }
}
function user.fixtures.catch_all_keyword.MayFailIntOrString(x: int) -> string  [expr] {
  {  } match (x) { 0 => throw "string error", 1 => throw 42, _ => "ok" }
}
function user.fixtures.catch_all_keyword.PartialCatch(x: int) -> string  [expr] {
  {  } MayFailIntOrString(x) catch (e) { string => "caught string" }
}
