function fixtures.byte_string_literals.ByteStringMutate() -> int | null {
    load_const b"\x00\x00\x00"
    call baml.deep_copy
    store_var data
    load_var data
    load_const 0
    load_const 42
    store_array_element
    load_var data
    load_const 0
    call baml.Uint8Array.at
    return
}

