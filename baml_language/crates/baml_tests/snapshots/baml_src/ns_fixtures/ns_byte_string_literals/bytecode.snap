function fixtures.byte_string_literals.ByteStringInCondition() -> int {
    load_const b"\x61\x62\x63"
    call baml.deep_copy
    container_len
    store_var _2
    load_var _2
    load_const 0
    cmp_int_op >
    pop_jump_if_true L0
    load_const 0
    jump L1

  L0:
    load_const 1

  L1:
    return
}

