function fixtures.reflect_shadowing.$init_test_ns_fixtures_ns_reflect_shadowing_main(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.fixtures.reflect_shadowing"
    load_const "user class shadows shorthand"
    make_closure .<lambda($init_test_ns_fixtures_ns_reflect_shadowing_main, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.fixtures.reflect_shadowing"
    load_const "unbound user method over shorthand"
    make_closure .<lambda($init_test_ns_fixtures_ns_reflect_shadowing_main, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.fixtures.reflect_shadowing"
    load_const "local shadows shorthand"
    make_closure .<lambda($init_test_ns_fixtures_ns_reflect_shadowing_main, 2)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.fixtures.reflect_shadowing"
    load_const "qualified baml.reflect still works"
    make_closure .<lambda($init_test_ns_fixtures_ns_reflect_shadowing_main, 3)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function fixtures.reflect_shadowing.helper(q: string) -> string {
    load_var q
    load_const "!"
    bin_op +
    return
}

function fixtures.reflect_shadowing.local_shadows_shorthand() -> int {
    load_const 1
    load_const 1
    add_int
    return
}

function fixtures.reflect_shadowing.qualified_still_works() -> string {
    load_const user.fixtures.reflect_shadowing.helper
    call baml.reflect.signature
    load_field .returns
    call baml.TypeValue.baml.ToString.to_string
    return
}

function fixtures.reflect_shadowing.reflect.describe(self: fixtures.reflect_shadowing.reflect) -> string {
    load_const "user-"
    load_var self
    load_field .label
    bin_op +
    return
}

function fixtures.reflect_shadowing.unbound_user_method() -> string {
    load_const "x"
    init_instance user.fixtures.reflect_shadowing.reflect .label
    call user.fixtures.reflect_shadowing.reflect.describe
    return
}

function fixtures.reflect_shadowing.user_class_shadows_shorthand() -> string {
    load_const "shadow"
    init_instance user.fixtures.reflect_shadowing.reflect .label
    call user.fixtures.reflect_shadowing.reflect.describe
    return
}
