fn user.fixtures.short_circuit_locals.chained_and(a: bool, b: bool, c: bool) -> bool {
    // Locals:
    let _0: bool // _0 // return
    let _1: bool // a // param
    let _2: bool // b // param
    let _3: bool // c // param
    let _4: bool // ok
    let _5: bool

    bb0: {
        _5 = short_circuit(&&) copy _1 -> [eval: bb1, join: bb2];
    }

    bb1: {
        _5 = copy _2;
        goto -> bb2;
    }

    bb2: {
        _4 = short_circuit(&&) copy _5 -> [eval: bb3, join: bb4];
    }

    bb3: {
        _4 = copy _3;
        goto -> bb4;
    }

    bb4: {
        _0 = copy _4;
        goto -> bb5;
    }

    bb5: {
        return;
    }
}

