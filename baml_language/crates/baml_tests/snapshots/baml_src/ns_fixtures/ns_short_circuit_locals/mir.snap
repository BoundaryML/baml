fn user.fixtures.short_circuit_locals.chained_and(a: bool, b: bool, c: bool) -> bool {
    // Locals:
    let _0: bool // _0 // return
    let _1: bool // a // param
    let _2: bool // b // param
    let _3: bool // c // param
    let _4: bool // ok
    let _5: bool
    let _6: bool
    let _7: bool

    bb0: {
        _7 = short_circuit(&&) copy _1 -> [eval: bb1, join: bb2];
    }

    bb1: {
        _7 = copy _2;
        goto -> bb2;
    }

    bb2: {
        _6 = copy _7;
        _5 = short_circuit(&&) copy _6 -> [eval: bb3, join: bb4];
    }

    bb3: {
        _5 = copy _3;
        goto -> bb4;
    }

    bb4: {
        _4 = copy _5;
        _0 = copy _4;
        goto -> bb5;
    }

    bb5: {
        return;
    }
}

fn user.fixtures.short_circuit_locals.conditional_short_circuit_in_loop(items: int[], a: bool, b: bool) -> int {
    // Locals:
    let _0: int // _0 // return
    let _1: int[] // items // param
    let _2: bool // a // param
    let _3: bool // b // param
    let _4: bool // x
    let _5: int // hits
    let _6: baml.iter.Iterator<Error = never, Item = int>
    let _7: unknown
    let _8: bool
    let _9: int
    let _10: int // i
    let _11: bool
    let _12: int
    let _13: bool
    let _14: bool
    let _15: int

    bb0: {
        _4 = const false;
        _5 = const 0_i64;
        _6 = virtual_call iter as baml.iter.Iterable<Error = never, Item = int>(copy _1) -> [bb1];
    }

    bb1: {
        _7 = virtual_call next as baml.iter.Iterator<Error = never, Item = int>(copy _6) -> [bb2];
    }

    bb2: {
        _8 = is_type(copy _7, baml.iter.Done);
        branch copy _8 -> [bb9, bb3];
    }

    bb3: {
        _9 = copy _7;
        fresh_cell(_10);
        _10 = copy _9;
        _12 = copy _10;
        _11 = copy _12 > const 0_i64;
        branch copy _11 -> [bb4, bb7];
    }

    bb4: {
        _13 = short_circuit(&&) copy _2 -> [eval: bb5, join: bb6];
    }

    bb5: {
        _13 = copy _3;
        goto -> bb6;
    }

    bb6: {
        _4 = copy _13;
        goto -> bb7;
    }

    bb7: {
        _14 = copy _4;
        branch copy _14 -> [bb8, bb1];
    }

    bb8: {
        _15 = copy _5;
        _5 = copy _15 + const 1_i64;
        goto -> bb1;
    }

    bb9: {
        _0 = copy _5;
        goto -> bb10;
    }

    bb10: {
        return;
    }
}

fn user.fixtures.short_circuit_locals.mixed_join(a: bool, b: bool, cond: bool) -> bool {
    // Locals:
    let _0: bool // _0 // return
    let _1: bool // a // param
    let _2: bool // b // param
    let _3: bool // cond // param
