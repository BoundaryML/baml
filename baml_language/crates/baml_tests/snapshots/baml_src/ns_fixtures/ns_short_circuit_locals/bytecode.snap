function fixtures.short_circuit_locals.mixed_join(a: bool, b: bool, cond: bool) -> bool {
    load_var cond
    pop_jump_if_false L0
    jump L1

  L0:
    load_const false
    jump L2

  L1:
    load_var a
    jump_if_false L2
    pop 1
    load_var b

  L2:
    return
}
