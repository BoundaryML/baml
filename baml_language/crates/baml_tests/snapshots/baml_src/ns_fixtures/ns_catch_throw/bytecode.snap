function fixtures.catch_throw.AlsoMayFail(x: int) -> string {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_const "also ok"
    return

  L1:
    load_const "secondary error"
    throw
}

function fixtures.catch_throw.CatchAndRethrow(x: int) -> string {
    load_var x
    call user.fixtures.catch_throw.MayFail
    jump L0
    load_var e
    throw_if_panic
    load_var e
    rethrow

  L0:
    return
}

