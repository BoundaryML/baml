function fixtures.catch_throw.CatchWithFallback(x: int) -> string {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L4

  L0:
    load_var x
    load_const 1
    cmp_int_op ==
    pop_jump_if_false L1
    jump L3

  L1:
    load_const "ok"

  L2:
    return

  L3:
    load_const 1
    throw

  L4:
    load_const "string error"
    throw
    load_var e
    is_type string
    pop_jump_if_true L5
    load_var2 4 5
    rethrow

  L5:
    load_const "caught string"
    jump L2
    load_var e2
    is_type int
    pop_jump_if_true L6
    load_var2 2 3
    rethrow

  L6:
    load_const "caught int fallback"
    jump L2
}

function fixtures.catch_throw.SingleCatchWildcard(x: int) -> string {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L2

  L0:
    load_const "ok"

  L1:
    return

  L2:
    load_const "string error"
    throw
    load_var e
    is_type baml.panics.Panic
    pop_jump_if_true L3
    load_const "caught"
    jump L1

  L3:
    load_var2 2 3
    rethrow
}
