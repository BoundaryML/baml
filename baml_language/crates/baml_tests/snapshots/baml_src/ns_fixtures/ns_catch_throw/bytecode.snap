function fixtures.catch_throw.CatchWithFallback(x: int) -> string {
    load_var x
    call user.fixtures.catch_throw.MayFailIntOrString
    jump L2
    load_var _2
    is_type string
    pop_jump_if_true L1
    load_var _2
    is_type int
    pop_jump_if_true L0
    load_var _2
    rethrow

  L0:
    load_const "caught int fallback"
    jump L2

  L1:
    load_const "caught string"

  L2:
    return
}

function fixtures.catch_throw.SingleCatchWildcard(x: int) -> string {
    load_var x
    call user.fixtures.catch_throw.MayFail
    jump L0
    load_var e
    throw_if_panic
    load_const "caught"

  L0:
    return
}
