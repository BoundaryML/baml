---
source: crates/baml_tests/src/corpus.rs
---
function fixtures.catch_throw.CatchWithFallback(x: int) -> string {
    load_var x
    call user.fixtures.catch_throw.MayFailIntOrString
    jump L1
    load_var e
    is_type string
    pop_jump_if_true L0
    load_var2 4 5
    rethrow

  L0:
    load_const "caught string"

  L1:
    return
    load_var e2
    is_type int
    pop_jump_if_true L2
    load_var2 2 3
    rethrow

  L2:
    load_const "caught int fallback"
    jump L1
}

function fixtures.catch_throw.SingleCatchWildcard(x: int) -> string {
    load_var x
    call user.fixtures.catch_throw.MayFail
    jump L1
    load_var e
    is_type baml.panics.Panic
    pop_jump_if_true L0
    load_const "caught"
    jump L1

  L0:
    load_var2 2 3
    rethrow

  L1:
    return
}
