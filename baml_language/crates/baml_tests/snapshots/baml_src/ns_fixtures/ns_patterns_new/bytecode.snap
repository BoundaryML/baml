function fixtures.patterns_new.chain_narrow_then_wildcard(v: int | string | bool) -> int {
    load_var v
    store_var _2
    load_var _2
    narrow_bind int, slot=2
    pop_jump_if_true L0
    load_const 0
    jump L1

  L0:
    load_var _2

  L1:
    return
}

function fixtures.patterns_new.or_with_repeated_typed_binding(v: int | string) -> int {
    load_var v
    store_var _2
    load_var _2
    narrow_bind int, slot=2
    pop_jump_if_true L1
    load_var v
    store_var _4
    load_var _4
    narrow_bind int, slot=3
    pop_jump_if_true L0
    load_const 0
    jump L2

  L0:
    load_var _4
    jump L2

  L1:
    load_var _2

  L2:
    return
}
