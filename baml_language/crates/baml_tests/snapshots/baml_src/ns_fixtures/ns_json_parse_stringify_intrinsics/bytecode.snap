function fixtures.json_parse_stringify_intrinsics.match_parsed(s: string) -> string {
    load_var s
    call baml.json.parse
    store_var j
    load_var j
    store_var _3
    load_var _3
    narrow_bind baml.json.json[], slot=3
    pop_jump_if_true L5
    load_var j
    store_var _6
    load_var _6
    narrow_bind map<string, baml.json.json>, slot=4
    pop_jump_if_true L4
    load_var j
    store_var _9
    load_var _9
    narrow_bind int, slot=5
    pop_jump_if_true L3
    load_var j
    store_var _10
    load_var _10
    narrow_bind float, slot=6
    pop_jump_if_true L2
    load_var j
    store_var _11
    load_var _11
    narrow_bind bool, slot=7
    pop_jump_if_true L1
    load_var j
    store_var _12
    load_var _12
    narrow_bind string, slot=8
    pop_jump_if_true L0
    load_const "null"
    jump L6

  L0:
    load_var _12
    jump L6

  L1:
    load_const "bool"
    jump L6

  L2:
    load_const "float"
    jump L6

  L3:
    load_const "int"
    jump L6

  L4:
    load_var _6
    call baml.json.stringify
    jump L6

  L5:
    load_var _3
    call baml.json.stringify

  L6:
    return
}

function fixtures.json_parse_stringify_intrinsics.parse_and_roundtrip(s: string) -> string {
    load_var s
    call baml.json.parse
    call baml.json.stringify
    return
}

function fixtures.json_parse_stringify_intrinsics.parse_and_roundtrip_pretty(s: string) -> string {
