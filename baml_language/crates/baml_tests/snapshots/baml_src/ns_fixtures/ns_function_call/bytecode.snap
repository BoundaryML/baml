function fixtures.function_call.Bar() -> int {
    load_const 1
    call user.fixtures.function_call.Foo
    return
}

function fixtures.function_call.Baz.Greeting(self: fixtures.function_call.Baz) -> string {
    load_const "Hello, "
    load_var self
    load_field .name
    bin_op +
    load_const "!"
    bin_op +
    return
}

function fixtures.function_call.Foo(x: int) -> int {
    load_var x
    load_const 1
    add_int
    return
}

function fixtures.function_call.GreetBaz(n: string) -> string {
    load_var n
    init_instance user.fixtures.function_call.Baz .name
    call user.fixtures.function_call.Baz.Greeting
    return
}

function fixtures.function_call.array_length() -> int {
    load_const 1
    load_const 2
    load_const 3
    load_type int
    alloc_array 3
    container_len
    return
}

function fixtures.function_call.param_in_if_statement(b: bool) -> int {
    load_var b
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 2
    jump L2

  L1:
    load_const 1

  L2:
    return
}
