function fixtures.deep_method_call.B.greet(self: fixtures.deep_method_call.B) -> string {
    load_var self
    load_field .label
    return
}

function fixtures.deep_method_call.test_deep_field(a: fixtures.deep_method_call.A) -> string {
    load_var a
    load_field .b
    load_field .label
    return
}

function fixtures.deep_method_call.test_deep_method(a: fixtures.deep_method_call.A) -> string {
    load_var a
    load_field .b
    call user.fixtures.deep_method_call.B.greet
    return
}

function fixtures.deep_method_call.test_direct_method(b: fixtures.deep_method_call.B) -> string {
    load_var b
    call user.fixtures.deep_method_call.B.greet
    return
}
