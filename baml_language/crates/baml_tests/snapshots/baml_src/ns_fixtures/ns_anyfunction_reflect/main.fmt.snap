// BEP-062 AnyFunction slice, positive cases: derived conformance for every
// arrow shape, covariant pins, existential widening, reflect.signature member
// access, and call_any's
// R/E-from-pins typing with an exhaustive wildcard-free catch.

class ToolError {
    message: string,
}

class Doc {
    title: string,
}

function web_search(q: string) -> Doc[] throws ToolError {
    if (q == "boom") {
        throw ToolError { message: "no results" }
    }
    return [Doc { title: q }];
}

function current_time() -> string throws never {
    return "now";
}

function bare_and_pinned() -> int throws never {
    let f: reflect.AnyFunction = web_search;
    let g: reflect.AnyFunction<Returns = Doc[] | string, Throws = ToolError> = web_search;
    // Covariant pins: a narrower existential fits a wider one, and every
    // existential fits the bare (unknown-pinned) form.
    let widened: reflect.AnyFunction<Returns = Doc[] | string | int, Throws = ToolError> = g;
    let bare: reflect.AnyFunction = g;
    return 0;
}

function heterogeneous_tool_map(
) -> map<string, reflect.AnyFunction<Returns = Doc[] | string, Throws = ToolError>> throws never {
    // Each function coerces independently: Doc[] and string both fit the
    // Returns pin; never and ToolError both fit the Throws pin.
    return { "search": web_search, "now": current_time };
}

function signature_access(f: reflect.AnyFunction) -> string throws never {
    let sig = reflect.signature(f);
    // The error channel field is `errors` (no keyword-named fields),
    // and `type` is an ordinary member name on `reflect.Arg`.
    let parts = sig.returns.to_string() + sig.errors.to_string() + sig.args.length().to_string();
    for (let arg in sig.args) {
        parts = parts + arg.name + arg.type.to_string()
    }
    for (let key in sig.opts.keys()) {
        let opt = sig.opts.get(key);
        if (opt != null) {
            parts = parts + key + opt.type.to_string()
        }
    }
    return parts;
}

function typed_dispatch(name: string, args: map<string, unknown>) -> Doc[] | string throws never {
    let tools = heterogeneous_tool_map();
    let f = tools.get(name);
    if (f is null) {
        return "no-such-tool";
    }
    // R and E come from the pins: the channel is exactly
    // ToolError | reflect.InvalidArgumentError | reflect.errors.CompilationError,
    // so this catch is exhaustive with no wildcard arm.
    return reflect.call_any(f, args) catch (e) {
        ToolError => "tool-error:" + e.message,
        reflect.InvalidArgumentError => "bad-args",
        reflect.errors.CompilationError => "uncompiled-generic"
    };
}

// A runtime enum is a legal call-site type argument for the
// offline LLM companions. This compile model pins the public surface while the
// executable scenarios in `reflect_call_any.rs` prove rendering and SAP landing.
client RuntimeEnumClient = openai.ResponsesClient.new(
    model = "gpt-4o-mini",
    api_key = "test-key",
);

function RuntimeClassify<T>(input: string) -> T {
    client: RuntimeEnumClient
    prompt: `Choose a category for ${input}.\n${ctx.output_format()}`
}

function runtime_enum_llm_companions_compile() -> string {
    let category = reflect.enum.new(
        "Category",
        [reflect.enum.value("RED", alias = "k7", description = "warm"), "BLUE"],
    );
    let prompt = RuntimeClassify@render_prompt<unreflect(category)>("sample").text();
    let parsed = RuntimeClassify@parse<unreflect(category)>(`"k7"`);
    return prompt + reflect.enum.get_value(parsed);
}
