function fixtures.lambda_fat_arrow.test_annotated() -> int {
    load_const 21
    make_closure .<lambda(test_annotated, 0)>, 0
    call_indirect
    return
}

function fixtures.lambda_fat_arrow.test_in_match(x: int) -> int {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 0
    jump L2

  L1:
    load_const 10
    make_closure .<lambda(test_in_match, 0)>, 0
    call_indirect

  L2:
    return
}

