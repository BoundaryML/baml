    return
}

function fixtures.namespaces_type_resolution.llm.LlmMatchesRootStatus(s: fixtures.namespaces_type_resolution.Status) -> string {
    load_var s
    discriminant
    load_const Status.Ok
    cmp_int_op ==
    pop_jump_if_false L0
    jump L3

  L0:
    load_var s
    discriminant
    load_const Status.Failed
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
    load_const "pending"
    jump L4

  L2:
    load_const "failed"
    jump L4

  L3:
    load_const "ok"

  L4:
    return
}

