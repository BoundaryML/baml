function fixtures.namespaces_type_resolution.llm.LlmAliasParam(cfg: fixtures.namespaces_type_resolution.llm.Config) -> string {
    load_var cfg
    load_field .model
    return
}

function fixtures.namespaces_type_resolution.llm.LlmConstruct(model: string) -> fixtures.namespaces_type_resolution.llm.Config {
    load_var model
    load_const 0.7
    init_instance user.fixtures.namespaces_type_resolution.llm.Config .model, .temperature
    return
}

function fixtures.namespaces_type_resolution.llm.LlmEnumMatch(s: fixtures.namespaces_type_resolution.llm.Status) -> string {
    load_var s
    discriminant
    load_const Status.Ready
    cmp_int_op ==
    pop_jump_if_false L0
    jump L3

  L0:
    load_var s
    discriminant
    load_const Status.Generating
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
    load_const "done"
    jump L4

  L2:
    load_const "generating"
    jump L4

  L3:
    load_const "ready"

  L4:
    return
}

function fixtures.namespaces_type_resolution.llm.LlmEnumReturn() -> fixtures.namespaces_type_resolution.llm.Status {
    load_const user.fixtures.namespaces_type_resolution.llm.Status.Ready
    alloc_variant user.fixtures.namespaces_type_resolution.llm.Status
    return
}

function fixtures.namespaces_type_resolution.llm.LlmIdentity(cfg: fixtures.namespaces_type_resolution.llm.Config) -> fixtures.namespaces_type_resolution.llm.Config {
