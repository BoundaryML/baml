function fixtures.namespaces_type_resolution.auth.AuthAliasParam(t: fixtures.namespaces_type_resolution.auth.Token) -> string {
    load_var t
    load_field .value
    return
}

function fixtures.namespaces_type_resolution.auth.AuthConstruct(provider: string) -> fixtures.namespaces_type_resolution.auth.Config {
    load_var provider
    load_const "s3cret"
    init_instance user.fixtures.namespaces_type_resolution.auth.Config .provider, .secret
    return
}

function fixtures.namespaces_type_resolution.auth.AuthEnumMatch(r: fixtures.namespaces_type_resolution.auth.Role) -> string {
    load_var r
    discriminant
    load_const Role.Admin
    cmp_int_op ==
    pop_jump_if_false L0
    jump L3

  L0:
    load_var r
    discriminant
    load_const Role.User
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
    load_const "guest"
    jump L4

  L2:
    load_const "user"
    jump L4

  L3:
    load_const "admin"

  L4:
    return
}

function fixtures.namespaces_type_resolution.auth.AuthEnumReturn() -> fixtures.namespaces_type_resolution.auth.Role {
    load_const user.fixtures.namespaces_type_resolution.auth.Role.Admin
    alloc_variant user.fixtures.namespaces_type_resolution.auth.Role
    return
}

