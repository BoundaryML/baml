}

function fixtures.namespaces_type_resolution.auth.AuthMatchesLlmStatus(s: fixtures.namespaces_type_resolution.llm.Status) -> string {
    load_var s
    discriminant
    load_const Status.Ready
    cmp_int_op ==
    pop_jump_if_false L0
    jump L3

  L0:
    load_var s
    discriminant
    load_const Status.Generating
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
    load_const "done"
    jump L4

  L2:
    load_const "generating"
    jump L4

  L3:
    load_const "ready"

  L4:
    return
}

function fixtures.namespaces_type_resolution.auth.AuthMatchesRootStatus(s: fixtures.namespaces_type_resolution.Status) -> string {
    load_var s
    discriminant
