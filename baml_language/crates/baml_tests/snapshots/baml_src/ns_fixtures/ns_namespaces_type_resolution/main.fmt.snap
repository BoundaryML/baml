---
source: crates/baml_tests/src/corpus.rs
---
// ═══════════════════════════════════════════════════════════════════
// ROOT NAMESPACE — defines Config, Error, Status, ConfigAlias
//
// IMPORTANT: ns_llm and ns_auth ALSO define types with these exact
// same names. Bare references here must resolve to the ROOT versions.
// ═══════════════════════════════════════════════════════════════════

class Config {
    key: string,
    env: string,
}

class Error {
    code: int,
    message: string,
}

enum Status {
    Ok,
    Failed,
    Pending,
}

type ConfigAlias = Config;

// ── Bare name usage from root ───────────────────────────────────

// Param + return types: bare Config/Status must be root.fixtures.namespaces_type_resolution.Config/root.fixtures.namespaces_type_resolution.Status
function RootIdentity(cfg: Config) -> Config {
    cfg
}

// Constructor: bare Config must build root.fixtures.namespaces_type_resolution.Config
function RootConstruct(key: string) -> Config {
    Config { key: key, env: "prod" }
}

// Enum variant: bare Status.Ok must be root.fixtures.namespaces_type_resolution.Status.Ok
function RootEnumReturn() -> Status {
    Status.Ok
}

// Enum match: all arms must resolve to root.fixtures.namespaces_type_resolution.Status variants
function RootEnumMatch(s: Status) -> string {
    match (s) {
        Status.Ok => "ok",
        Status.Failed => "failed",
        Status.Pending => "pending",
    }
}

// Type alias: bare ConfigAlias must be root.fixtures.namespaces_type_resolution.ConfigAlias = root.fixtures.namespaces_type_resolution.Config
function RootAliasParam(cfg: ConfigAlias) -> string {
    cfg.key
}

// Throw class: bare Error must be root.fixtures.namespaces_type_resolution.Error
function RootThrowClass(x: int) -> string {
    match (x) {
        0 => throw Error { code: 500, message: "root error" },
        _ => "ok",
    }
}

// Throw enum: bare Status.Failed must be root.fixtures.namespaces_type_resolution.Status.Failed
function RootThrowEnum(x: int) -> string {
    match (x) {
        0 => throw Status.Failed,
        _ => "ok",
    }
}

// ── Cross-namespace from root ───────────────────────────────────

// Reference ns_llm types (which have SAME names as root types)
function RootUsesLlmConfig(cfg: root.fixtures.namespaces_type_resolution.llm.Config) -> string {
    cfg.model
}

function RootUsesLlmError(e: root.fixtures.namespaces_type_resolution.llm.Error) -> string {
    e.reason
}

function RootUsesLlmStatus() -> root.fixtures.namespaces_type_resolution.llm.Status {
    root.fixtures.namespaces_type_resolution.llm.Status.Ready
}

// Reference ns_auth types
function RootUsesAuthConfig(cfg: root.fixtures.namespaces_type_resolution.auth.Config) -> string {
    cfg.provider
}

function RootUsesAuthError(e: root.fixtures.namespaces_type_resolution.auth.Error) -> string {
    e.realm
}

// Reference nested ns_llm.openai types
function RootUsesNestedClient(
    c: root.fixtures.namespaces_type_resolution.llm.openai.Client,
) -> string {
    c.api_key
}

// ── Mixed: root types alongside qualified cross-ns types ────────

// Takes root.fixtures.namespaces_type_resolution.Config, returns root.fixtures.namespaces_type_resolution.llm.Config — must be different types
function RootMixedConfigs(
    root_cfg: Config,
    llm_cfg: root.fixtures.namespaces_type_resolution.llm.Config,
) -> string {
    root_cfg.key
}

// ── Stream companion types ──────────────────────────────────────
// Classes whose fields reference cross-namespace types.
// The $stream companions must resolve all field types correctly.

// Root class with fields from other namespaces
class RootWithCrossNsFields {
    own_config: Config,
    llm_config: root.fixtures.namespaces_type_resolution.llm.Config,
    auth_config: root.fixtures.namespaces_type_resolution.auth.Config,
    llm_response: root.fixtures.namespaces_type_resolution.llm.Response,
    nested_client: root.fixtures.namespaces_type_resolution.llm.openai.Client,
    own_status: Status,
    own_alias: ConfigAlias,
}

// Root class referencing a cross-namespace type alias
class RootWithCrossNsAlias {
    llm_alias: root.fixtures.namespaces_type_resolution.llm.ResponseAlias,
    own_alias: ConfigAlias,
}
