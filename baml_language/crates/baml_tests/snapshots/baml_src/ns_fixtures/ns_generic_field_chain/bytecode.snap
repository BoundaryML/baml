function fixtures.generic_field_chain.test_generic_capture(box: fixtures.generic_field_chain.Box<fixtures.generic_field_chain.User>) -> string {
    load_var ?1
    make_cell
    store_var ?1
    load_var box
    make_closure .<lambda(test_generic_capture, 0)>, 1
    call_indirect
    return
}

function fixtures.generic_field_chain.test_generic_chain(box: fixtures.generic_field_chain.Box<fixtures.generic_field_chain.User>) -> string {
    load_var box
    load_field .value
    load_field .0
    return
}

function fixtures.generic_field_chain.test_nested_generic_chain(box: fixtures.generic_field_chain.Box<fixtures.generic_field_chain.Box<fixtures.generic_field_chain.User>>) -> string {
    load_var box
    load_field .value
    load_field .0
    load_field .0
    return
}
