function fixtures.catch_arm_return.may_throw(x: int) -> int {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_var x
    return

  L1:
    load_const "boom"
    throw
}

function fixtures.catch_arm_return.via_catch(x: int) -> int {
    load_var x
    call user.fixtures.catch_arm_return.may_throw
    jump L0
    load_var e
    throw_if_panic
    load_const -1

  L0:
    return
}

function fixtures.catch_arm_return.via_match(x: int) -> int {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_var x
    jump L2

  L1:
    load_const -1

  L2:
    return
}
