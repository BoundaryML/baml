function future_methods.$init_test_ns_future_methods_future_methods(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "methods_after_successful_settle"
    make_closure .<lambda($init_test_ns_future_methods_future_methods, 0)>, 0
    load_const null
    call testing.TestCollector.register_test
    pop 1
    load_var registry
    load_const "methods_on_pending_future"
    make_closure .<lambda($init_test_ns_future_methods_future_methods, 1)>, 0
    load_const null
    call testing.TestCollector.register_test
    pop 1
    load_var registry
    load_const "methods_after_cancel"
    make_closure .<lambda($init_test_ns_future_methods_future_methods, 2)>, 0
    load_const null
    call testing.TestCollector.register_test
    pop 1
    load_var registry
    load_const "methods_on_errored_future"
    make_closure .<lambda($init_test_ns_future_methods_future_methods, 3)>, 0
    load_const null
    call testing.TestCollector.register_test
    pop 1
    load_const null
    return
}

function future_methods.fail_io() -> int {
    load_const "x"
    init_instance baml.errors.Io .message
    throw
}

function future_methods.methods_after_cancel() -> baml.future.FutureState {
    make_closure .<lambda(methods_after_cancel, 0)>, 0
    load_const null
    spawn
    store_var _3
    move_local 1 2
    load_var f
    call baml.future.Future.cancel
    pop 1
    load_var f
    call baml.future.Future.state
    return
}

function future_methods.methods_after_successful_settle() -> bool[] {
    make_closure .<lambda(methods_after_successful_settle, 0)>, 0
    load_const null
    spawn
    store_var _3
    move_local 1 2
    load_var f
    await
    pop 1
    load_var f
    call baml.future.Future.is_settled
    load_var f
    call baml.future.Future.is_result
    load_var f
    call baml.future.Future.is_error
    load_var f
    call baml.future.Future.is_cancelled
    load_var f
    call baml.future.Future.cancel
    alloc_array 5
    return
}

function future_methods.methods_on_errored_future() -> baml.future.FutureState {
    make_closure .<lambda(methods_on_errored_future, 0)>, 0
    load_const null
    spawn
    store_var _3
    move_local 1 2
    load_var f
    await
    pop 1
    jump L1
    load_var e
    is_type baml.errors.Io
    pop_jump_if_false L0
    jump L1

  L0:
    load_var e
    throw

  L1:
    load_var f
    call baml.future.Future.state
    return
}

function future_methods.methods_on_pending_future() -> baml.future.FutureState {
    make_closure .<lambda(methods_on_pending_future, 0)>, 0
    load_const null
    spawn
    store_var _3
    move_local 1 2
    load_var f
    call baml.future.Future.is_settled
    pop 1
    load_var f
    call baml.future.Future.state
    return
}
