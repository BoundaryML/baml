function net.$init_test_ns_net_net(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.net"
    load_const "net_tcp_read_after_close_errors"
    make_closure .<lambda($init_test_ns_net_net, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.net"
    load_const "net_tcp_listener_accept_after_close_errors"
    make_closure .<lambda($init_test_ns_net_net, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.net"
    load_const "net_udp_send_after_close_errors"
    make_closure .<lambda($init_test_ns_net_net, 2)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.net"
    load_const "net_udp_recv_timeout_fires"
    make_closure .<lambda($init_test_ns_net_net, 3)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function net.net_tcp_listener_accept_after_close_errors_fn() -> uint8array | null {
    load_const "127.0.0.1:0"
    sys_op baml.net.TcpListener.bind
    store_var listener
    load_var listener
    sys_op baml.net.TcpListener.close
    pop 1
    load_var listener
    sys_op baml.net.TcpListener.accept
    load_const 4096
    load_type baml.io.Read
    load_const "read"
    virtual_call nargs=2 ntypeargs=0
    return
}

function net.net_tcp_read_after_close_errors_fn() -> uint8array | null {
    load_const "127.0.0.1:0"
    sys_op baml.http.Server.bind
    load_field .addr
    load_const <omitted>
    call baml.net.TcpStream.connect
    store_var sock
    load_var sock
    sys_op baml.net.TcpStream.close
    pop 1
    load_var sock
    load_const 4096
    load_type baml.io.Read
    load_const "read"
    virtual_call nargs=2 ntypeargs=0
    return
}

function net.net_udp_recv_timeout_fires_fn() -> uint8array {
    load_const "127.0.0.1:0"
    sys_op baml.net.UdpSocket.bind
    load_const 50n
    call baml.time.Duration.from_milliseconds
    call baml.net.UdpSocket.recv_from
    load_field .data
    return
}

function net.net_udp_send_after_close_errors_fn() -> int {
    load_const "127.0.0.1:0"
    sys_op baml.net.UdpSocket.bind
    store_var sock
    load_var sock
    sys_op baml.net.UdpSocket.close
    pop 1
    load_const "x"
    call baml.String.to_utf8
    store_var _3
    load_var2 1 2
    load_const "127.0.0.1:9"
    load_const <omitted>
    call baml.net.UdpSocket.send_to
    return
}
