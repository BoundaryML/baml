function crypto.feed_hasher(h: baml.crypto.Hasher, data: uint8array) -> void {
    load_var2 1 2
    load_type baml.crypto.Hasher
    load_const "update"
    virtual_call nargs=2 ntypeargs=0
    store_var _0
    load_var _0
    return
}

function crypto.seal_and_open(cipher: baml.crypto.Aead, nonce: uint8array, message: uint8array, aad: uint8array) -> bool {
    load_var2 1 2
    load_var2 3 4
    load_type baml.crypto.Aead
    load_const "encrypt"
    virtual_call nargs=4 ntypeargs=0
    store_var _6
    load_var2 1 2
    load_var2 6 4
    load_type baml.crypto.Aead
    load_const "decrypt"
    virtual_call nargs=4 ntypeargs=0
    store_var _5
    load_var2 5 3
    call baml.ops.equals_equals
    return
}
