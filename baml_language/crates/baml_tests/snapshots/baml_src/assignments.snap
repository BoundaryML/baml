function assignments.Factory.get_counter(self: null) -> assignments.Counter {
    load_var self
    load_field .counter
    return
}

function assignments.array_element_field() -> int {
    load_const 10
    init_instance user.assignments.Item .count
    load_const 20
    init_instance user.assignments.Item .count
    load_const 30
    init_instance user.assignments.Item .count
    alloc_array 3
    store_var_load_var items
    load_const 1
    load_array_element
    copy 0
    load_field .count
    load_const 5
    bin_op +
    store_field .count
    load_var items
    load_const 1
    load_array_element
    load_field .count
    return
}

function assignments.copy_of_mutable_param(x: int) -> int {
    load_var x
    store_var y
    load_const 2
    store_var x
    load_var y
    return
}

function assignments.cross_block_param_mutation(c: bool, p: int) -> int {
    load_var p
    store_var x
    load_var c
    pop_jump_if_false L0
    load_const 2
    store_var p

  L0:
    load_var x
    return
}

function assignments.cross_block_soundness(c: bool) -> int {
    load_const 1
    store_var_load_var a
    store_var b
    load_var c
    pop_jump_if_false L0
    load_const 2
    store_var a

  L0:
    load_var b
    return
}

function assignments.cross_block_transitive_param_mutation(c: bool, p: int) -> int {
    load_var p
    store_var x
    load_var c
    pop_jump_if_false L0
    load_const 2
    store_var p

  L0:
    load_var x
    return
}

function assignments.mutable_in_arg(x: int) -> int {
    load_const 3
    store_var_load_var x
    return
}

function assignments.nested_field_compound() -> int {
    load_const 10
    init_instance user.assignments.Inner .value
    init_instance user.assignments.Outer .inner
    store_var_load_var o
    load_field .inner
    copy 0
    load_field .value
    load_const 32
    bin_op +
    store_field .value
    load_var o
    load_field .inner
    load_field .value
    return
}

function assignments.nested_field_simple() -> int {
    load_const 10
    init_instance user.assignments.Inner .value
    init_instance user.assignments.Outer .inner
    store_var_load_var o
    load_field .inner
    load_const 42
    store_field .value
    load_var o
    load_field .inner
    load_field .value
    return
}

function assignments.paren_assign_must_error() -> null {
    load_const "parse error"
    call baml.sys.panic
    pop 1
    jump L0

  L0:
    unreachable
}

function assignments.throws_fail() -> int {
    load_const "fail"
    throw
}
