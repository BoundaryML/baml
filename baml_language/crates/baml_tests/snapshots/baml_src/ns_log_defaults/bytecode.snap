---
source: crates/baml_tests/src/corpus.rs
---
function log_defaults.$init_test_ns_log_defaults_log_defaults(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.log_defaults"
    load_const "log_defaults_and_named_argument_order"
    make_closure .<lambda($init_test_ns_log_defaults_log_defaults, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}

function log_defaults.log_defaults_and_named_argument_order() -> string[] {
    load_type string
    alloc_array 0
    store_var_load_var order
    load_const "omitted"
    call user.log_defaults.record
    store_var _2
    load_const "$baml_log"
    load_const "info"
    load_var _2
    load_const null
    load_const "level"
    load_const "data"
    load_const "event_name"
    load_type string
    load_type unknown
    alloc_map 3
    send_event
    pop 1
    load_var order
    load_const "null"
    call user.log_defaults.record
    store_var _4
    load_const "$baml_log"
    load_const "debug"
    load_var _4
    load_const null
    load_const "level"
    load_const "data"
    load_const "event_name"
    load_type string
    load_type unknown
    alloc_map 3
    send_event
    pop 1
    load_var order
    load_const "name-first"
    call user.log_defaults.record
    store_var _6
    load_var order
    load_const "data-second"
    call user.log_defaults.record
    store_var _8
    load_const "$baml_log"
    load_const "warn"
    load_var2 5 4
    load_const "level"
    load_const "data"
    load_const "event_name"
    load_type string
    load_type unknown
    alloc_map 3
    send_event
    pop 1
    load_var order
    load_const "data-first"
    call user.log_defaults.record
    store_var _10
    load_var order
    load_const "name-second"
    call user.log_defaults.record
    store_var _12
    load_const "$baml_log"
    load_const "error"
    load_var2 6 7
    load_const "level"
    load_const "data"
    load_const "event_name"
    load_type string
    load_type unknown
    alloc_map 3
    send_event
    pop 1
    load_var order
    return
}

function log_defaults.record(order: string[], value: string) -> string {
    load_type string
    load_var2 1 2
    call baml.Array.push
    pop 1
    load_var value
    return
}
