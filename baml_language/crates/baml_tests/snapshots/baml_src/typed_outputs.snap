function typed_outputs.optional_class_value() -> int {
    call user.typed_outputs.optional_class_main
    store_var result
    load_var result
    is_type typed_outputs.OutputData
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 1
    unary_op -
    jump L2

  L1:
    load_var result
    load_field .0

  L2:
    return
}

