function ai.Agent.Generate.generate(self: ai.Agent, request: ai.Request<T>) -> ai.Response<T> {
    load_var self
    load_field .inner
    store_var _4
    load_type #0
    load_var2 2 1
    load_field .inner
    call user.ai.Request.for_provider
    store_var _6
    load_type #0
    load_var2 3 4
    load_field .prompt
    load_var request
    load_field .identity
    load_var request
    load_field .arguments
    load_var self
    load_field .tools
    load_var self
    load_field .dispatch
    init_instance user.ai.RequestOptions .dispatch
    load_var request
    load_field .tags
    load_var request
    load_field ._render
    load_var request
    load_field ._messages
    load_type #0
    init_instance<1> user.ai.Request .provider, .prompt, .identity, .arguments, .tools, .options, .tags, ._render, ._messages
    load_const null
    load_var self
    load_field .stop_when
    init_instance user.ai.Budget .max_steps, .stop_when
    call user.ai.run_agent
    store_var outcome
    jump L2
    load_var e
    is_type baml.errors.UnknownError
    pop_jump_if_false L0
    jump L1

  L0:
    load_var e
    throw_if_panic
    load_var e
    load_const "agent loop failed"
    load_type string
    alloc_array 1
    init_instance baml.errors.UnknownError .data, .message
    throw

  L1:
    load_var e
    throw

  L2:
    load_var outcome
    is_type ai.Done<...>
    pop_jump_if_false L3
    jump L6

  L3:
    load_var outcome
    is_type ai.BudgetReached
    pop_jump_if_false L4
    jump L5

  L4:
    load_var outcome
    load_const "agent handed off before a final value"
    load_type string
    alloc_array 1
    init_instance baml.errors.UnknownError .data, .message
    throw

  L5:
    load_var outcome
    load_const "agent budget reached before a final value"
    load_type string
    alloc_array 1
    init_instance baml.errors.UnknownError .data, .message
    throw

  L6:
    load_var outcome
    store_var done
    load_var done
    load_field .value
    load_var done
    load_field .meta
    load_type #0
    init_instance<1> user.ai.Response .value, .meta
    return
}

