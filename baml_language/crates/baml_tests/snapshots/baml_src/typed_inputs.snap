function typed_inputs.add(a: int, b: int) -> int {
    load_var2 1 2
    add_int
    return
}

function typed_inputs.concat(a: string, b: string, c: string) -> string {
    load_var a
    load_const " "
    bin_op +
    load_var b
    bin_op +
    load_const " "
    bin_op +
    load_var c
    bin_op +
    return
}

function typed_inputs.double(x: int) -> int {
    load_var x
    load_const 2
    mul_int
    return
}

function typed_inputs.get_value(m: map<string, int>, key: string) -> int {
    load_var2 1 2
    load_map_element
    return
}

function typed_inputs.greet(name: string) -> string {
    load_const "Hello, "
    load_var name
    bin_op +
    load_const "!"
    bin_op +
    return
}

function typed_inputs.half(x: float) -> float {
    load_var x
    load_const 2.0
    div_float
    return
}

function typed_inputs.is_null(x: int?) -> bool {
    load_var x
    load_const null
    cmp_op ==
    return
}

function typed_inputs.magnitude_squared(p: typed_inputs.Point) -> int {
    load_var p
    load_field .x
    load_var p
    load_field .x
    mul_int
    load_var p
    load_field .y
    load_var p
    load_field .y
    mul_int
    add_int
    return
}

function typed_inputs.negate(b: bool) -> bool {
    load_var b
    unary_op !
    return
}

function typed_inputs.sum(arr: int[]) -> int {
    load_const 0
    store_var total
    load_const 0
    store_var __for_idx

  L0:
    load_var2 3 1
    container_len
    cmp_int_op <
    pop_jump_if_false L1
    jump L2

  L1:
    load_var total
    return

  L2:
    load_var2 2 1
    load_var __for_idx
    load_array_element
    add_int
    store_var total
    load_var __for_idx
    load_const 1
    add_int
    store_var __for_idx
    jump L0
}
