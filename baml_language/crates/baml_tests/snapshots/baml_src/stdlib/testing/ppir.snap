}
function testing.Retry(max_attempts: int) -> TestRunner  [expr] {
  { if (max_attempts Le 0) {  } baml.sys.panic("testing.Retry req...") else {  } null; return (run_once) -> TestReportThunk { {  } () -> TestReport { { let runs: RunReport[] = []; let passed = false; let attempts = 0; while attempts Lt max_attempts And Not passed { let report = run_once(); attempts Add= 1; for run in report.runs {  } runs.push(run) } if (report.outcome Eq "pass") { passed = true } else {  } null; let outcome: Outcome = if (passed) {  } "pass" else {  } "fail" } TestReport { outcome: outcome, runs: runs } } } }
}
function testing.Sequential() -> TestSetRunner  [expr] {
  { return (children) -> TestSetReport { {  } root.run_children_sequential(children, false) } }
}
