function assignments.array_element_field() -> int {
    load_const 10
    init_instance user.assignments.Item .count
    load_const 20
    init_instance user.assignments.Item .count
    load_const 30
    init_instance user.assignments.Item .count
    load_type assignments.Item
    alloc_array 3
    store_var items
    load_var items
    load_const 1
    load_array_element
    copy 0
    load_field .count
    load_const 5
    bin_op +
    store_field .count
    load_var items
    load_const 1
    load_array_element
    load_field .count
    return
}

