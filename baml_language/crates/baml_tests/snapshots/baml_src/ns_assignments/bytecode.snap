function assignments.nested_field_compound() -> int {
    load_const 10
    init_instance user.assignments.Inner .value
    init_instance user.assignments.Outer .inner
    store_var o
    load_var o
    load_field .inner
    copy 0
    load_field .value
    load_const 32
    bin_op +
    store_field .value
    load_var o
    load_field .inner
    load_field .value
    return
}

