    cmp_int_op !=
    pop_jump_if_false L0
    load_const "expected a two-byte draw"
    call baml.sys.panic
    pop 1

  L0:
    load_var self
    copy 0
    load_field .calls
    load_const 1
    bin_op +
    store_field .calls
    load_const b""
    call baml.deep_copy
    store_var draw
    load_var self
    load_field .calls
    load_const 1
    cmp_int_op ==
    pop_jump_if_false L1
    jump L2

  L1:
