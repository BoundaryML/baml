function env.$init_test_ns_env_env(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "root.env"
    load_const "env_get_or_panic_missing_var"
    make_closure .<lambda($init_test_ns_env_env, 0)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.env"
    load_const "env_get_missing_var_returns_null"
    make_closure .<lambda($init_test_ns_env_env, 1)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_var registry
    load_const "root.env"
    load_const "env_sugar_missing_var"
    make_closure .<lambda($init_test_ns_env_env, 2)>, 0
    load_const null
    call testing.TestCollector.register_test_at
    pop 1
    load_const null
    return
}
