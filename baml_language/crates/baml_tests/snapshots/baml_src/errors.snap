function ai.errors.classify_http(provider: string, status_code: int, body: string) -> ai.errors.Failure {
    load_var status_code
    load_const 429
    cmp_int_op ==
    pop_jump_if_false L0
    jump L5

  L0:
    load_var status_code
    load_const 408
    cmp_int_op ==
    jump_if_false L1
    jump L2

  L1:
    pop 1
    load_var status_code
    load_const 500
    cmp_int_op >=

  L2:
    pop_jump_if_false L3
    jump L4

  L3:
    load_type int
    load_var status_code
    call baml.String.from
    store_var _11
    load_var2 1 2
    load_const "http "
    load_var _11
    bin_op +
    load_var body
    init_instance ai.errors.InvalidRequest .provider, .status_code, .detail, .raw_body
    jump L6

  L4:
    load_type int
    load_var status_code
    call baml.String.from
    store_var _8
    load_var provider
    load_const "http "
    load_var _8
    bin_op +
    load_var body
    init_instance ai.errors.NetworkFailure .provider, .detail, .raw_body
    jump L6

  L5:
    load_var provider
    load_const null
    load_var body
    init_instance ai.errors.RateLimited .provider, .retry_after_ms, .raw_body

  L6:
    return
}
