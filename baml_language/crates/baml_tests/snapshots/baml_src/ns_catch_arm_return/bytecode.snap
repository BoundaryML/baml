function catch_arm_return.car_throws(x: int) -> int {
    load_var x
    load_const 0
    cmp_int_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_var x
    return

  L1:
    load_const "boom"
    throw
}

