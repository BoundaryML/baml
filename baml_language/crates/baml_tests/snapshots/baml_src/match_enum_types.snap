function match_enum_types.classify(x: match_enum_types.Color | match_enum_types.Status) -> string {
    load_var x
    is_type match_enum_types.Color
    pop_jump_if_false L0
    jump L1

  L0:
    load_const "status"
    jump L2

  L1:
    load_const "color"

  L2:
    return
}

function match_enum_types.classify_color_fn() -> string {
    load_const user.match_enum_types.Color.Red
    alloc_variant user.match_enum_types.Color
    call user.match_enum_types.classify
    return
}

function match_enum_types.classify_one_enum(x: match_enum_types.Color | int | string | bool) -> string {
    load_var x
    type_tag
    jump_table [L2, L1, L0, _, _, L3], default L5

  L0: bool
    load_const "bool"
    jump L4

  L1: string
    load_const "string"
    jump L4

  L2: int
    load_const "int"
    jump L4

  L3: enum
    load_const "color"

  L4:
    return

  L5:
    unreachable
}

function match_enum_types.classify_one_enum_color_fn() -> string {
    load_const user.match_enum_types.Color.Green
    alloc_variant user.match_enum_types.Color
    call user.match_enum_types.classify_one_enum
