function match_enum_types.status_is_color_fn() -> bool {
    load_const user.match_enum_types.Status.Active
    alloc_variant user.match_enum_types.Status
    is_type match_enum_types.Color
    pop_jump_if_false L0
    jump L1

  L0:
    load_const false
    jump L2

  L1:
    load_const true

  L2:
