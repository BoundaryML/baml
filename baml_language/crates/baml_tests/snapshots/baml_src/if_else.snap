function if_else.block_expression_fn() -> int {
    load_const 1
    return
}

function if_else.consecutive_if_without_else_fn() -> int {
    load_const 0
    store_var x
    load_const true
    pop_jump_if_false L0
    load_const 1
    store_var x

  L0:
    load_const false
    pop_jump_if_false L1
    load_const 2
    store_var x

  L1:
    load_var x
    return
}

function if_else.else_if_assignment_fn(a: bool, b: bool) -> int {
    load_var a
    pop_jump_if_false L0
    jump L3

  L0:
    load_var b
    pop_jump_if_false L1
    jump L2

  L1:
    load_const 3
    jump L4

  L2:
    load_const 2
    jump L4

  L3:
    load_const 1

  L4:
    return
}

