function json_parse_stringify.parse_array_len() -> int {
    load_const "[1, 2, 3]"
    call baml.json.parse
    store_var _2
    load_var _2
    narrow_bind baml.json.json[], slot=1
    pop_jump_if_false L0
    jump L1

  L0:
    load_const -1
    jump L2

  L1:
    load_var _2
    container_len

  L2:
    return
}

function json_parse_stringify.parse_is_float() -> bool {
    load_const "1.0"
    call baml.json.parse
    store_var _2
    load_var _2
    narrow_bind float, slot=1
    pop_jump_if_false L0
    jump L1

  L0:
    load_const false
    jump L2

  L1:
    load_const true

  L2:
    return
}

