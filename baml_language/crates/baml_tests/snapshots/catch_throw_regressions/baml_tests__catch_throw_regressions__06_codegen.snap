function user.AlwaysThrowsStatus(n: int) -> Status {
    load_var n
    load_const 0
    cmp_op ==
    pop_jump_if_false L0
    jump L1

  L0:
    load_const 404
    throw

  L1:
    load_const "http_error"
    throw
}

function user.CatchAllStatusVariants(n: int) -> string {
    load_var n
    call user.ThrowsAllStatusVariants
    jump L5
    load_var e
    discriminant
    jump_table [L4, L3, L2, L1], default L0

  L0:
    load_var e
    throw

  L1: Status.SomeOtherError
    load_const "other!"
    jump L5

  L2: Status.AuthError
    load_const "auth!"
    jump L5

  L3: Status.IndexError
    load_const "index!"
    jump L5

  L4: Status.HttpError
    load_const "http!"

  L5:
    return
}

