function user.GetResponse(cfg: Config) -> llm.Response {
    alloc_instance user.llm.Response
    load_const "hello"
    init_field .text
    load_var cfg
    load_field .model
    init_field .model
    return
}

function user.llm.MakeResponse(cfg: Config) -> llm.Response {
    alloc_instance user.llm.Response
    load_const "ok"
    init_field .text
    load_var cfg
    load_field .model
    init_field .model
    return
}
