function user.GetResponse(cfg: Config) -> llm.Response {
    alloc_instance Response
    copy 0
    load_const "hello"
    store_field .text
    copy 0
    load_var cfg
    load_field .model
    store_field .model
    return
}

function user.llm.MakeResponse(cfg: Config) -> void {
    alloc_instance Response
    copy 0
    load_const "ok"
    store_field .text
    copy 0
    load_var cfg
    load_field .model
    store_field .model
    return
}
