function user.ElseIfChain(x: int) -> string {
    load_var x
    load_const 1
    cmp_op ==
    pop_jump_if_false L0
    jump L5

  L0:
    load_var x
    load_const 2
    cmp_op ==
    pop_jump_if_false L1
    jump L4

  L1:
    load_var x
    load_const 3
    cmp_op ==
    pop_jump_if_false L2
    jump L3

  L2:
    notify_block Default case
    load_const "other"
    jump L6

  L3:
    notify_block Case three
    load_const "three"
    jump L6

  L4:
    notify_block Case two
    load_const "two"
    jump L6

  L5:
    notify_block Case one
    load_const "one"

  L6:
    return
}

