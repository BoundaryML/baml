function $init_test() -> null {
    load_var ?1
    call ?
    pop 1
    load_const ?
    return
}

function user.$init_test_23(registry: testing.TestCollector) -> null {
    load_var registry
    load_const "wrong runner type"
    make_closure .<lambda($init_test_23, 0)>, 0
    load_const 42
    call testing.TestCollector.register_test
    pop 1
    load_var registry
    load_const "string as runner"
    make_closure .<lambda($init_test_23, 1)>, 0
    load_const "not a runner"
    call testing.TestCollector.register_test
    pop 1
    load_var registry
    load_const "wrong testset runner"
    make_closure .<lambda($init_test_23, 2)>, 0
    load_const 42
    call testing.TestCollector.register_test_set
    pop 1
