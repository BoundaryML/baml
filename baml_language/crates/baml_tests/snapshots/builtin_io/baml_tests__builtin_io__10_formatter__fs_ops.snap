// Test file system operations typecheck correctly

function ReadFile() -> string {
    let f = baml.fs.open("example.txt");
    f.read_string()
}

function ReadFileInline() -> string {
    baml.fs.open("data.json").read_string()
}

function ReadMultipleFiles() -> string {
    let f1 = baml.fs.open("file1.txt");
    let f2 = baml.fs.open("file2.txt");
    let content1 = f1.read_string();
    let content2 = f2.read_string();
    content1 + content2
}

function ReadAndClose() -> string {
    let f = baml.fs.open("example.txt");
    let content = f.read_string();
    f.close();
    content
}

function ReadFileBytes() -> uint8array {
    let f = baml.fs.open("binary.dat");
    f.read_bytes()
}

function ReadFileBytesInline() -> uint8array {
    baml.fs.open("image.png").read_bytes()
}

function ReadFileBytesAndClose() -> uint8array {
    let f = baml.fs.open("binary.dat");
    let data = f.read_bytes();
    f.close();
    data
}
