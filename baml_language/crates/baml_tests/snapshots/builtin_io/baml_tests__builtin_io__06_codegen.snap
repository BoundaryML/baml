}

function user.AppendAndRead() -> string {
    load_const "log.txt"
    load_const "a+"
    dispatch_future baml.fs.open
    await
    store_var f
    load_var f
    load_const "line\\n"
    dispatch_future baml.fs.File.write
    await
    pop 1
    load_var f
    load_const "start"
    load_const 0
    dispatch_future baml.fs.File.seek_from
    await
    pop 1
    load_var f
    dispatch_future baml.fs.File.text
    await
    return
}

