function add(base: int, amount: int) -> int {
    load_var amount
    load_const <omitted>
    cmp_op ==
    pop_jump_if_false L0
    add_int_var_const_store 1 1 2

  L0:
    add_int_var_var 1 2
    return
}

function main() -> int {
    load_const 5
    load_const <omitted>
    call user.add
    return
}
