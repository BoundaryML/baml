class user.WithDone {
  name: string
  age: int
}
function user.WithDone.to_json(self: user.WithDone) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "name": baml.json.to_json(self.name), "age": baml.json.to_json(self.age) } : map<string, baml.json.json>
}
function user.WithDone.from_json(j: baml.json.json) -> user.WithDone throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  WithDone { name: baml.json.from_json<string>(baml.json.field(j, "name")), age: baml.json.from_json<int>(baml.json.field(j, "age")) } : user.WithDone
}
function user.WithDone.to_string(self: user.WithDone) -> string throws never {
  baml.unstable.string<T>(self) : string
}
class user.WithDone$stream {
  name: string
  age: int | null
}
