class user.AtomicPoint {
  x: float
  y: float
}
function user.AtomicPoint.to_json(self: user.AtomicPoint) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "x": self.x.to_json(), "y": self.y.to_json() } : map<string, baml.json.json>
}
function user.AtomicPoint.from_json(j: baml.json.json) -> user.AtomicPoint throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  AtomicPoint { x: baml.json.from_json<float>(baml.json.field(j, "x")), y: baml.json.from_json<float>(baml.json.field(j, "y")) } : user.AtomicPoint
}
class user.AtomicPoint$stream {
  x: null | float
  y: null | float
}
