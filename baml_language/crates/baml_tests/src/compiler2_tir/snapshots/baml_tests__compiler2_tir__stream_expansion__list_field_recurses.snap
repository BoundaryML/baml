}
function user.Inner.from_json(j: baml.json.json) -> user.Inner throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  Inner { value: baml.json.from_json<string>(baml.json.field(j, "value")) } : user.Inner
}
class user.WithLists {
  strings: string[]
  ints: int[]
  classes: user.Inner[]
}
function user.WithLists.from_json(j: baml.json.json) -> user.WithLists throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  WithLists { strings: baml.json.from_json<string[]>(baml.json.field(j, "strings")), ints: baml.json.from_json<int[]>(baml.json.field(j, "ints")), classes: baml.json.from_json<Inner[]>(baml.json.field(j, "classes")) } : user.WithLists
}
class user.Inner$stream {
  value: string | null
}
class user.WithLists$stream {
  strings: string[]
  ints: int[]
  classes: user.Inner$stream[]
}
