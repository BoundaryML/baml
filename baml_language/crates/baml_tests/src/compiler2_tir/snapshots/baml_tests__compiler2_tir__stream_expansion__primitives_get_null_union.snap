class user.Primitives {
  name: string
  count: int
  flag: bool
  score: float
}
function user.Primitives.to_json(self: user.Primitives) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "name": baml.json.to_json(self.name), "count": baml.json.to_json(self.count), "flag": baml.json.to_json(self.flag), "score": baml.json.to_json(self.score) } : map<string, baml.json.json>
}
function user.Primitives.from_json(j: baml.json.json) -> user.Primitives throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  Primitives { name: baml.json.from_json<string>(baml.json.field(j, "name")), count: baml.json.from_json<int>(baml.json.field(j, "count")), flag: baml.json.from_json<bool>(baml.json.field(j, "flag")), score: baml.json.from_json<float>(baml.json.field(j, "score")) } : user.Primitives
}
function user.Primitives.to_string(self: user.Primitives) -> string throws never {
  baml.unstable.string<T>(self) : string
}
class user.Primitives$stream {
  name: string | null
  count: int | null
  flag: bool | null
  score: float | null
}
