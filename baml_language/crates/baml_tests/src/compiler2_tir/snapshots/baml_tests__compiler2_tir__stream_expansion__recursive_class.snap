---
source: crates/baml_tests/src/compiler2_tir/stream_expansion.rs
expression: "render_tir(&db, file)"
---
class user.TreeNode {
  value: string
  children: user.TreeNode[]
}
function user.TreeNode.to_json(self: user.TreeNode) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "value": self.value.to_json(), "children": self.children.to_json() } : map<string, baml.json.json>
}
function user.TreeNode.from_json(j: baml.json.json) -> user.TreeNode throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  TreeNode { value: baml.json.from_json<string>(baml.json.field(j, "value")), children: baml.json.from_json<TreeNode[]>(baml.json.field(j, "children")) } : user.TreeNode
}
class user.TreeNode$stream {
  value: null | string
  children: user.TreeNode$stream[]
}
