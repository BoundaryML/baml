class user.TreeNode {
  value: string
  children: user.TreeNode[]
}
function user.TreeNode.from_json(j: baml.json.json) -> user.TreeNode throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  TreeNode { value: baml.json.from_json<string>(baml.json.field(j, "value")), children: baml.json.from_json<TreeNode[]>(baml.json.field(j, "children")) } : user.TreeNode
}
class user.TreeNode$stream {
  value: string | null
  children: user.TreeNode$stream[]
}
