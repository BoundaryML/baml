class user.WithDesc {
  name: string @description("The name")
  age: int @description("Age in years")
}
function user.WithDesc.to_json(self: user.WithDesc) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "name": self.name.to_json(), "age": self.age.to_json() } : map<string, baml.json.json>
}
function user.WithDesc.from_json(j: baml.json.json) -> user.WithDesc throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  WithDesc { name: baml.json.from_json<string>(baml.json.field(j, "name")), age: baml.json.from_json<int>(baml.json.field(j, "age")) } : user.WithDesc
}
class user.WithDesc$stream {
  name: string @description("The name")
  age: null | int @description("Age in years")
}
