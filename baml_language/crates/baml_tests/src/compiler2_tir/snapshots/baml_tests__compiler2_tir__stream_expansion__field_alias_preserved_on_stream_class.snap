class user.WithAlias {
  bar: string @alias("baz")
  count: int @alias("cnt")
}
function user.WithAlias.to_json(self: user.WithAlias) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "bar": self.bar.to_json(), "count": self.count.to_json() } : map<string, baml.json.json>
}
function user.WithAlias.from_json(j: baml.json.json) -> user.WithAlias throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  WithAlias { bar: baml.json.from_json<string>(baml.json.field(j, "bar")), count: baml.json.from_json<int>(baml.json.field(j, "count")) } : user.WithAlias
}
class user.WithAlias$stream {
  bar: null | string @alias("baz")
  count: null | int @alias("cnt")
}
