class user.Resume {
  name: string
  education: user.Education[]
}
function user.Resume.to_json(self: user.Resume) -> baml.json.json throws baml.json.JsonSerializationError | baml.json.JsonParseError {
  map { "name": self.name.to_json(), "education": self.education.to_json() } : map<string, baml.json.json>
}
function user.Resume.from_json(j: baml.json.json) -> user.Resume throws baml.json.JsonParseError | baml.json.JsonDecodeError {
  Resume { name: baml.json.from_json<string>(baml.json.field(j, "name")), education: baml.json.from_json<Education[]>(baml.json.field(j, "education")) } : user.Resume
}
class user.Resume$stream {
  name: null | string
  education: user.Education$stream[]
}
