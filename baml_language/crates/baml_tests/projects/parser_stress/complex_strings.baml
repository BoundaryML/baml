class StringTorture {
  // Nested quotes in raw strings
  raw1 string @description(`She said "Hello"`)
  raw2 string @description(`This has "nested" quoted text`)
  raw3 string @description(`Even more "nested" quoted text here`)

  // Unicode edge cases
  emoji string @alias("🎉🎊🎈")
  rtl string @alias("مرحبا بالعالم")
  zalgo string @alias("ẗ̤̈ë̤̈ẍ̤̈ẗ̤̈")

  // Very long string
  long string @alias("")
}