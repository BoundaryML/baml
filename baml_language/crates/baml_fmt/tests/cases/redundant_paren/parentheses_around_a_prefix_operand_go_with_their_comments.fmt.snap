function f(sections: string[], pet_name: string) -> bool {
    let a = !sections.map((item) -> { item.to_string() })
        .join(` `)
        .includes(`WarningSignsContact`) /* c */;
    let b = !(
        sections.map((item) -> { item.to_string() }).join(` `).includes(`WarningSignsContact`)
        /* kept */
    );
    let c = !sections.map((item) -> { item.to_string() }).join(` `).includes(`WarningSignsContact`); // carried
    let d = -/* c */ 1;
    let e = -/* c */ x;
    let g = -x /* c */;
    a && b && c
}
