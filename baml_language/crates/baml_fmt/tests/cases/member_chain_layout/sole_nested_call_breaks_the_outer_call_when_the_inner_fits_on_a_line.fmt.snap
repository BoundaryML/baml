function f(self, attempt: int, retry: Retry) -> int {
    baml.sys.sleep(
        baml.time.Duration.from_milliseconds(self.backoff.delay_ms(attempt, retry.cause)),
    );
    foo(bar(baz(qux(
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,
        cccccccccccccc,
    ))));
    0
}
