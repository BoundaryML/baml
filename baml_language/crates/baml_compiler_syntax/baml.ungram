// BAML concrete syntax tree grammar.
//
// This describes the Rowan tree produced by the handwritten parser. It is
// intentionally not a parser grammar: precedence and recovery stay in the
// parser, while typed syntax APIs are generated from this file.

SourceFile = TopLevelDeclaration*

TopLevelDeclaration =
  FunctionDef
| ClassDef
| EnumDef
| InterfaceDef
| ImplementsFor
| ClientDef
| ClientValueDef
| TestDef
| TestExprDef
| TestsetDef
| HeaderComment
| GeneratorDef
| RetryPolicyDef
| TemplateStringDef
| TypeAliasDef

FunctionDef =
  BlockAttribute*
  'function'
  name_token:'#word'
  GenericParamList?
  ParameterList
  ('->' | '=>')
  TypeExpr
  ThrowsClause?
  FunctionBodyKind

FunctionBodyKind = LlmFunctionBody | ExprFunctionBody

ParameterList = '(' (Parameter | ',')* ')'

Parameter =
  name_token:('#word' | 'client')
  (':'? TypeExpr)?
  ('=' default_value:ExprNode)?

LlmFunctionBody =
  '{'
  (
    ClientField ToolsField? PromptField
  | ClientField PromptField ToolsField?
  | PromptField ToolsField? ClientField
  | PromptField ClientField ToolsField?
  | ToolsField ClientField PromptField
  | ToolsField PromptField ClientField
  )
  '}'

ExprFunctionBody = BlockExpr

ClientField = 'client' ':' value:ExprNode
PromptField = name_token:'#word' ':' value:ExprNode
ToolsField = name_token:'#word' ':' value:ExprNode

ClassDef =
  BlockAttribute*
  'class'
  name_token:'#word'
  GenericParamList?
  ('{' (Field | FunctionDef | ImplementsBlock | BlockAttribute | ',' | ';')* '}')

Field =
  BlockAttribute*
  name_token:('#word' | 'client')
  (':'? TypeExpr)?

InterfaceDef =
  BlockAttribute*
  'interface'
  name_token:'#word'
  GenericParamList?
  RequiresClause?
  '{'
  (MethodSig | AssociatedTypeDecl | Field | BlockAttribute | ',' | ';')*
  '}'

RequiresClause = 'requires' TypeExpr (',' TypeExpr)* ','?

MethodSig =
  BlockAttribute*
  'function'
  name_token:'#word'
  GenericParamList?
  ParameterList
  ('->' | '=>')
  TypeExpr
  ThrowsClause?
  ExprFunctionBody?

AssociatedTypeDecl =
  'type'?
  name_token:'#word'
  ('extends' bound:TypeExpr)?
  ('=' binding:TypeExpr)?

ImplementsBlock =
  'implements'
  ImplementsTarget
  RequiresClause?
  '{'
  (FunctionDef | AssociatedTypeDecl | InterfaceFieldLink | Field | BlockAttribute | ',' | ';')*
  '}'

ImplementsTarget = TypeExpr

InterfaceFieldLink =
  interface_field:'#word'
  'as'
  class_field:'#word'

ImplementsFor =
  ('implements' | 'implement')
  GenericParamList?
  ImplementsTarget
  'for'
  ImplementsForTarget
  RequiresClause?
  '{'
  (FunctionDef | AssociatedTypeDecl | InterfaceFieldLink | Field | BlockAttribute | ',' | ';')*
  '}'

ImplementsForTarget = TypeExpr

EnumDef =
  BlockAttribute*
  'enum'
  name_token:'#word'
  GenericParamList?
  '{'
  (EnumVariant | BlockAttribute | ',' | ';')*
  '}'

EnumVariant = name_token:'#word' Attribute*

ClientDef =
  BlockAttribute*
  'client'
  ClientType?
  name_token:'#word'
  ConfigBlock

ClientType = '<' name_token:'#word' '>'

ClientValueDef =
  BlockAttribute*
  'client'
  name_token:'#word'
  '='
  value:ExprNode
  ';'?

ConfigBlock = '{' (ConfigItem | BlockAttribute | ',' | ';')* '}'
ConfigItem =
  (StringLiteral | key_token:('#word' | 'client' | 'retry_policy' | 'enum' | 'class'))
  ':'?
  (ConfigValue | ConfigBlock)
  Attribute*
ConfigValue = (expr:ExprNode | config_array:ConfigArray | config_block:ConfigBlock)
ConfigArray = '[' (ConfigValue | ConfigBlock | ',')* ']'

TestDef = BlockAttribute* 'test' name_token:'#word' ConfigBlock
RetryPolicyDef = BlockAttribute* 'retry_policy' name_token:'#word' ConfigBlock
TemplateStringDef =
  BlockAttribute*
  'template_string'
  name_token:'#word'
  ParameterList
  RawStringLiteral

TypeAliasDef =
  BlockAttribute*
  'type'
  name_token:'#word'
  GenericParamList?
  '='
  TypeExpr
  ';'?

GenericParamList = '<' (GenericParam | ',')* '>'
GenericParam = name_token:'#word' GenericParamBounds?
GenericParamBounds = 'extends' TypeExpr ('&' TypeExpr)*

ThrowsClause = 'throws' TypeExpr

TypeExpr =
  (
    StringLiteral
  | RawStringLiteral
  | ('-'? ('#bigint' | '#integer' | '#float'))
  | ('true' | 'false' | 'null')
  | ('#word' ('.' '#word')* TypeArgs?)
  | ('(' (FunctionTypeParam | ',')* ')' ('->' TypeExpr ThrowsClause?)?)
  )
  (TypeArgs | '[' ']' | '?')*
  ('|' (
    StringLiteral
  | RawStringLiteral
  | ('-'? ('#bigint' | '#integer' | '#float'))
  | ('true' | 'false' | 'null')
  | ('#word' ('.' '#word')* TypeArgs?)
  | ('(' (FunctionTypeParam | ',')* ')' ('->' TypeExpr ThrowsClause?)?)
  ) (TypeArgs | '[' ']' | '?')*)*
  Attribute*

FunctionTypeParam =
  (name_token:('#word' | 'client') '?'? ':')?
  TypeExpr

TypeArgs = '<' (TypeExpr | AssociatedTypeDecl | ',')* '>'

Attribute = '@' name_token:'#word' AttributeArgs?
BlockAttribute = '@@' name_token:'#word' AttributeArgs?
AttributeArgs = '(' (ExprNode | ',')* ')'

AnyElement = Error

ExprNode =
  LiteralExpr
| BlockExpr
| PathExpr
| StringLiteral
| RawStringLiteral
| BacktickStringLiteral
| ByteStringLiteral
| BinaryExpr
| IsExpr
| UnaryExpr
| CallExpr
| IndexExpr
| TaggedTemplateExpr
| OptionalCallExpr
| OptionalIndexExpr
| FieldAccessExpr
| UpcastExpr
| QualifiedPathExpr
| SpecExpr
| OptionalFieldAccessExpr
| EnvAccessExpr
| ParenExpr
| IfExpr
| IfLetExpr
| MatchExpr
| CatchExpr
| ThrowExpr
| ReturnExpr
| BreakExpr
| ContinueExpr
| SpawnExpr
| AwaitExpr
| LambdaExpr
| ForExpr
| ObjectLiteral
| ArrayLiteral
| MapLiteral

LiteralExpr = '#bigint' | '#integer' | '#float' | 'true' | 'false' | 'null'

BlockExpr = '{' (BlockItem | ';')* '}'
BlockItem =
  ExprNode
| HeaderComment
| WhileStmt
| WhileLetStmt
| LetStmt
| TypeBindingStmt
| BreakStmt
| ContinueStmt
| ReturnStmt
| ThrowStmt
| DeferStmt
| TestExprDef
| TestsetDef
PathExpr =
  PathExpr GenericArgs
| ('#word' | 'client' | 'class' | 'enum' | 'interface' | 'function' | 'implements' | 'spawn' | 'await')
  (('.' | '::') ('#word' | 'client' | 'class' | 'enum' | 'interface' | 'function' | 'implements' | 'spawn' | 'await'))*

StringLiteral = '"' AnyElement* '"'
RawStringLiteral = AnyElement*

GeneratorDef = BlockAttribute* 'generator' name_token:'#word' ConfigBlock

TestExprDef =
  BlockAttribute*
  'test'
  name:ExprNode
  ('with' with_value:ExprNode)?
  body:BlockExpr

TestsetDef =
  BlockAttribute*
  'testset'
  name:ExprNode
  ('with' with_value:ExprNode)?
  body:BlockExpr

ClientReference = ExprNode
DefaultImpl = ExprFunctionBody

BinaryExpr =
  lhs:ExprNode
  ('==' | '!=' | '<' | '>' | '<=' | '>=' | '&&' | '||' | '&' | '|'
   | '^' | '<<' | '>>' | '+' | '-' | '*' | '/' | '%' | ('?' '?') | '??' | 'instanceof'
   | '=' | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^='
   | '<<=' | '>>=')
  rhs:ExprNode

IsExpr = lhs:ExprNode 'is' Pattern
UnaryExpr = ('!' | '-' | '~' | '++' | '--') operand:ExprNode
CallExpr = callee:ExprNode CallArgs
IndexExpr = base:ExprNode '[' index:ExprNode ']'
TaggedTemplateExpr = tag:ExprNode BacktickStringLiteral
OptionalCallExpr = callee:ExprNode '?.' CallArgs
OptionalIndexExpr = base:ExprNode '?.' '[' index:ExprNode ']'
FieldAccessExpr = base:ExprNode '.' name_token:('#word' | 'client' | 'class' | 'enum' | 'interface' | 'function' | 'implements' | 'spawn' | 'await')
UpcastExpr = base:ExprNode '.' 'as' GenericArgs
QualifiedPathExpr = '(' TypeExpr 'as' TypeExpr ')' '.' name_token:'#word'
SpecExpr = base:PathExpr '@' spec_token:'#word'
OptionalFieldAccessExpr = base:ExprNode '?.' name_token:('#word' | 'client' | 'class' | 'enum' | 'interface' | 'function' | 'implements' | 'spawn' | 'await')
EnvAccessExpr = env_token:'#word' '.' name_token:'#word'
ParenExpr = '(' ExprNode ')'

IfExpr =
  'if'
  condition:ExprNode
  then_branch:BlockExpr
  ('else' else_branch:(BlockExpr | IfExpr | IfLetExpr))?

IfLetExpr =
  'if'
  Pattern
  '='
  scrutinee:ExprNode
  then_branch:BlockExpr
  ('else' else_branch:(BlockExpr | IfExpr | IfLetExpr))?

MatchExpr =
  'match'
  (('(' scrutinee:ExprNode (':' TypeExpr)? ')') | scrutinee:ExprNode)
  '{'
  (MatchArm | HeaderComment)*
  '}'
MatchArm = Pattern MatchGuard? '=>' value:ExprNode ','?
MatchPattern = Pattern
MatchGuard = 'if' condition:ExprNode

CatchExpr = body:ExprNode CatchClause
CatchClause =
  ('catch' | 'catch_all' | 'catch_all_panics')
  '('
  CatchBinding
  (',' CatchStackTraceBinding)?
  ')'
  '{'
  (CatchArm | HeaderComment)*
  '}'
CatchArm = Pattern CatchStackTraceBinding? '=>' value:ExprNode ','?
CatchPattern = Pattern
CatchBinding = name_token:'#word'
CatchStackTraceBinding = ',' name_token:'#word'

ThrowExpr = 'throw' value:ExprNode
ReturnExpr = 'return' value:ExprNode?
BreakExpr = 'break'
ContinueExpr = 'continue'
SpawnExpr = 'spawn' name:ExprNode? ('with' ExprNode (',' ExprNode)*)? body:BlockExpr
AwaitExpr = 'await' value:ExprNode
LambdaExpr = GenericParamList? ParameterList ('=>' | '->') TypeExpr? ThrowsClause? body:BlockExpr

ForExpr = 'for' '('? (LetStmt | ExprNode | 'in' | ';')* ')'? body:BlockExpr

WhileStmt = 'while' condition:ExprNode body:BlockExpr
WhileLetStmt = 'while' ('let' | 'const')? Pattern '=' scrutinee:ExprNode body:BlockExpr
LetStmt = ('let' | 'const')? Pattern ('=' value:ExprNode)? ('else' BlockExpr)? ';'?
TypeBindingStmt = 'type' name_token:'#word' '=' unreflect_token:'#word' '(' value:ExprNode ')' ';'?
BreakStmt = 'break' ';'?
ContinueStmt = 'continue' ';'?
ReturnStmt = 'return' value:ExprNode? ';'?
ThrowStmt = ThrowExpr ';'?
DeferStmt = 'defer' body:BlockExpr

Pattern = PatternKind
PatternKind =
  ChainPattern
| UnionPattern
| PatternAtom

PatternAtom =
  BindingPattern
| DestructurePattern
| ArrayPattern
| TypePattern
| UnreflectPattern
| ParenPattern
| WildcardPattern

ChainPatternItem =
  UnionPattern
| BindingPattern
| DestructurePattern
| ArrayPattern
| TypePattern
| UnreflectPattern
| ParenPattern
| WildcardPattern

ChainPattern = first:ChainPatternItem (':' rest:ChainPatternItem)*
UnionPattern = first:PatternAtom ('|' rest:PatternAtom)*
BindingPattern = ('let' | 'const') name_token:'#word' (':' Pattern)?
DestructurePattern = ('let' | 'const')? first_token:'#word' ('.' path_token:'#word')* (GenericArgs | TypeArgs)? '{' (FieldPattern | ',')* '}'
FieldPattern = name_token:'#word' (':' Pattern)?
ArrayPattern = '[' (ArrayPatternElement | ',')* ']' (':' TypeExpr)?
ArrayPatternElement = '..'? Pattern?
TypePattern = TypeExpr
UnreflectPattern = name_token:'#word' '(' value:ExprNode ')'
ParenPattern = '(' Pattern ')'
WildcardPattern = ('let' | 'const')? name_token:'#word'

CallArgs = '(' (CallArg | ',')* ')'
CallArg = (name_token:('#word' | 'client') '=')? value:ExprNode
GenericArgs = '<' (TypeExpr | UnreflectArg | ',')* '>'
UnreflectArg = name_token:'#word' '(' value:ExprNode ')'

ObjectLiteral = constructor:PathExpr? '{' (ObjectField | SpreadElement | ',')* '}'
ObjectField = (key_token:('#word' | 'client') | StringLiteral) (':' value:ExprNode)?
SpreadElement = '...' value:ExprNode
ArrayLiteral = '[' (ExprNode | ',')* ']'
MapLiteral = '{' (ObjectField | ',')* '}'

ByteStringLiteral = AnyElement*
UnquotedString = AnyElement*

BacktickStringLiteral = AnyElement*
BacktickSegmentNode =
  BacktickText
| BacktickInterpolation
| BacktickForOpen
| BacktickEndfor
| BacktickIfOpen
| BacktickElseIf
| BacktickElse
| BacktickEndif

BacktickText = AnyElement*
BacktickInterpolation = '$' (ExprNode | LetStmt)
BacktickForOpen = '$' '{' 'for' '(' LetStmt 'in' ExprNode ')' '}'
BacktickEndfor = '$' '{' endfor_token:'#word' '}'
BacktickIfOpen = '$' '{' 'if' '(' ExprNode ')' '}'
BacktickElseIf = '$' '{' 'else' 'if' '(' ExprNode ')' '}'
BacktickElse = '$' '{' 'else' '}'
BacktickEndif = '$' '{' endif_token:'#word' '}'

HeaderComment = AnyElement*

Error = '#error'*
