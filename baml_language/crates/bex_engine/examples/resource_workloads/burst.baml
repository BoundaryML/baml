let f11 = spawn { child() };
let f12 = spawn { child() };
let f13 = spawn { child() };
let f14 = spawn { child() };
let f15 = spawn { child() };
let f16 = spawn { child() };
let f17 = spawn { child() };
let f18 = spawn { child() };
let f19 = spawn { child() };
let f20 = spawn { child() };
let f21 = spawn { child() };
let f22 = spawn { child() };
let f23 = spawn { child() };
let f24 = spawn { child() };
let f25 = spawn { child() };
let f26 = spawn { child() };
let f27 = spawn { child() };
let f28 = spawn { child() };
let f29 = spawn { child() };
let f30 = spawn { child() };
let f31 = spawn { child() };
total += await f0;
total += await f1;
total += await f2;
total += await f3;
total += await f4;
total += await f5;
total += await f6;
total += await f7;
total += await f8;
total += await f9;
total += await f10;
total += await f11;
total += await f12;
total += await f13;
total += await f14;
total += await f15;
total += await f16;
total += await f17;
total += await f18;
total += await f19;
total += await f20;
total += await f21;
total += await f22;
total += await f23;
total += await f24;
total += await f25;
total += await f26;
total += await f27;
total += await f28;
total += await f29;
total += await f30;
total += await f31;
}; assert.equal(total, n * 32); n }
