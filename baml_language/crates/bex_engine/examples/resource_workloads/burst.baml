function child() -> int { 1 }
function main(n: int) -> int { let total = 0; for (let i = 0; i < n; i += 1) {
let f0 = spawn { child() };
let f1 = spawn { child() };
let f2 = spawn { child() };
let f3 = spawn { child() };
let f4 = spawn { child() };
