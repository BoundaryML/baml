  <table>
baml query
  --max-rows <N>
  --max-wall <DURATION>
  <sql>
baml login
  --no-open [default: false]
baml logout
baml ide
baml ide install
  --code [default: false]
  --cursor [default: false]
  --output-dir <PATH>
baml agent
baml agent install
